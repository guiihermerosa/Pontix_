            "text": "var lang = {\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    \"e_shiduanyiQ\" : \"Período semanal 1\",\n    \"e_shiduanerQ\" : \"Período semanal 2\",\n    \"e_shiduansanQ\" : \"Período semanal 3\",\n    \"e_shiduanansiQ\" : \"Período semanal 4\",\n    \"e_shiduanwuQ\" : \"Período semanal 5\",\n    \"e_shiduanliuQ\" : \"Período semanal 6\",\n    \"e_shiduanqiQ\" : \"Período semanal 7\",\n    \"e_shiduanbaQ\" : \"Período semanal 8\",\n    \"heartTime\":\"Intervalo do pacote de pulsação\",\n    \"heartTime_fanwei\":\"Faixa de intervalo do pacote de pulsação da camada de aplicação: \",\n    \"mqtt_register_address2\":\"Endereço de autenticação\",\n    \"d_qingshurubianhaohuoxinming2\":\"Insira o indicativo ou o nome\",\n    \"e_z1\": \"Operação falhou\",\n    \"e_z2\": \"Falha ao criar JSON\",\n    \"e_z3\": \"Falha ao analisar formato JSON\",\n    \"e_z4\": \"Número máximo de pessoal atingido\",\n    \"e_z5\": \"Nome do pessoal muito longo\",\n    \"e_z6\": \"ID de pessoal inválido\",\n    \"e_z7\": \"ID de pessoal já existe\",\n    \"e_z8\": \"Número do cartão já existe\",\n    \"e_z9\": \"Quantidade de administradores completa\",\n    \"e_z10\": \"Veia palmar 1 já existe\",\n    \"e_z11\": \"Veia palmar 2 já existe\",\n    \"e_z12\": \"Falha ao baixar impressão digital\",\n    \"dhcp_enable\":\"Ativar DHCP\",\n    \"n_Gateway\":\"Gateway\",\n    \"n_ask\":\"Máscara de sub-rede\",\n    \"n_IPV4\":\"Endereço IP\",\n    \"hotspot_password\":\"Senha do hotspot\",\n    \"n_sta\":\"Modo STA\",\n    \"n_ap\":\"Modo AP\",\n    \"system_tikong\":\"Controle de elevador\",\n    \"elevator_control\": \"Controle de elevador\",\n    \"temp_pwd\": \"Ativar senha temporária\",\n    \"floor_setting\": \"Ativar configuração de andar por toque\",\n    \"lowest_floor\": \"Andar mais baixo\",\n    \"lowest_floor_tip\": \"Nota: 0 ou 1 representam o 1º andar\",\n    \"lowest_floor_empty\": \"Insira o andar mais baixo\",\n    \"lowest_floor_error\": \"Faixa do andar mais baixo: -99~