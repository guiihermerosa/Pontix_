          "content": {
            "size": 21078,
            "mimeType": "application/x-javascript",
            "text": "var form,indexLay;\r\nfunction load(){\r\n    check_permission();\r\n    lang_load();\r\n    alg_get();\r\n    //  getLanguageCus();\r\n\r\n    holidayLoad();\r\n}\r\n\r\nlayui.use(['form', 'layer'], function () {\r\n    $ = layui.jquery;\r\n    form = layui.form;\r\n    var layer = layui.layer;\r\n\r\n    // 监听提交 - 只对 save 按钮应用验证规则\r\n    form.on('submit(save)', function (data) {\r\n        // 自定义验证规则 - 仅在 save 按钮提交时执行\r\n        var errorMsg = validateFormFields();\r\n        if (errorMsg) {\r\n            layer.msg(errorMsg, { icon: 5, time: 2000 });\r\n            return false;\r\n        }\r\n\r\n        let alg = get_alg_input();\r\n        alg[\"set\"] = 1;\r\n        alg[\"password\"] = $.cookie(\"pwd\")\r\n        let requestData = {\r\n            data: alg,\r\n            password: $.cookie(\"pwd\")\r\n        };\r\n        $.ajax({\r\n            url: '/setLawRule',\r\n            type: 'POST',\r\n            contentType: \"application/json\",\r\n            dataType: \"json\",\r\n            data: JSON.stringify(requestData),\r\n            beforeSend: function () {\r\n\r\n            },\r\n            success: function (json) {\r\n                console.log(\"done\")\r\n                let field = window.lang.setting_success;\r\n                layer.msg(field, { icon: 1, time: 2000 });\r\n            },\r\n            error: function (error) {\r\n                console.log(\"error::::\", error);\r\n                let field = window.lang.setting_fail;\r\n                layer.msg(field, { icon: 5, time: 2000 });\r\n            }\r\n        });\r\n        return false;\r\n    });\r\n\r\n    // 监听提交 - saveholiday 按钮不应用表单验证\r\n    form.on('submit(saveholiday)', function (data) {\r\n        var tableData = $('#table3').bootstrapTable('getData');\r\n        console.log(\"提交的数据\", tableData)\r\n\r\n        let alg = new Object();\r\n        alg[\"set\"] = 1;\r\n        alg[\"password\"] = $.cookie(\"pwd\")\r\n\r\n        let requestData = {\r\n            data: holidaySource,\r\n            password: $.cookie(\"pwd\")\r\n        };\r\n        $.ajax({\r\n            url: '/setOpenHoliday',\r\n            type: 'POST',\r\n            contentType: \"application/json\",\r\n            dataType: \"json\",\r\n            data: JSON.stringify(requestData),\r\n            beforeSend: function () {\r\n\r\n            },\r\n            success: function (json) {\r\n                console.log(\"done\")\r\n                let field = window.lang.setting_success;\r\n                layer.msg(field, { icon: 1, time: 2000 });\r\n            },\r\n            error: function (error) {\r\n                console.log(\"error::::\", error);\r\n                let field = window.lang.setting_fail;\r\n                layer.msg(field, { icon: 5, time: 2000 });\r\n            }\r\n        });\r\n        return false;\r\n    });\r\n\r\n    // 自定义验证函数 - 从原来的 form.verify 移过来\r\n    function validateFormFields() {\r\n        // 验证 record_warning\r\n        let recordWarning = $(\"#record_warning\").val();\r\n        if (recordWarning == \"\") {\r\n            return window.lang.record_warning_shu;\r\n        } else {\r\n            if (parseInt(recordWarning) < 1 || parseInt(recordWarning) > 5000) {\r\n                return window.lang.record_warning_wrong;\r\n            }\r\n        }\r\n\r\n        // 验证 allow_tardiness\r\n        let allowTardiness = $(\"#allow_tardiness\").val();\r\n        if (allowTardiness == \"\") {\r\n            return window.lang.allow_tardiness_shu;\r\n        } else {\r\n            if (parseInt(allowTardiness) < 0 || parseInt(allowTardiness) > 60) {\r\n                return window.lang.allow_tardiness_wrong;\r\n            }\r\n        }\r\n\r\n        // 验证 allow_early\r\n        let allowEarly = $(\"#allow_early\").val();\r\n        if (allowEarly == \"\") {\r\n            return window.lang.allow_early_shu;\r\n        } else {\r\n            if (parseInt(allowEarly) < 0 || parseInt(allowEarly) > 60) {\r\n                return window.lang.allow_early_wrong;\r\n            }\r\n        }\r\n\r\n        return null; // 验证通过返回 null\r\n    }\r\n});\r\n\r\n\r\nfunction get_alg_input(){\r\n\r\n    // 活体检测：live_testing     int\r\n    // 活体阈值：live_threshold    int  (1-99)\r\n    // 识别间隔：identification_interval    int  (0-7200)\r\n    // 红外图像：infrared_image   int\r\n    // 灯光设置：lighting_settings   int    (0/1/2)\r\n    // 识别距离：identification_distance   int  (50-150)\r\n    // 问候语：greetings  int\r\n    // 认证效果：play_name\\play_greetings\\show_name\\show_image\r\n    // 陌生人验证：stranger_verification   int\r\n    // 考勤模式：attendance_mode   int\r\n    // 连续识别：continuous_recognition   int\r\n\r\n    let alg = new Object();\r\n    // alg[\"greetings\"]= parseInt($(\"#greetings\").val());\r\n    // alg[\"stranger_verification\"]= parseInt($(\"input[name='stranger_verification']:checked\").val());\r\n    // alg[\"continuous_recognition\"]= parseInt($(\"input[name='continuous_recognition']:checked\").val());\r\n\r\n    alg[\"record_warning\"]= parseInt($(\"#record_warning\").val());\r\n    alg[\"allow_tardiness\"]= parseInt($(\"#allow_tardiness\").val());\r\n    alg[\"weekend\"]= parseInt($(\"#weekend\").val());\r\n    alg[\"default_shift\"]= parseInt($(\"#default_shift\").val());\r\n    alg[\"allow_early\"]= parseInt($(\"#allow_early\").val());\r\n    alg[\"no_sign\"]= parseInt($(\"#no_sign\").val());\r\n\r\n\r\n    console.log(alg);\r\n    return alg\r\n}\r\n\r\nfunction alg_get() {\r\n    let alg = new Object()\r\n    alg[\"set\"] = 0;\r\n    alg[\"password\"] = $.cookie(\"pwd\")\r\n    let requestData = {\r\n        data: alg,\r\n        password: $.cookie(\"pwd\")\r\n    };\r\n    $.ajax({\r\n        url:  '/getLawRule',\r\n        type: 'POST',\r\n        contentType:\"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(requestData),\r\n        beforeSend: function() {\r\n\r\n        },\r\n        success: function(json){\r\n            //console.log(\"json: \",json);\r\n            json = json.data;\r\n\r\n\r\n            $(\"#record_warning\").val(json.record_warning);\r\n            $(\"#allow_tardiness\").val(json.allow_tardiness);\r\n            $(\"#weekend\").val(json.weekend);\r\n            $(\"#default_shift\").val(json.default_shift);\r\n            $(\"#allow_early\").val(json.allow_early);\r\n            $(\"#no_sign\").val(json.no_sign);\r\n\r\n\r\n            form.render(null,'form_info');\r\n        },\r\n        error: function(error){\r\n            console.log(\"error::::\",error);\r\n        }\r\n    });\r\n}\r\n\r\n\r\nfunction reads(obj) {\r\n    var file = obj.files[0];\r\n    var fileSize = obj.files[0].size; //获取文件大小，单位是M\r\n    var sizeKB = fileSize/1024/1024;\r\n    if(sizeKB > 5){\r\n        layer.msg(window.lang.screen_save_ph_no10m, { icon: 7, time: 2000, shade: [0.6, '#000', true] });\r\n        $(obj).val(\"\");\r\n    }\r\n    else{\r\n        var fileUrl = $(obj).val();//获取文件路径\r\n        var sp = fileUrl.lastIndexOf(\".\");//获取文件路径中.的位置\r\n        var sufix = fileUrl.substring(sp+1).toUpperCase();//获取文件后缀并将它大写\r\n        console.log(sufix);\r\n        // var reader = new FileReader();\r\n        //  reader.readAsDataURL(file);\r\n        //  reader.onload = function (ev) {\r\n        // \t $(\"#displayImg\").show();\r\n        //      $(\"#displayImg\").attr(\"src\", ev.target.result);\r\n        //      alg[\"pic_large\"] = ev.target.result;\r\n        //      $(obj).hide();\r\n        //      $(\"#test10\").hide();\r\n        //  }\r\n        if(sufix!=\"GIF\"){//设定格式判断\r\n            layer.msg(window.lang.ph_type_gif, { icon: 7, time: 2000, shade: [0.6, '#000', true] });\r\n            $(obj).val(\"\");\r\n        }else{\r\n            var layerMsg = layer.load(1,{ // 此处1没有意义，随便写个东西\r\n                icon: 0, // 0~2 ,0比较好看\r\n                shade: [0.5,'black'] // 黑色透明度0.5背景\r\n            });\r\n\r\n            let fmdata = new FormData();\r\n            fmdata.append(\"file\", file);\r\n            fmdata.append(\"name\", basename(fileUrl));\r\n            let url = '/setScreensaverPhoto' + \"?password=\"+ $.cookie(\"pwd\")\r\n            $.ajax({\r\n                type:'POST',\r\n                url: url,\r\n                data: fmdata,\r\n                cache: false,\r\n                processData: false,\r\n                contentType: false,\r\n                async: true,\r\n                success: function(data){\r\n                    var data1 = JSON.parse(data);\r\n                    console.log(\"data: \",data1,data1.result);\r\n                    layer.close(layerMsg);\r\n                    if(data1.result == 0){\r\n                        layer.msg(window.lang.screen_save_sueecss, { icon: 1, time: 2000, shade: [0.6, '#000', true] });\r\n                    }else{\r\n                        layer.msg(window.lang.screen_save_fail, { icon: 5, time: 2000, shade: [0.6, '#000', true] });\r\n                    }\r\n                },error:function(error){\r\n                    layer.close(layerMsg);\r\n                    layer.msg(window.lang.screen_save_sueecss, { icon: 7, time: 2000, shade: [0.6, '#000', true] });\r\n                }\r\n            });\r\n            layer.close(layerMsg);\r\n        }\r\n\r\n    }\r\n}\r\n\r\nfunction basename(str) {\r\n    let idx = str.lastIndexOf('/')\r\n    idx = idx > -1 ? idx : str.lastIndexOf('\\\\')\r\n    if (idx < 0) {\r\n        return str\r\n    }\r\n    return str.substring(idx + 1);\r\n}\r\n\r\n//添加自定义语言\r\nfunction addALanguage(type){\r\n    $(\"#langeuage_type\").val(type);\r\n    indexLay = layer.open({\r\n        type: 1,\r\n        title: window.lang.custom,\r\n        area: [\"400px\",\"300px\"],\r\n        fix: false, //不固定\r\n        maxmin: true,\r\n        shadeClose: false,\r\n        shade:0.4,\r\n        closeBtn: 1,\r\n        content: $(\"#language_box\")\r\n\r\n    });\r\n}\r\n\r\n//关闭弹窗\r\nfunction cancle(){\r\n    layer.close(indexLay);\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nvar updatedRows = {};\r\n// 全局变量，存储表格的原始数据\r\nvar holidaySource = [];\r\n\r\n\r\n\r\nfunction tipBan(e,type){\r\n    $(\".layui-tab-title > li\").removeClass(\"layui-this\");\r\n    if(type == \"net\"){\r\n        $(\".wifi_box\").hide();\r\n        $(\".server_box\").hide();\r\n        $(\".net_box\").show();\r\n        $(e).addClass(\"layui-this\");\r\n\r\n        dayLoad();\r\n    }else if(type == \"wifi\"){\r\n        $(\".wifi_box\").show();\r\n        $(\".net_box\").hide();\r\n        $(\".server_box\").hide();\r\n        $(e).addClass(\"layui-this\");\r\n\r\n        weekLoad();\r\n    }else{\r\n        $(\".server_box\").show();\r\n        $(\".net_box\").hide();\r\n        $(\".wifi_box\").hide();\r\n        $(e).addClass(\"layui-this\");\r\n\r\n        holidayLoad();\r\n    }\r\n\r\n\r\n}\r\n\r\n\r\n\r\nfunction holidayLoad() {\r\n    console.log('23423')\r\n    $('#table3').bootstrapTable({\r\n        method: \"get\",\r\n        striped: true,\r\n        singleSelect: false,\r\n        showLoading: false,\r\n        dataType: \"json\",\r\n        pagination: false, //分页\r\n        pageSize: 10,\r\n        pageNumber: 1,\r\n        search: false, //显示搜索框\r\n        contentType: \"application/x-www-form-urlencoded\",\r\n        queryParams: null,\r\n        columns: [\r\n            {\r\n                title: \"编号\",\r\n                field: 'openHolidayNum',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n            {\r\n                title: \"名称\",\r\n                field: 'openHolidayName',\r\n                align: 'center',\r\n                valign: 'middle',\r\n                formatter: function(value, row, index) {\r\n                    value = value === undefined ? '' : value;\r\n                    return '<input type=\"text\" class=\"form-control editable\" data-field=\"openHolidayName\" data-id=\"'+row.openHolidayNum+'\" value=\"'+value+'\" ' +\r\n                        'style=\"width: 100px; \">';\r\n                }\r\n            },\r\n            {\r\n                title: \"开始时间\",\r\n                field: 'openHolidayStart',\r\n                align: 'center',\r\n                valign: 'middle',\r\n                formatter: function(value, row, index) {\r\n                    value = value === undefined ? '' : value;\r\n                    return '<input type=\"text\" class=\"form-control editable start-time\" data-field=\"openHolidayStart\" data-id=\"'+row.openHolidayNum+'\" value=\"'+value+'\" placeholder=\"\" ' +\r\n                        'style=\"width: 50px; \">';\r\n                }\r\n            },\r\n            {\r\n                title: \"结束时间\",\r\n                field: 'openHolidayEnd',\r\n                align: 'center',\r\n                valign: 'middle',\r\n                formatter: function(value, row, index) {\r\n                    value = value === undefined ? '' : value;\r\n                    return '<input type=\"text\" class=\"form-control editable end-time\" data-field=\"openHolidayEnd\" data-id=\"'+row.openHolidayNum+'\" value=\"'+value+'\" placeholder=\"\" ' +\r\n                        'style=\"width: 50px; \">';                }\r\n            },\r\n            {\r\n                title: \"农历/新历\",\r\n                field: 'gregorian_calendar',\r\n                align: 'center',\r\n                valign: 'middle',\r\n// 表格列格式化函数中的农历/新历显示部分\r\n                formatter: function(value, row, index) {\r\n                    // 确保value有值\r\n                    value = value === undefined ? 0 : value;\r\n                    // 修改判断逻辑：1表示农历，0表示新历\r\n                    var text = value == 1 ? window.lang.w_nongli : window.lang.w_xinli;\r\n                    var className = value == 1 ? 'calendar-lunar' : 'calendar-gregorian';\r\n\r\n                    return '<button type=\"button\" class=\"calendar-toggle ' + className + '\" ' +\r\n                        'data-id=\"' + row.openHolidayNum + '\" ' +\r\n                        'data-value=\"' + value + '\">' + text + '</button>';\r\n                }\r\n            }\r\n        ]\r\n    });\r\n\r\n    // 为编辑框添加事件监听\r\n    $('#table3').on('input', '.start-time, .end-time', function(e) {\r\n        // 只允许数字和横杠\r\n        this.value = this.value.replace(/[^0-9-]/g, '');\r\n    });\r\n\r\n// 农历/新历切换按钮点击事件处理部分\r\n    $('#table3').on('click', '.calendar-toggle', function() {\r\n        var id = $(this).data('id');\r\n        var currentValue = $(this).data('value');\r\n        // 修改切换逻辑：0 <-> 1\r\n        var newValue = currentValue == 0 ? 1 : 0;\r\n        // 修改显示文本逻辑：1表示农历，0表示新历\r\n        var newText = newValue == 1 ? window.lang.w_nongli : window.lang.w_xinli;\r\n        var newClass = newValue == 1 ? 'calendar-lunar' : 'calendar-gregorian';\r\n\r\n        // 更新按钮显示\r\n        $(this).data('value', newValue);\r\n        $(this).text(newText);\r\n        $(this).attr('class', 'calendar-toggle ' + newClass);\r\n\r\n        // 更新数据\r\n        updatedRows[id] = updatedRows[id] || {};\r\n        updatedRows[id]['gregorian_calendar'] = newValue;\r\n\r\n        // 更新 holidaySource 中的数据\r\n        updateHolidaySource(id, 'gregorian_calendar', newValue);\r\n    });\r\n\r\n    $('#table3').on('change', '.editable', function() {\r\n        var id = $(this).data('id');\r\n        var field = $(this).data('field');\r\n        var value = $(this).val();\r\n\r\n        // 处理空值\r\n        if(value === undefined) value = '';\r\n\r\n        // 新增：必填项校验\r\n        if ((field === 'openHolidayStart' && value) || (field === 'openHolidayEnd' && value)) {\r\n        }\r\n\r\n        // 更新数据\r\n        updatedRows[id] = updatedRows[id] || {};\r\n        updatedRows[id][field] = value;\r\n\r\n        // 如果是时间字段，进行格式验证\r\n        if(field === 'openHolidayStart' || field === 'openHolidayEnd') {\r\n            // 格式验证\r\n            if(!validateDate(value)) {\r\n                alert(window.lang.w_riqigeshibuzhengque);\r\n                $(this).val(getOriginalValue(id, field));\r\n                delete updatedRows[id][field];\r\n                if(Object.keys(updatedRows[id]).length === 0) {\r\n                    delete updatedRows[id];\r\n                }\r\n                return false;\r\n            }\r\n\r\n            // 检查结束时间是否小于开始时间\r\n            if(field === 'openHolidayStart' || field === 'openHolidayEnd') {\r\n                var startTime = $(this).closest('tr').find('.start-time').val();\r\n                var endTime = $(this).closest('tr').find('.end-time').val();\r\n\r\n                if(startTime && endTime) {\r\n                    if(!compareDates(startTime, endTime)) {\r\n                        alert(window.lang.w_jieshushijianbuxiaoyukaishi);\r\n                        $(this).val(field === 'openHolidayStart' ?\r\n                            getOriginalValue(id, 'openHolidayStart') :\r\n                            getOriginalValue(id, 'openHolidayEnd'));\r\n                        delete updatedRows[id][field];\r\n                        if(Object.keys(updatedRows[id]).length === 0) {\r\n                            delete updatedRows[id];\r\n                        }\r\n                        return false;\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        // 更新 holidaySource 中的数据\r\n        updateHolidaySource(id, field, value);\r\n    });\r\n    lang_load();\r\n    getholidayTableData();\r\n}\r\n\r\nfunction getholidayTableData() {\r\n    let alg = new Object()\r\n    alg[\"set\"] = 0;\r\n    alg[\"password\"] = $.cookie(\"pwd\")\r\n    let requestData = {\r\n        data: alg,\r\n        password: $.cookie(\"pwd\")\r\n    };\r\n\r\n    $.ajax({\r\n        url: \"/getOpenHoliday\",\r\n        // url: \"http://192.168.1.163:3000/gate/device/getA\",\r\n        type: 'POST',\r\n        async: false,\r\n        contentType:\"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(requestData),\r\n        success: function (result) {\r\n            var pager = result.data;\r\n            var data = pager;\r\n\r\n            // 处理可能的空值\r\n            if(data && Array.isArray(data)) {\r\n                data.forEach(item => {\r\n                    if(item.openHolidayName === undefined) item.openHolidayName = '';\r\n                    if(item.openHolidayStart === undefined) item.openHolidayStart = '';\r\n                    if(item.openHolidayEnd === undefined) item.openHolidayEnd = '';\r\n                    // 确保 gregorian_calendar 字段存在，默认为 0（新历）\r\n                    if(item.gregorian_calendar === undefined) item.gregorian_calendar = 0;\r\n                });\r\n            } else {\r\n                data = []; // 如果后端返回的数据不是数组或为空，初始化为空数组\r\n            }\r\n\r\n            // 计算需要补全的数据数量\r\n            const needCount = 30 - data.length;\r\n            if (needCount > 0) {\r\n                // 获取当前最大的 openHolidayNum\r\n                let maxNum = 0;\r\n                if (data.length > 0) {\r\n                    maxNum = Math.max(...data.map(item => item.openHolidayNum));\r\n                }\r\n\r\n                // 补全数据\r\n                for (let i = 1; i <= needCount; i++) {\r\n                    data.push({\r\n                        openHolidayNum: maxNum + i,\r\n                        openHolidayName: '',\r\n                        openHolidayStart: '',\r\n                        openHolidayEnd: '',\r\n                        gregorian_calendar: 0\r\n                    });\r\n                }\r\n            }\r\n\r\n            holidaySource = data; // 更新全局数据源\r\n            $(\"#page_num\").text(data.length);\r\n            $(\"#sum_num\").text(data.length);\r\n            $(\"#page_size\").text(data.length);\r\n            $(\".page a\").removeClass(\"current\");\r\n            $(\".first\").addClass(\"current\");\r\n            $('#table3').bootstrapTable(\"load\", data);\r\n        }\r\n    })\r\n}\r\n\r\n\r\n\r\n// 验证日期格式 (MM-DD)\r\nfunction validateDate(dateStr) {\r\n    if(!dateStr) return true; // 允许空值\r\n\r\n    var pattern = /^([01]?\\d)-([0-3]?\\d)$/;\r\n    if(!pattern.test(dateStr)) return false;\r\n\r\n    var parts = dateStr.split('-');\r\n    var month = parseInt(parts[0], 10);\r\n    var day = parseInt(parts[1], 10);\r\n\r\n    // 验证月份范围\r\n    if(month < 1 || month > 12) return false;\r\n\r\n    // 验证日期范围 (简化版，不考虑每月具体天数差异)\r\n    if(day < 1 || day > 31) return false;\r\n\r\n    return true;\r\n}\r\n\r\n// 比较两个日期\r\nfunction compareDates(start, end) {\r\n    var startParts = start.split('-');\r\n    var endParts = end.split('-');\r\n\r\n    var startMonth = parseInt(startParts[0], 10);\r\n    var startDay = parseInt(startParts[1], 10);\r\n    var endMonth = parseInt(endParts[0], 10);\r\n    var endDay = parseInt(endParts[1], 10);\r\n\r\n    return (endMonth > startMonth) || (endMonth === startMonth && endDay >= startDay);\r\n}\r\n\r\n// 获取原始数据值\r\nfunction getOriginalValue(id, field) {\r\n    for(var i = 0; i < holidaySource.length; i++) {\r\n        if(holidaySource[i].openHolidayNum == id) {\r\n            return holidaySource[i][field] || '';\r\n        }\r\n    }\r\n    return '';\r\n}\r\n\r\n// 更新 holidaySource 中的数据\r\nfunction updateHolidaySource(id, field, value) {\r\n    for(var i = 0; i < holidaySource.length; i++) {\r\n        if(holidaySource[i].openHolidayNum == id) {\r\n            holidaySource[i][field] = value;\r\n            break;\r\n        }\r\n    }\r\n}\r\n"
          },
