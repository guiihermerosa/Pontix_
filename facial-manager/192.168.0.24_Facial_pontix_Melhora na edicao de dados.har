          "content": {
            "size": 8901,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\r\n<html>\r\n  \r\n  <head>\r\n    <meta charset=\"UTF-8\">\r\n    <titl ></titl>\r\n    <meta name=\"renderer\" content=\"webkit\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\r\n    <meta name=\"viewport\" content=\"width=device-width,user-scalable=yes, minimum-scale=0.4, initial-scale=0.8,target-densitydpi=low-dpi\" />\r\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\r\n    <link rel=\"stylesheet\" href=\"../css/font.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/xadmin.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/bootstrap.min.css\">\r\n\r\n      <script src=\"../js/html5.min.js\"></script>\r\n      <script src=\"../js/respond.min.js\"></script>\r\n    <style>\r\n      .fixed-table-loading{\r\n        display: none;\r\n      }\r\n      .current{\r\n        background-color: #009688!important;\r\n        color: #fff!important;;\r\n      }\r\n    </style>\r\n  </head>\r\n  \r\n  <body onload=\"Personload()\">\r\n    <div class=\"x-nav\">\r\n      <span class=\"layui-breadcrumb\">\r\n      <a class=\"layui-btn layui-btn-primary layui-btn-small\" style=\"line-height:1.6em;margin-top:3px;float:right\" href=\"javascript:location.replace(location.href);\" title=\"刷新\">\r\n        <i class=\"layui-icon\" style=\"line-height:38px\">&#xe669;</i></a>\r\n      </span>\r\n    </div>\r\n    <div class=\"x-body\">\r\n      <div class=\"layui-row\">\r\n        <form class=\"layui-form layui-col-md12 x-so\">\r\n          <input type=\"text\" name=\"time\" id=\"startTime\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n          <input type=\"text\" name=\"time\" id=\"endTime\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\">\r\n          <button style=\"margin-top: -3px; \"  class=\"layui-btn\" type=\"button\" onclick=\"searchNote()\"><i class=\"layui-icon\">&#xe615;</i></button>\r\n\r\n          <button class=\"layui-btn layui-btn-warm lang\" key=\"export\" style=\"float: right;\" type=\"button\" onclick=\"tableToExcel()\">导出</button> \r\n        </form>\r\n      </div>\r\n      <!-- <xblock>\r\n        <button class=\"layui-btn\" onclick=\"addEmployee()\"><i class=\"layui-icon\"></i><span class=\"lang\" key=\"insert\">添加</span></button>\r\n        <button class=\"layui-btn layui-btn-danger\" onclick=\"removeEmployList()\"><i class=\"layui-icon\"></i><span class=\"lang\" key=\"bulkDelete\">批量删除</span></button>\r\n        \r\n      \r\n    </xblock> -->\r\n  \r\n      <table class=\"layui-table\" id=\"table\">\r\n       \r\n      </table>\r\n      <div class=\"card-inner\" id=\"page\" style=\"text-align: right\">\r\n\r\n      </div>\r\n      <!-- <div class=\"fixed-table-pagination\" style=\"display: block;\">\r\n\t    \t<div class=\"pull-left pagination-detail\">\r\n\t   \t\t\t<span class=\"pagination-info\"><span class=\"lang\" key=\"now_page\">当前页</span> <span id=\"page_num\"></span> ,<span class=\"lang\" key=\"sum_page\">总页数</span> <span id=\"page_sum\"></span>  </span>\r\n\t    \t\t<span style=\"display:none\" class=\"page-list\">当前页共有 \r\n\t    \t\t\t<span class=\"page-size\" id=\"page_size\"></span>     \t\t\t\r\n\t    \t\t</span> \r\n\t    \t</div>\r\n       </div>\r\n       <div class=\"page\">\r\n\t        <div>\r\n\t          <a class=\"prev\" href=\"javascript:void(0)\" onclick=\"selectMoreTable('last',this)\">&lt;&lt;</a>\r\n\t          <a class=\"first lang\" key=\"main_menu_home\" href=\"javascript:void(0)\" onclick=\"selectMoreTable('first',this)\">首页</a>\r\n\t          <a class=\"last lang\" key=\"last_page\" href=\"javascript:void(0)\" onclick=\"selectMoreTable('final',this)\">尾页</a>\r\n\t          <a class=\"next\" href=\"javascript:void(0)\" onclick=\"selectMoreTable('next',this)\">&gt;&gt;</a>\r\n\t        </div>\r\n      </div> -->\r\n\r\n    </div>\r\n   <div style=\"display:none;\" id=\"export_box\">\r\n        <form class=\"layui-form\" id=\"employeeInfo\" method=\"post\" enctype=\"multipart/form-data\">\r\n            <div class=\"param_box\" style=\"margin-top: 20px;\">\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span class=\"lang\" key=\"time\">时间</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <input type=\"text\" name=\"time\" id=\"EpStartTime\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n                        <input type=\"text\" name=\"time\" id=\"EpEndTime\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\" style=\"margin-top: 20px;\">\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_repass\" class=\"layui-form-label\">\r\n                    </label>\r\n                    <button class=\"layui-btn lang\" key=\"save\" type=\"button\" onclick=\"exportNote()\">保存</button>\r\n                    <button  class=\"layui-btn cancle-btn lang\" key=\"cancle\" onclick=\"cancleExpt()\">取消</button>  \r\n                </div>\r\n            </div>\r\n        </form>\r\n   </div>\r\n  </body>\r\n    <script src=\"../js/jquery.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../lib/layui/layui.js\" charset=\"utf-8\"></script>\r\n    <script src=\"../js/bootstrap.min.js\"></script>\r\n\t<script src=\"../js/bootstrap-table.js\"></script>\r\n\t<script src=\"../js/bootstrap-table-zh-CN.min.js\"></script>\r\n    <script src=\"../js/jquery.cookie.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../js/xadmin.js\"></script>\r\n    <script src=\"../lang/lang.js\"></script>\r\n    <script src=\"../js/notify.js\"></script>\r\n    <script src=\"../js/export.js\"></script>  \r\n\t<script src=\"../js/stringer_note.js\"></script>\r\n    \r\n     \r\n  <script>\r\n     lang_load();\r\n     $(\"#EpStartTime\").attr(\"placeholder\",window.lang.start_time);\r\n     $(\"#EpEndTime\").attr(\"placeholder\",window.lang.end_time);\r\n     $(\"#startTime\").attr(\"placeholder\",window.lang.start_time);\r\n     $(\"#endTime\").attr(\"placeholder\",window.lang.end_time);\r\n     $(\"#userid\").attr(\"placeholder\",window.lang.userid);\r\n     \r\n     var firstDate = new Date();\r\n      firstDate.setDate(1); //第一天       \r\n      var endDate = new Date(firstDate);      \r\n      endDate.setMonth(firstDate.getMonth()+1);     \r\n      endDate.setDate(0);\r\n      // console.log(\"firstDate: \",firstDate);\r\n      // console.log(\"date: \",new Date(firstDate));\r\n     var layer;\r\n        layui.use(['form','layer','laydate'], function(){\r\n                $ = layui.jquery;\r\n            var form = layui.form\r\n            ,laydate = layui.laydate;\r\n            layer = layui.layer;\r\n\r\n            //日期范围\r\n           var startDate = laydate.render({ \r\n                elem: '#startTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,               \r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    endDate.config.min=date;\r\n                    }else{\r\n                        endDate.config.min=startDate.config.min;\r\n                    }\r\n                },\r\n            }); \r\n\r\n           var endDate = laydate.render({ \r\n                elem: '#endTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,           \r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    startDate.config.max=date;\r\n                    }else{\r\n                        startDate.config.max=endDate.config.max;\r\n                    }\r\n                }\r\n\r\n            }); \r\n\r\n            //导出日期范围\r\n           var startD = laydate.render({ \r\n                elem: '#EpStartTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(firstDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    endD.config.min=date;\r\n                    }else{\r\n                        endD.config.min=startD.config.min;\r\n                    }\r\n                },\r\n            }); \r\n\r\n           var endD = laydate.render({ \r\n                elem: '#EpEndTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(endDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    startD.config.max=date;\r\n                    }else{\r\n                        startD.config.max=endD.config.max;\r\n                    }\r\n                }\r\n\r\n            }); \r\n        });\r\n\r\n        \r\n\r\n  </script>\r\n\r\n</html>"
          },
