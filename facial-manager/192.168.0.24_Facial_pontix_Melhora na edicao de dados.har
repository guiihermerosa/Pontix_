            "mimeType": "application/x-javascript",
            "text": "function notify(text, sticky) {\r\n    $().toastmessage('showToast',{\r\n        text: text,\r\n        sticky   : sticky || false,\r\n        position : 'top-right',\r\n        closeText: ''\r\n    });\r\n}\r\n\r\nfunction check_permission() {\r\n    if (typeof ($.cookie(\"pwd\")) == \"undefined\" || ($.cookie(\"pwd\")) == null){\r\n       location.href = \"login.html\"\r\n    }\r\n}\r\n"
