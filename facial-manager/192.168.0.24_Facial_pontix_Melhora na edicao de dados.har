) {\r\n//         layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//     if ($(\"#EpEndTime\").val() == \"\" || $(\"#EpEndTime\").val() == null) {\r\n//         layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//\r\n//     let send = new Object();\r\n//     send[\"password\"] = $.cookie(\"pwd\");\r\n//     send[\"type\"] = 0;\r\n//\r\n//     // 设置时间范围\r\n//     if ($(\"#EpStartTime\").val() == \"\" && $(\"#EpEndTime\").val() == \"\") {\r\n//         send[\"start_time\"] = null;\r\n//         send[\"end_time\"] = null;\r\n//         send[\"startTime\"] = null;\r\n//         send[\"endTime\"] = null;\r\n//     } else {\r\n//         if ($(\"#EpStartTime\").val() != \"\" && $(\"#EpEndTime\").val() != \"\") {\r\n//             send[\"start_time\"] = $(\"#EpStartTime\").val();\r\n//             send[\"end_time\"] = $(\"#EpEndTime\").val();\r\n//             send[\"startTime\"] = $(\"#EpStartTime\").val();\r\n//             send[\"endTime\"] = $(\"#EpEndTime\").val();\r\n//         } else {\r\n//             layer.msg(window.lang.y_wanzhegnshijianduan,, { icon: 5, time: 1000 });\r\n//             return false;\r\n//         }\r\n//     }\r\n//\r\n//     let w_riqi = window.lang.w_riqi;\r\n//     let w_zhou = window.lang.w_zhou;\r\n//     let w_banduanyishangban = window.lang.w_banduanyishangban;\r\n//     let w_banduanyixiaban = window.lang.w_banduanyixiaban;\r\n//     let w_banduanershangban = window.lang.w_banduanershangban;\r\n//     let w_banduanerxiaban = window.lang.w_banduanerxiaban;\r\n//     let w_banduansanshangban = window.lang.w_banduansanshangban;\r\n//     let w_banduansanxiaban = window.lang.w_banduansanxiaban;\r\n//     let w_chuqinshiduanbiaozhun = window.lang.w_chuqinshiduanbiaozhun;\r\n//     let w_chuqinshiduanshiji = window.lang.w_chuqinshiduanshiji;\r\n//     let w_jiabanshishu = window.lang.w_jiabanshishu;\r\n//     let w_chidaofenzhong = window.lang.w_chidaofenzhong;\r\n//     let w_zaotuifenzhong = window.lang.w_zaotuifenzhong;\r\n//\r\n//     let w_gonghao = window.lang.w_gonghao;\r\n//     let w_xingming = window.lang.w_xingming;\r\n//     let w_banchi = window.lang.w_banchi;\r\n//     let w_bumne = window.lang.w_bumne;\r\n//\r\n//     // 定义表头\r\n//     var tHeader = [w_riqi, w_zhou, w_banduanyishangban, w_banduanyixiaban, w_banduanershangban,\r\n//         w_banduanerxiaban, w_banduansanshangban, w_banduansanxiaban,\r\n//         w_chuqinshiduanbiaozhun, w_chuqinshiduanshiji, w_jiabanshishu, w_chidaofenzhong, w_zaotuifenzhong];\r\n//\r\n//\r\n//\r\n//     // 显示加载提示框\r\n//     let contentText = \"正在导出文件操作，请勿刷新网页或者其他操作（ 若文件较大，导出时间较慢 ）\";\r\n//     let loadingIndex = layer.load(1, {\r\n//         shade: [0.5, '#767676'], // 遮罩层透明度及颜色\r\n//         content: contentText\r\n//     });\r\n//\r\n//     // 直接调用导出接口\r\n//     $.ajax({\r\n//         url: '/getAttendTable',\r\n//         // url: 'http://192.168.1.163:3000/gate/Ce/getZ',\r\n//         type: 'POST',\r\n//         async: true, // 异步请求\r\n//         contentType: \"application/json\",\r\n//         dataType: \"json\",\r\n//         data: JSON.stringify({\r\n//             ...send,\r\n//             startIndex: 1,      // 从第1条开始\r\n//             endIndex: 999999,   // 设置一个很大的结束值，假设数据不会超过这个数\r\n//             currentCall: 1,     // 当前请求为第1次\r\n//             totalCall: 1        // 总共只有1次请求\r\n//         }),\r\n//         success: function (result) {\r\n//             layer.close(loadingIndex); // 关闭加载层\r\n//\r\n//             if (result.code === 200 && result.data && result.data.length > 0) {\r\n//                 // 准备导出数据\r\n//                 let exportData = [];\r\n//\r\n//                 // 只添加一次表头\r\n//                 exportData.push(tHeader);\r\n//\r\n//                 // 处理每个员工的考勤数据\r\n//                 result.data.forEach((employee, index) => {\r\n//                     // 添加员工信息作为表格标题\r\n//                     exportData.push({\r\n//                         w_riqi: `${w_gonghao}：${employee.userid} `,\r\n//                         w_zhou: `${w_xingming}：${employee.employeeName} `,\r\n//                         w_banduanyishangban: `${w_bumne}： ${employee.department}`,\r\n//                         w_banduanyixiaban: `${w_banchi}： ${employee.shift}`,\r\n//                         w_banduanershangban: `${w_riqi}： ${employee.dateRange.start} - ${employee.dateRange.end}`,\r\n//                         w_banduanerxiaban: '',\r\n//                         w_banduansanshangban: '',\r\n//                         w_banduansanxiaban: '',\r\n//                         w_chuqinshiduanbiaozhun: '',\r\n//                         w_chuqinshiduanshiji: '',\r\n//                         w_jiabanshishu: '',\r\n//                         w_chidaofenzhong: '',\r\n//                         w_zaotuifenzhong: ''\r\n//                     });\r\n//\r\n//                     // 添加考勤数据\r\n//                     employee.attendan.forEach(att => {\r\n//                         exportData.push([\r\n//                             att.attDate,\r\n//                             att.attWeek,\r\n//                             att.shift_t1,\r\n//                             att.shift_t2,\r\n//                             att.shift_t3,\r\n//                             att.shift_t4,\r\n//                             att.shift_t5,\r\n//                             att.shift_t6,\r\n//                             att.attStandard,\r\n//                             att.attActual,\r\n//                             att.attOver,\r\n//                             att.attLate,\r\n//                             att.attEarly\r\n//                         ]);\r\n//                     });\r\n//\r\n//                     // 添加空行分隔不同员工的表格\r\n//                     for (let i = 0; i < 3; i++) {\r\n//                         exportData.push([]);\r\n//                     }\r\n//                 });\r\n//\r\n//                 // 导出Excel\r\n//                 export2Excel(tHeader, exportData, window.lang.w_kaoqingmingxijilu);\r\n//                 layer.msg(\"文件已导出\", { icon: 1, time: 1000 });\r\n//             } else {\r\n//                 layer.msg(window.lang.y_meiyoushujudaochu, { icon: 1, time: 1000 });\r\n//             }\r\n//         },\r\n//         error: function () {\r\n//             layer.close(loadingIndex); // 关闭加载层\r\n//             layer.msg(window.lang.y_daochushibai, { icon: 1, time: 1000 });\r\n//         }\r\n//     });\r\n// }\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nfunction exportNoteKaoqinhuizong() {\r\n    console.log(\"导出考勤汇总表...\");\r\n\r\n    // 创建样式标签（加载提示样式）\r\n    const style = document.createElement('style');\r\n    style.type = 'text/css';\r\n    const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n    style.appendChild(document.createTextNode(cssText));\r\n    document.head.appendChild(style);\r\n\r\n    // 校验时间范围\r\n    if ($(\"#EpStartTime2\").val() == \"\" || $(\"#EpStartTime2\").val() == null) {\r\n        layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n    if ($(\"#EpEndTime2\").val() == \"\" || $(\"#EpEndTime2\").val() == null) {\r\n        layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n\r\n    // 接口请求参数\r\n    let send = {\r\n        password: $.cookie(\"pwd\"),\r\n        type: 0, // 导出考勤汇总表标识\r\n        start_time: $(\"#EpStartTime2\").val(),\r\n        end_time: $(\"#EpEndTime2\").val(),\r\n        startTime: $(\"#EpStartTime2\").val(),\r\n        endTime: $(\"#EpEndTime2\").val()\r\n    };\r\n\r\n\r\n\r\n    let t_kaoqinhuizongbiao = window.lang.t_kaoqinhuizongbiao;\r\n    let w_riqi = window.lang.w_riqi;\r\n    let t_bianhao = window.lang.t_bianhao;\r\n    let t_xingming = window.lang.t_xingming;\r\n    let t_bumen = window.lang.t_bumen;\r\n    let t_chuqinshishu = window.lang.t_chuqinshishu;\r\n    let t_shidaojilu = window.lang.t_shidaojilu;\r\n    let t_zaotuijilu = window.lang.t_zaotuijilu;\r\n    let t_jiabanshishu = window.lang.t_jiabanshishu;\r\n    let t_gongzuorishu = window.lang.t_gongzuorishu;\r\n    let t_kuanggong = window.lang.t_kuanggong;\r\n    let t_biaozhun = window.lang.t_biaozhun;\r\n    let t_shiji = window.lang.t_shiji;\r\n    let t_chishu = window.lang.t_chishu;\r\n    let t_fenzhong = window.lang.t_fenzhong;\r\n\r\n\r\n\r\n    // ------------------- 构建复杂表头（重点：跨行列合并） -------------------\r\n    let theadHtml = `\r\n    <thead>\r\n      <!-- 第一行：标题行（跨2行、占满13列） -->\r\n      <tr>\r\n        <th rowspan=\"2\" colspan=\"13\" style=\"text-align: center; color: #366328; background-color: #cbfbfb; \r\n        vertical-align: middle;\">${t_kaoqinhuizongbiao}</th>\r\n      </tr>\r\n      <!-- 第二行：日期范围行（占满13列） -->\r\n         <tr>\r\n         </tr>\r\n      <tr>\r\n<!--        <th colspan=\"13\" style=\"color: #555; background-color: #f0f9f9; -->\r\n        <th colspan=\"13\" style=\"color: #366328; background-color: #cbfbfb; \r\n        mso-number-format:'@'; \r\n        vertical-align: middle; text-align: left;\">\r\n          ${w_riqi}：${$(\"#EpStartTime2\").val()} - ${$(\"#EpEndTime2\").val()}\r\n        </th>\r\n      </tr>\r\n      <!-- 第三行：细化表头（编号、姓名、部门等分类） -->\r\n      <tr>\r\n        <th rowspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_bianhao}</th>\r\n        <th rowspan=\"2\" style=\"text-align: center; color: #9a3502; \">${t_xingming}</th>\r\n        <th rowspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_bumen}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_chuqinshishu}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_shidaojilu}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_zaotuijilu}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_jiabanshishu}</th>\r\n        <th rowspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_gongzuorishu}</th>\r\n        <th rowspan=\"2\" style=\"text-align: center; color: #9a3502\">${t_kuanggong}</th>\r\n      </tr>\r\n      <!-- 第四行：二级表头（标准/实际、次数/分钟等细分）ca4440 -->\r\n      <tr>\r\n\r\n        <th style=\"text-align: center; color: #9a3502\">${t_biaozhun}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_shiji}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_chishu}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_fenzhong}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_chishu}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_fenzhong}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_biaozhun}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${t_shiji}</th>\r\n\r\n      </tr>\r\n    </thead>\r\n  `;\r\n\r\n    // 显示加载层\r\n    let contentText = window.lang.w_contentText;\r\n    let loadingIndex = layer.load(1, {\r\n        shade: [0.5, '#767676'],\r\n        content: contentText\r\n    });\r\n\r\n    // 调用接口\r\n    $.ajax({\r\n        // url: 'http://192.168.1.163:3000/gate/Ce/getX',\r\n        url: '/getSummaryTable',\r\n        type: 'POST',\r\n        async: true,\r\n        contentType: \"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify({\r\n            ...send,\r\n            startIndex: 1,\r\n            endIndex: 999999,\r\n            currentCall: 1,\r\n            totalCall: 1\r\n        }),\r\n        success: function (result) {\r\n            layer.close(loadingIndex);\r\n            console.log(\"考勤汇总数据:\", result);\r\n\r\n            if (result.code === 200 && result.data.collect && result.data.collect.length > 0) {\r\n                let tbodyHtml = '<tbody>';\r\n                // 遍历数据，拼接行\r\n                result.data.collect.forEach((item, index) => {\r\n                    // 构建数据行：为每个单元格添加背景颜色样式\r\n                    let dataTr = `\r\n            <tr>\r\n\r\n              <td style=\"text-align: center; background-color: #FFFF99; \">${item.userid || ''}</td> <!-- 编号 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99; \">${item.employeeName || ''}</td> <!-- 姓名 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.department || ''}</td> <!-- 部门 -->\r\n              \r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.attStandard || ''}</td> <!-- 出勤标准 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.attActual || ''}</td> <!-- 出勤实际 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.lateNum || ''}</td> <!-- 迟到次数 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.lateMin || ''}</td> <!-- 迟到分钟 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.earlyNum || ''}</td> <!-- 早退次数 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.earlyMin || ''}</td> <!-- 早退分钟 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.overStandard || ''}</td> <!-- 加班标准 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.overActual || ''}</td> <!-- 加班实际 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99; mso-number-format:'@';\">&nbsp;${item.workDays || ''}</td> <!-- 工作日数 -->\r\n              <td style=\"text-align: center; background-color: #FFFF99;\">${item.absentDays || ''}</td> <!-- 旷工 -->\r\n            </tr>\r\n          `;\r\n                    tbodyHtml += dataTr;\r\n                });\r\n                tbodyHtml += '</tbody>';\r\n\r\n                // 拼接完整表格\r\n                let tableHtml = `\r\n          <table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 100%; border-collapse: collapse;\">\r\n            ${theadHtml}\r\n            ${tbodyHtml}\r\n          </table>\r\n        `;\r\n\r\n                // 调用导出（复用 tableToNotIE 方法）\r\n                tableToNotIE(tableHtml, t_kaoqinhuizongbiao);\r\n                layer.msg(window.lang.w_kaoqinmingxibiaodaochuichenggong2, { icon: 1, time: 1500 });\r\n            } else {\r\n                layer.msg(window.lang.w_kaoqinmingxibiaodaochuiwushuju2, { icon: 2, time: 1500 });\r\n            }\r\n        },\r\n        // error: function () {\r\n        //     layer.close(loadingIndex);\r\n        //     layer.msg(window.lang.w_kaoqinmingxibiaodaochushibai2, { icon: 5, time: 1500 });\r\n        // }\r\n        error: function(error) {\r\n            layer.msg(error, { icon: 5, time: 1000 });\r\n        },\r\n    });\r\n}\r\n\r\n\r\n\r\n\r\n\r\n// function exportNoteKaoqinmingxi() {\r\n//     console.log(\"导出考勤明细表...\");\r\n//\r\n//     // 创建样式标签（加载提示样式）\r\n//     const style = document.createElement('style');\r\n//     style.type = 'text/css';\r\n//     const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n//     style.appendChild(document.createTextNode(cssText));\r\n//     document.head.appendChild(style);\r\n//\r\n//     // 校验时间范围\r\n//     if ($(\"#EpStartTime\").val() == \"\" || $(\"#EpStartTime\").val() == null) {\r\n//         layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//     if ($(\"#EpEndTime\").val() == \"\" || $(\"#EpEndTime\").val() == null) {\r\n//         layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//\r\n//     // 接口请求参数\r\n//     let send = {\r\n//         password: $.cookie(\"pwd\"),\r\n//         type: 0, // 导出考勤明细表标识\r\n//         start_time: $(\"#EpStartTime\").val(),\r\n//         end_time: $(\"#EpEndTime\").val(),\r\n//         startTime: $(\"#EpStartTime\").val(),\r\n//         endTime: $(\"#EpEndTime\").val()\r\n//     };\r\n//\r\n//\r\n//     let w_kaoqingmingxibiao = window.lang.k_kaoqinmingxibiao;\r\n//     let w_riqi = window.lang.w_riqi;\r\n//     let w_zhou = window.lang.w_zhou;\r\n//     let w_banduanyishangban = window.lang.w_banduanyishangban;\r\n//     let w_banduanyixiaban = window.lang.w_banduanyixiaban;\r\n//\r\n//     let w_chuqinshiduanbiaozhun = window.lang.w_chuqinshiduanbiaozhun;\r\n//     let w_chuqinshiduanshiji = window.lang.w_chuqinshiduanshiji;\r\n//     let w_chuqinshiduan = window.lang.t_chuqinshishu;\r\n//     let w_jiabanshishu = window.lang.w_jiabanshishu;\r\n//     let w_chidaofenzhong = window.lang.w_chidaofenzhong;\r\n//     let w_zaotuifenzhong = window.lang.w_zaotuifenzhong;\r\n//\r\n//     let w_gonghao = window.lang.w_gonghao;\r\n//     let w_xingming = window.lang.w_xingming;\r\n//     let w_banchi = window.lang.w_banchi;\r\n//     let w_bumne = window.lang.w_bumne;\r\n//     let w_banduanyi = window.lang.w_banduanyi;\r\n//     let w_banduaner = window.lang.w_banduaner;\r\n//     let w_banduansan = window.lang.w_banduansan;\r\n//\r\n//\r\n//\r\n//     // ------------------- 构建复杂表头（支持多级合并） -------------------\r\n//     let theadHtml = `\r\n//     <thead>\r\n//       <!-- 第一行：主标题（跨2行、占满13列） -->\r\n//\r\n//     </thead>\r\n//   `;\r\n//\r\n//     // 显示加载层\r\n//     let contentText = window.lang.w_contentText;\r\n//     let loadingIndex = layer.load(1, {\r\n//         shade: [0.5, '#767676'],\r\n//         content: contentText\r\n//     });\r\n//\r\n//     // 调用接口\r\n//     $.ajax({\r\n//         // url: '/getAttendTable', // 实际项目中请取消注释下方URL并注释此行\r\n//         url: 'http://192.168.1.163:3000/gate/Ce/getZ',\r\n//         type: 'POST',\r\n//         async: true,\r\n//         contentType: \"application/json\",\r\n//         dataType: \"json\",\r\n//         data: JSON.stringify({\r\n//             ...send,\r\n//             startIndex: 1,\r\n//             endIndex: 999999,\r\n//             currentCall: 1,\r\n//             totalCall: 1\r\n//         }),\r\n//         success: function (result) {\r\n//             layer.close(loadingIndex);\r\n//             console.log(\"考勤明细数据:\", result);\r\n//\r\n//             if (result.code === 200 && result.data && result.data.length > 0) {\r\n//                 let tbodyHtml = '<tbody>';\r\n//\r\n//                 // 遍历每个员工数据\r\n//                 result.data.forEach((employee, empIndex) => {\r\n//                     // 员工基本信息行（跨列显示工号、姓名、部门、班次）\r\n//                     let infoTr = `\r\n//\r\n//\r\n//\r\n//\r\n//        <tr>\r\n//         <th rowspan=\"2\" colspan=\"13\" style=\"text-align: center; color: #366328; background-color: #cbfbfb;\r\n//         vertical-align: middle;\">${w_kaoqingmingxibiao}</th>\r\n//       </tr>\r\n//       <tr></tr>\r\n//\r\n//\r\n//     <tr style=\"background-color: #f5f5f5; font-weight: bold;\">\r\n//       <td style=\"\" colspan=\"3\">${w_gonghao}：${employee.userid}</td>\r\n//       <td style=\"\" colspan=\"10\"> ${w_xingming}：${employee.employeeName}</td>\r\n//     </tr>\r\n//\r\n//     <tr style=\"background-color: #f5f5f5; font-weight: bold;\">\r\n//       <td style=\"text-align: center;\" colspan=\"3\">${w_bumne}：${employee.department}</td>\r\n//       <td style=\"text-align: center;\" colspan=\"6\">${w_banchi}：${employee.shift}</td>\r\n//       <td style=\"text-align: center;\" colspan=\"4\">${w_riqi}：${employee.dateRange.start} - ${employee.dateRange.end}</td>\r\n//     </tr>\r\n//\r\n//\r\n//\r\n//\r\n//       <!-- 第三行：员工信息标题行（跨2行显示员工基本信息） -->\r\n//       <tr>\r\n//         <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #ca4440\">${w_riqi}</th>\r\n//         <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #ca4440\">${w_zhou}</th>\r\n//         <th colspan=\"2\" style=\"text-align: center; color: #ca4440\">${w_banduanyi}</th>\r\n//         <th colspan=\"2\" style=\"text-align: center; color: #ca4440\">${w_banduaner}</th>\r\n//         <th colspan=\"2\" style=\"text-align: center; color: #ca4440\">${w_banduansan}</th>\r\n//         <th colspan=\"2\" style=\"text-align: center; color: #ca4440\">${w_chuqinshiduan}</th>\r\n//         <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #ca4440\">${w_jiabanshishu}</th>\r\n//         <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #ca4440\">${w_chidaofenzhong}</th>\r\n//         <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #ca4440\">${w_zaotuifenzhong}</th>\r\n//       </tr>\r\n//       <!-- 第四行：班段细化表头 -->\r\n//       <tr>\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyishangban}</th>\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyixiaban}</th>\r\n//\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyishangban}</th>\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyixiaban}</th>\r\n//\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyishangban}</th>\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_banduanyixiaban}</th>\r\n//\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_chuqinshiduanbiaozhun}</th>\r\n//         <th style=\"text-align: center; color: #ca4440\">${w_chuqinshiduanshiji}</th>\r\n//\r\n//\r\n//       </tr>\r\n//\r\n//\r\n//           `;\r\n//                     tbodyHtml += infoTr;\r\n//\r\n//                     // 遍历员工每日考勤数据\r\n//                     employee.attendan.forEach((att, attIndex) => {\r\n//                         // 构建数据行：日期、星期、各时段考勤记录\r\n//                         // <td style=\"text-align: center;\">${att.shift_t1 || '-'}</td>\r\n//                         // <td style=\"text-align: center;\">${att.shift_t2 || '-'}</td>\r\n//                         // <td style=\"text-align: center;\">${att.shift_t3 || '-'}</td>\r\n//                         // <td style=\"text-align: center;\">${att.shift_t4 || '-'}</td>\r\n//                         // <td style=\"text-align: center;\">${att.shift_t5 || '-'}</td>\r\n//                         // <td style=\"text-align: center;\">${att.shift_t6 || '-'}</td>\r\n//                         let dataTr = `\r\n//               <tr>\r\n//                 <td style=\"text-align: center;\">${att.attDate || '-'}</td> <!-- 日期 -->\r\n//                 <td style=\"text-align: center;\">${att.attWeek || '-'}</td> <!-- 星期 -->\r\n//\r\n//\r\n//\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t1|| ''}</td>\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t2|| ''}</td>\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t3|| ''}</td>\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t4|| ''}</td>\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t5|| ''}</td>\r\n//                 <td style=\"text-align: center; mso-number-format:'@';\">&nbsp;${att.shift_t6|| ''}</td>\r\n//\r\n//\r\n//                 <td style=\"text-align: center;\">${att.attStandard || 0}</td> <!-- 出勤标准 -->\r\n//                 <td style=\"text-align: center;\">${att.attActual || 0}</td> <!-- 出勤实际 -->\r\n//                 <td style=\"text-align: center;\">${att.attOver || 0}</td> <!-- 加班时数 -->\r\n//                 <td style=\"text-align: center;\">${att.attLate || 0}</td> <!-- 迟到分钟 -->\r\n//                 <td style=\"text-align: center;\">${att.attEarly || 0}</td> <!-- 早退分钟 -->\r\n//\r\n//               </tr>\r\n//             `;\r\n//                         tbodyHtml += dataTr;\r\n//                     });\r\n//\r\n//                     // 员工数据分隔行（空行）\r\n//                     tbodyHtml += '<tr height=\"20\"></tr>';\r\n//                 });\r\n//\r\n//                 tbodyHtml += '</tbody>';\r\n//\r\n//                 // 拼接完整表格\r\n//                 let tableHtml = `\r\n//           <table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 100%; border-collapse: collapse;\">\r\n//             ${theadHtml}\r\n//             ${tbodyHtml}\r\n//           </table>\r\n//         `;\r\n//\r\n//                 // 调用导出（复用 tableToNotIE 方法）\r\n//                 tableToNotIE(tableHtml, w_kaoqingmingxibiao);\r\n//                 layer.msg(window.lang.w_kaoqinmingxibiaodaochuichenggong, { icon: 1, time: 1500 });\r\n//             } else {\r\n//                 layer.msg(window.lang.w_kaoqinmingxibiaodaochuiwushuju, { icon: 2, time: 1500 });\r\n//             }\r\n//         },\r\n//         error: function () {\r\n//             layer.close(loadingIndex);\r\n//             layer.msg(window.lang.w_kaoqinmingxibiaodaochushibai, { icon: 5, time: 1500 });\r\n//         }\r\n//     });\r\n// }\r\n\r\n\r\n\r\n\r\n\r\nfunction exportNoteKaoqinmingxi() {\r\n    console.log(\"导出考勤明细表...\");\r\n\r\n    // 创建样式标签（加载提示样式）\r\n    const style = document.createElement('style');\r\n    style.type = 'text/css';\r\n    const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n    style.appendChild(document.createTextNode(cssText));\r\n    document.head.appendChild(style);\r\n\r\n    // 校验时间范围\r\n    if ($(\"#EpStartTime\").val() == \"\" || $(\"#EpStartTime\").val() == null) {\r\n        layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n    if ($(\"#EpEndTime\").val() == \"\" || $(\"#EpEndTime\").val() == null) {\r\n        layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n\r\n    // 接口请求参数\r\n    let send = {\r\n        password: $.cookie(\"pwd\"),\r\n        type: 0, // 导出考勤明细表标识\r\n        start_time: $(\"#EpStartTime\").val(),\r\n        end_time: $(\"#EpEndTime\").val(),\r\n        startTime: $(\"#EpStartTime\").val(),\r\n        endTime: $(\"#EpEndTime\").val()\r\n    };\r\n\r\n    // 表格标题本地化\r\n    let w_kaoqingmingxibiao = window.lang.k_kaoqinmingxibiao;\r\n    let w_riqi = window.lang.w_riqi;\r\n    let w_zhou = window.lang.w_zhou;\r\n    let w_banduanyishangban = window.lang.w_banduanyishangban;\r\n    let w_banduanyixiaban = window.lang.w_banduanyixiaban;\r\n    let w_chuqinshiduanbiaozhun = window.lang.w_chuqinshiduanbiaozhun;\r\n    let w_chuqinshiduanshiji = window.lang.w_chuqinshiduanshiji;\r\n    let w_chuqinshiduan = window.lang.t_chuqinshishu;\r\n    let w_jiabanshishu = window.lang.w_jiabanshishu;\r\n    let w_chidaofenzhong = window.lang.w_chidaofenzhong;\r\n    let w_zaotuifenzhong = window.lang.w_zaotuifenzhong;\r\n    let w_gonghao = window.lang.w_gonghao;\r\n    let w_xingming = window.lang.w_xingming;\r\n    let w_banchi = window.lang.w_banchi;\r\n    let w_bumne = window.lang.w_bumne;\r\n    let w_banduanyi = window.lang.w_banduanyi;\r\n    let w_banduaner = window.lang.w_banduaner;\r\n    let w_banduansan = window.lang.w_banduansan;\r\n\r\n    // 显示加载层\r\n    let contentText = window.lang.w_contentText;\r\n    let loadingIndex = layer.load(1, {\r\n        shade: [0.5, '#767676'],\r\n        content: contentText\r\n    });\r\n\r\n    // 处理所有属性的函数\r\n    const processValue = (value) => {\r\n        if (typeof value !== 'string') {\r\n            return {\r\n                displayValue: value || '',\r\n                style: 'background-color: #FFFF99;' // 默认黄色背景\r\n            };\r\n        }\r\n\r\n        let displayValue = value;\r\n        let style = '';\r\n\r\n        if (displayValue.includes('^')) {\r\n            style = 'background-color: #CCFFCC;'; // 浅绿色背景\r\n            displayValue = displayValue.replace('^', '');\r\n        } else if (displayValue.includes('&')) {\r\n            style = 'background-color: #FF3333;'; // 红色背景\r\n            displayValue = displayValue.replace('&', '');\r\n        } else if (displayValue.includes('*')) {\r\n            style = 'background-color: #FFFFCC;'; // 浅黄色背景\r\n            displayValue = displayValue.replace('*', '');\r\n        } else {\r\n            style = 'background-color: #FFFF99;'; // 默认黄色背景\r\n        }\r\n\r\n        return { displayValue, style };\r\n    };\r\n\r\n    // 过滤文本中的数字和符号（保留多语言文本）\r\n    const filterText = (text) => {\r\n        if (typeof text !== 'string') return '';\r\n        // 正则匹配：保留中文、英文、韩文等非数字和符号的字符\r\n        return text.replace(/[\\d\\s\\&\\*\\:\\.\\/\\\\\\-]+/g, '');\r\n    };\r\n\r\n    // 调用接口\r\n    $.ajax({\r\n        // url: 'http://192.168.1.163:3000/gate/Ce/getZ',\r\n        url: '/getAttendTable',\r\n        type: 'POST',\r\n        async: true,\r\n        contentType: \"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify({\r\n            ...send,\r\n            startIndex: 1,\r\n            endIndex: 999999,\r\n            currentCall: 1,\r\n            totalCall: 1\r\n        }),\r\n        success: function (result) {\r\n            layer.close(loadingIndex);\r\n            console.log(\"考勤明细数据:\", result);\r\n\r\n            if (result.code === 200 && result.data && result.data.length > 0) {\r\n                let tbodyHtml = '<tbody>';\r\n\r\n                // 遍历每个员工数据\r\n                result.data.forEach((employee, empIndex) => {\r\n                    // 员工基本信息行\r\n                    let infoTr = `\r\n       <tr>\r\n        <th rowspan=\"2\" colspan=\"13\" style=\"text-align: center; color: #366328; \r\n        background-color: #cbfbfb; vertical-align: middle;\">${w_kaoqingmingxibiao}</th>\r\n      </tr>\r\n      <tr></tr>\r\n\r\n      <tr style=\"background-color: #ffffff; color: #9a3502; font-weight: bold;\">\r\n        <td style=\"\" colspan=\"3\">${w_gonghao}：${employee.userid}</td>\r\n        <td style=\"\" colspan=\"10\"> ${w_xingming}：${employee.employeeName}</td>\r\n      </tr>    \r\n      <tr style=\"background-color: #FFFFFFFF; color: #9a3502; font-weight: bold;\">\r\n        <td style=\"text-align: center;\" colspan=\"3\">${w_bumne}：${employee.department}</td>\r\n        <td style=\"text-align: center;\" colspan=\"6\">${w_banchi}：${employee.shift}</td>\r\n        <td style=\"text-align: center;\" colspan=\"4\">${w_riqi}：${employee.dateRange.start} - ${employee.dateRange.end}</td>\r\n      </tr>\r\n      <!-- 第三行：员工信息标题行 -->\r\n      <tr>\r\n        <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #9a3502; \">${w_riqi}</th>\r\n        <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #9a3502\">${w_zhou}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${w_banduanyi}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${w_banduaner}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${w_banduansan}</th>\r\n        <th colspan=\"2\" style=\"text-align: center; color: #9a3502\">${w_chuqinshiduan}</th>\r\n        <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #9a3502\">${w_jiabanshishu}</th>\r\n        <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #9a3502\">${w_chidaofenzhong}</th>\r\n        <th rowspan=\"2\" colspan=\"1\" style=\"text-align: center; color: #9a3502\">${w_zaotuifenzhong}</th>\r\n      </tr>\r\n      <!-- 第四行：班段细化表头 -->\r\n      <tr>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyishangban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyixiaban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyishangban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyixiaban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyishangban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_banduanyixiaban}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_chuqinshiduanbiaozhun}</th>\r\n        <th style=\"text-align: center; color: #9a3502\">${w_chuqinshiduanshiji}</th>\r\n      </tr>\r\n          `;\r\n                    tbodyHtml += infoTr;\r\n\r\n                    // 获取考勤数据长度\r\n                    const attendanCount = employee.attendan.length;\r\n\r\n                    // 遍历员工每日考勤数据，排除最后一条（总计数据）\r\n                    for (let i = 0; i < attendanCount - 1; i++) {\r\n                        const att = employee.attendan[i];\r\n\r\n                        // 处理所有att属性\r\n                        const processedAtt = {};\r\n                        Object.keys(att).forEach(key => {\r\n                            processedAtt[key] = processValue(att[key]);\r\n                        });\r\n\r\n                        // 1. 收集shift_t1到shift_t6的处理后数据\r\n                        const shiftCells = [\r\n                            { key: 'shift_t1', data: processedAtt.shift_t1 || { displayValue: '', style: '' } },\r\n                            { key: 'shift_t2', data: processedAtt.shift_t2 || { displayValue: '', style: '' } },\r\n                            { key: 'shift_t3', data: processedAtt.shift_t3 || { displayValue: '', style: '' } },\r\n                            { key: 'shift_t4', data: processedAtt.shift_t4 || { displayValue: '', style: '' } },\r\n                            { key: 'shift_t5', data: processedAtt.shift_t5 || { displayValue: '', style: '' } },\r\n                            { key: 'shift_t6', data: processedAtt.shift_t6 || { displayValue: '', style: '' } }\r\n                        ];\r\n\r\n                        // 2. 过滤文本并识别相邻相同组\r\n                        const filteredValues = shiftCells.map(cell => filterText(cell.data.displayValue));\r\n                        const mergeGroups = [];\r\n\r\n                        if (filteredValues.length > 0) {\r\n                            let currentGroup = {\r\n                                start: 0,\r\n                                end: 0,\r\n                                value: filteredValues[0],\r\n                                style: shiftCells[0].data.style\r\n                            };\r\n\r\n                            for (let j = 1; j < filteredValues.length; j++) {\r\n                                // 仅合并非空且相邻值相同的组\r\n                                if (filteredValues[j] === currentGroup.value && currentGroup.value !== '') {\r\n                                    currentGroup.end = j;\r\n                                } else {\r\n                                    mergeGroups.push(currentGroup);\r\n                                    currentGroup = {\r\n                                        start: j,\r\n                                        end: j,\r\n                                        value: filteredValues[j],\r\n                                        style: shiftCells[j].data.style\r\n                                    };\r\n                                }\r\n                            }\r\n                            mergeGroups.push(currentGroup); // 添加最后一组\r\n                        }\r\n\r\n                        // 3. 构建数据行（日期和星期列）\r\n                        let dataTr = '<tr>';\r\n                        dataTr += `\r\n                            <td style=\"text-align: center; ${processedAtt.attDate?.style || ''}; mso-number-format:'@'\">${processedAtt.attDate?.displayValue || '-'}</td>\r\n                            <td style=\"text-align: center; ${processedAtt.attWeek?.style || ''}\">${processedAtt.attWeek?.displayValue || '-'}</td>\r\n                        `;\r\n\r\n                        // 4. 处理班段列（根据合并组动态生成）\r\n                        mergeGroups.forEach(group => {\r\n                            const length = group.end - group.start + 1;\r\n                            const firstCell = shiftCells[group.start];\r\n\r\n                            if (length > 1 && group.value !== '') {\r\n                                // 合并单元格（colspan=长度）\r\n                                dataTr += `\r\n                                    <td colspan=\"${length}\" style=\"text-align: center; mso-number-format:'@'; ${group.style}\">\r\n                                        &nbsp;${firstCell.data.displayValue || ''}\r\n                                    </td>\r\n                                `;\r\n                            } else {\r\n                                // 不合并，直接显示\r\n                                dataTr += `\r\n                                    <td style=\"text-align: center; mso-number-format:'@'; ${firstCell.data.style}\">\r\n                                        &nbsp;${firstCell.data.displayValue || ''}\r\n                                    </td>\r\n                                `;\r\n                            }\r\n                        });\r\n\r\n                        // 5. 后续列（标准、实际等）\r\n                        dataTr += `\r\n                            <td style=\"text-align: center; ${processedAtt.attStandard?.style || ''}\">${processedAtt.attStandard?.displayValue || 0}</td>\r\n                            <td style=\"text-align: center; ${processedAtt.attActual?.style || ''}\">${processedAtt.attActual?.displayValue || 0}</td>\r\n                            <td style=\"text-align: center; ${processedAtt.attOver?.style || ''}\">${processedAtt.attOver?.displayValue || 0}</td>\r\n                            <td style=\"text-align: center; ${processedAtt.attLate?.style || ''}\">${processedAtt.attLate?.displayValue || 0}</td>\r\n                            <td style=\"text-align: center; ${processedAtt.attEarly?.style || ''}\">${processedAtt.attEarly?.displayValue || 0}</td>\r\n                        </tr>`;\r\n\r\n                        tbodyHtml += dataTr;\r\n                    }\r\n\r\n                    // 使用最后一条数据作为总计行数据\r\n                    const totalAtt = employee.attendan[attendanCount - 1] || {};\r\n                    const processedTotal = {};\r\n                    Object.keys(totalAtt).forEach(key => {\r\n                        processedTotal[key] = processValue(totalAtt[key]);\r\n                    });\r\n\r\n                    // 添加总计行，从日期到shift_t6合并单元格\r\n                    let totalTr = `\r\n              <tr >\r\n                <td colspan=\"8\" style=\"text-align: center; background-color: #FFFF99;\">${window.lang.b_zongji}</td>\r\n                <td style=\"text-align: center; background-color: #FFFF99;\">${processedTotal.attStandard?.displayValue || 0}</td>\r\n                <td style=\"text-align: center; background-color: #FFFF99;\">${processedTotal.attActual?.displayValue || 0}</td>\r\n                <td style=\"text-align: center; background-color: #FFFF99;\">${processedTotal.attOver?.displayValue || 0}</td>\r\n                <td style=\"text-align: center; background-color: #FFFF99;\">${processedTotal.attLate?.displayValue || 0}</td>\r\n                <td style=\"text-align: center; background-color: #FFFF99;\">${processedTotal.attEarly?.displayValue || 0}</td>\r\n              </tr>\r\n            `;\r\n                    tbodyHtml += totalTr;\r\n\r\n                    // 员工数据分隔行\r\n                    tbodyHtml += '<tr height=\"30\"></tr>';\r\n                });\r\n\r\n                tbodyHtml += '</tbody>';\r\n\r\n                // 拼接完整表格\r\n                let tableHtml = `\r\n          <table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 100%; border-collapse: collapse;\">\r\n            <thead></thead>\r\n            ${tbodyHtml}\r\n          </table>\r\n        `;\r\n\r\n                // 调用导出\r\n                tableToNotIE(tableHtml, w_kaoqingmingxibiao);\r\n                layer.msg(window.lang.w_kaoqinmingxibiaodaochuichenggong, { icon: 1, time: 1500 });\r\n            } else {\r\n                layer.msg(window.lang.w_kaoqinmingxibiaodaochuiwushuju, { icon: 2, time: 1500 });\r\n            }\r\n        },\r\n        error: function(error) {\r\n            layer.close(loadingIndex);\r\n            layer.msg(error, { icon: 5, time: 1000 });\r\n        }\r\n    });\r\n}\r\n\r\n\r\n"
          },
