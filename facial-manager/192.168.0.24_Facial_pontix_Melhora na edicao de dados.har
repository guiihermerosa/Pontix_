            "mimeType": "application/x-javascript",
            "text": "var num = 3, laydate, form;\r\n\r\nlet alg = new Object();\r\n// 初始化文件相关字段\r\nalg[\"featureFile\"] = \"\";\r\nalg[\"fingerFile\"] = \"\";\r\nalg[\"palm1File\"] = \"\";\r\nalg[\"palm2File\"] = \"\";\r\nalg[\"pic_large\"] = \"\"; // 人脸照片（处理后的base64）\r\n\r\nlayui.use(['form', 'layer', 'laydate'], function () {\r\n\t$ = layui.jquery;\r\n\tform = layui.form;\r\n\tlayer = layui.layer;\r\n\tlaydate = layui.laydate;\r\n\r\n\tcheck_permission();\r\n\tlang_load();\r\n\tgetEmplyeeInfo11();\r\n\r\n\t//日期时间选择器\r\n\tlaydate.render({\r\n\t\telem: '#pass_date',\r\n\t\ttype: 'datetime',\r\n\t\tformat: 'yyyy/MM/dd-HH:mm:ss',\r\n\t\ttrigger: 'click',\r\n\t\tlang: window.lang.lang,\r\n\t\trange: true\r\n\t});\r\n\r\n\tlay('.pass_time').each(function () {\r\n\t\tlaydate.render({\r\n\t\t\telem: this,\r\n\t\t\ttrigger: 'click',\r\n\t\t\ttype: 'time',\r\n\t\t\tlang: window.lang.lang,\r\n\t\t\trange: true\r\n\t\t});\r\n\t});\r\n\r\n\t$(\"#featureFileUpload\").click(function () { $(\"#featureFile\").click(); });\r\n\t$(\"#fingerFileUpload\").click(function () { $(\"#fingerFile\").click(); });\r\n\t$(\"#palm1FileUpload\").click(function () { $(\"#palm1File\").click(); });\r\n\t$(\"#palm2FileUpload\").click(function () { $(\"#palm2File\").click(); });\r\n\r\n\t// 点击文件名清空特征值\r\n\t$(\"#featureFileName\").click(function () {\r\n\t\tclearFeatureFile(\"featureFile\", \"featureFileName\", \"featureFileUpload\");\r\n\t});\r\n\t$(\"#fingerFileName\").click(function () {\r\n\t\tclearFeatureFile(\"fingerFile\", \"fingerFileName\", \"fingerFileUpload\");\r\n\t});\r\n\t$(\"#palm1FileName\").click(function () {\r\n\t\tclearFeatureFile(\"palm1File\", \"palm1FileName\", \"palm1FileUpload\");\r\n\t});\r\n\t$(\"#palm2FileName\").click(function () {\r\n\t\tclearFeatureFile(\"palm2File\", \"palm2FileName\", \"palm2FileUpload\");\r\n\t});\r\n\r\n\tlayui.form.render('select');\r\n\r\n\t// 定义pass_times的事件处理函数\r\n\tvar handlePassTimesChange = function (data) {\r\n\t\tif (data.value == \"0\") {\r\n\t\t\t$(\"#pass_times\").removeAttr(\"disabled\").removeClass('layui-disabled');\r\n\t\t}\r\n\t\telse {\r\n\t\t\t$(\"#pass_times\").attr(\"disabled\", true).addClass('layui-disabled').val(\"\");\r\n\t\t}\r\n\t};\r\n\r\n\tform.on('radio(pass_times)', handlePassTimesChange);\r\n\r\n\t$(document).ready(function () {\r\n\t\tsetTimeout(function () {\r\n\t\t\tvar initialPassTimesVal = $(\"input[name='pass_times']:checked\").val();\r\n\t\t\tif (!initialPassTimesVal) {\r\n\t\t\t\t$(\"input[name='pass_times'][value='1']\").prop(\"checked\", true);\r\n\t\t\t\tinitialPassTimesVal = '1';\r\n\t\t\t}\r\n\t\t\thandlePassTimesChange({ value: initialPassTimesVal });\r\n\t\t\tform.render('radio');\r\n\t\t}, 100);\r\n\t});\r\n\r\n\tform.on('radio(pass_date)', function (data) {\r\n\t\tif (data.value == \"0\") {\r\n\t\t\t$(\"#pass_date\").attr(\"disabled\", true).addClass('layui-disabled').val(\"\");\r\n\t\t}\r\n\t\telse {\r\n\t\t\t$(\"#pass_date\").removeAttr(\"disabled\").removeClass('layui-disabled');\r\n\t\t}\r\n\t});\r\n\r\n\t//自定义验证规则\r\n\tform.verify({\r\n\t\tuserid: function (value) {\r\n\t\t\tif (value == \"\") {\r\n\t\t\t\treturn window.lang.in_put_userid;\r\n\t\t\t}\r\n\t\t},\r\n\t\tphoto: function (value) {\r\n\t\t\tif (value == \"\") {\r\n\t\t\t\treturn window.lang.ic_pic_no_all_null;\r\n\t\t\t}\r\n\t\t},\r\n\t\tpass_times: function (value) {\r\n\t\t\tif (parseInt(value) == null) {\r\n\t\t\t\treturn window.lang.pass_times_null;\r\n\t\t\t}\r\n\t\t\tif (parseInt(value) < 0 || parseInt(value) > 65535) {\r\n\t\t\t\treturn window.lang.pass_times_wrong;\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\t//监听提交\r\n\tform.on('submit(add)', function (data) {\r\n\t\tvar layerMsg = layer.load(1, {\r\n\t\t\ticon: 0,\r\n\t\t\tshade: [0.5, 'black']\r\n\t\t});\r\n\r\n\t\talg[\"name\"] = $(\"#name\").val();\r\n\t\talg[\"id_number\"] = $(\"#id_number\").val();\r\n\t\talg[\"access_card_number\"] = $(\"#access_card_number\").val();\r\n\t\talg[\"userid\"] = $(\"#userid\").val();\r\n\t\talg[\"username\"] = $(\"#username\").val();\r\n\t\talg[\"userpassword\"] = $(\"#password\").val();\r\n\t\talg[\"department\"] = parseInt($(\"#department\").val());\r\n\t\talg[\"schedule\"] = parseInt($(\"#schedule\").val());\r\n\t\talg[\"role\"] = parseInt($(\"#role\").val());\r\n\t\talg[\"person_period\"] = parseInt($(\"#person_period\").val());\r\n\r\n\t\t// 通行次数处理\r\n\t\tconst passTimesVal = $(\"#pass_times\").val();\r\n\t\tconst passTimesRadioVal = $(\"input[name=pass_times]:checked\").val();\r\n\r\n\t\tif (passTimesRadioVal === \"0\") {\r\n\t\t\tif (!passTimesVal) {\r\n\t\t\t\tlayer.close(layerMsg);\r\n\t\t\t\tlayer.msg(window.lang.pass_times_null, { icon: 5 });\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\talg[\"pass_times\"] = parseInt(passTimesVal) || -1;\r\n\t\t} else {\r\n\t\t\talg[\"pass_times\"] = -1;\r\n\t\t}\r\n\r\n\t\t// 通行日期\r\n\t\tvar pass_date_num = $(\"input[name=pass_date]:checked\").val();\r\n\t\tif (pass_date_num != \"0\") {\r\n\t\t\tconst passTimeVal = $(\"#pass_date\").val().replace(/\\s*/g, \"\");\r\n\t\t\tif (!passTimeVal) {\r\n\t\t\t\tlayer.close(layerMsg);\r\n\t\t\t\tlayer.msg(window.lang.pass_time_null, { icon: 5 });\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\talg[\"pass_date\"] = passTimeVal;\r\n\t\t} else {\r\n\t\t\talg[\"pass_date\"] = \"0\";\r\n\t\t}\r\n\r\n\t\t// 通行时间\r\n\t\tvar pass_time_num = $(\"input[name=pass_time]:checked\").val();\r\n\t\tif (pass_time_num != \"0\") {\r\n\t\t\tvar keyArray = new Array();\r\n\t\t\tif (num == 1) {\r\n\t\t\t\tkeyArray.push($(\"#pass_time1\").val());\r\n\t\t\t} else if (num == 2) {\r\n\t\t\t\tkeyArray.push($(\"#pass_time1\").val());\r\n\t\t\t\tkeyArray.push($(\"#pass_time2\").val());\r\n\t\t\t} else {\r\n\t\t\t\tkeyArray.push($(\"#pass_time1\").val());\r\n\t\t\t\tkeyArray.push($(\"#pass_time2\").val());\r\n\t\t\t\tkeyArray.push($(\"#pass_time3\").val());\r\n\t\t\t}\r\n\t\t\talg[\"pass_time\"] = JSON.stringify(keyArray);\r\n\t\t} else {\r\n\t\t\talg[\"pass_time\"] = \"0\";\r\n\t\t}\r\n\r\n\t\tlet requestData = {\r\n\t\t\tdata: alg,\r\n\t\t\tpassword: $.cookie(\"pwd\")\r\n\t\t};\r\n\r\n\t\t$.ajax({\r\n\t\t\turl: '/insertEmployee',\r\n\t\t\ttype: 'post',\r\n\t\t\tasync: false,\r\n\t\t\tcontentType: \"application/json\",\r\n\t\t\tdataType: \"json\",\r\n\t\t\tdata: JSON.stringify(requestData),\r\n\t\t\tsuccess: function (result) {\r\n\t\t\t\tlayer.close(layerMsg);\r\n\t\t\t\tif (result.result === 200 || result.code === 1 || result.code === 200) {\r\n\t\t\t\t\tlayer.msg(window.lang.e_tianjiachengg, {\r\n\t\t\t\t\t\ticon: 1, time: 2000, end: function () {\r\n\t\t\t\t\t\t\tvar index = parent.layer.getFrameIndex(window.name);\r\n\t\t\t\t\t\t\twindow.parent.getData(index);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t} else {\r\n\t\t\t\t\tlet msg = window.lang.e_caozuoshibai;\r\n\t\t\t\t\tif (result.result === -1) msg = window.lang.e_z1;\r\n\t\t\t\t\tif (result.result === -2) msg = window.lang.e_z2;\r\n\t\t\t\t\tif (result.result === -3) msg = window.lang.e_z3;\r\n\t\t\t\t\tif (result.result === -4) msg = window.lang.e_z4;\r\n\t\t\t\t\tif (result.result === -5) msg = window.lang.e_z5;\r\n\t\t\t\t\tif (result.result === -6) msg = window.lang.e_z6;\r\n\t\t\t\t\tif (result.result === -7) msg = window.lang.e_z7;\r\n\t\t\t\t\tif (result.result === -8) msg = window.lang.e_z8;\r\n\t\t\t\t\tif (result.result === -9) msg = window.lang.e_z9;\r\n\t\t\t\t\tif (result.result === -10) msg = window.lang.e_z10;\r\n\t\t\t\t\tif (result.result === -11) msg = window.lang.e_z11;\r\n\t\t\t\t\tif (result.result === -12) msg = window.lang.e_z12;\r\n\r\n\r\n\r\n\t\t\t\t\tlayer.msg(msg, { icon: 5 });\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\terror: function (e) {\r\n\t\t\t\tlayer.close(layerMsg);\r\n\t\t\t\tlayer.msg(\"请求失败\", { icon: 7 });\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn false;\r\n\t});\r\n});\r\n\r\n// 点击上传区域\r\n$(\"#test10\").click(function () {\r\n\t$(\"#pic_large\").click();\r\n});\r\n\r\n// 点击图片清空/重新上传\r\nfunction file_click() {\r\n\tif ($(\"#pic_large\").val() || alg[\"pic_large\"]) {\r\n\t\t$(\"#pic_large\").val(\"\");\r\n\t\t$(\"#displayImg\").hide();\r\n\t\t$(\"#test10\").show();\r\n\t\talg[\"pic_large\"] = \"\";\r\n\t\tresetFeatureUpload();\r\n\t\treturn;\r\n\t}\r\n\t$(\"#pic_large\").click();\r\n}\r\n\r\n// ====================== 核心：人脸图片处理（裁剪+压缩+增强） ======================\r\nconst MAX_FILE_SIZE = 500 * 1024;\r\nconst MIN_SIZE = 300;\r\nconst MAX_SIZE = 1024;\r\n\r\nasync function reads(obj) {\r\n\tvar file = obj.files[0];\r\n\tif (!file) {\r\n\t\tresetFeatureUpload();\r\n\t\treturn;\r\n\t}\r\n\r\n\t// 大小校验\r\n\tif (file.size > 5 * 1024 * 1024) {\r\n\t\tlayer.msg(window.lang.pic_no_1m, { icon: 7 });\r\n\t\t$(obj).val(\"\");\r\n\t\treturn;\r\n\t}\r\n\r\n\ttry {\r\n\t\t// 调用合格化处理\r\n\t\tconst result = await processImage(file);\r\n\r\n\t\t// 显示处理后的图片\r\n\t\t$(\"#displayImg\").show();\r\n\t\t$(\"#displayImg\").attr(\"src\", result.processedUrl);\r\n\t\talg[\"pic_large\"] = result.processedUrl; // 保存处理后的base64\r\n\r\n\t\t$(obj).hide();\r\n\t\t$(\"#test10\").hide();\r\n\t\tdisableFeatureUpload();\r\n\r\n\t} catch (err) {\r\n\t\t$(obj).val(\"\");\r\n\t}\r\n}\r\n\r\n// 图片处理主函数（压缩、尺寸、增强）\r\nasync function processImage(file) {\r\n\treturn new Promise((resolve, reject) => {\r\n\t\tconst reader = new FileReader();\r\n\t\treader.onload = async (e) => {\r\n\t\t\ttry {\r\n\t\t\t\tconst img = new Image();\r\n\t\t\t\timg.onload = () => {\r\n\t\t\t\t\tconst canvas = document.createElement('canvas');\r\n\t\t\t\t\tconst ctx = canvas.getContext('2d');\r\n\r\n\t\t\t\t\tlet width = img.width;\r\n\t\t\t\t\tlet height = img.height;\r\n\t\t\t\t\tconst originalSize = file.size;\r\n\r\n\t\t\t\t\t// 等比例缩放\r\n\t\t\t\t\tlet resized = false;\r\n\t\t\t\t\tif (width < MIN_SIZE || height < MIN_SIZE || width > MAX_SIZE || height > MAX_SIZE) {\r\n\t\t\t\t\t\tresized = true;\r\n\t\t\t\t\t\tlet scale = 1;\r\n\t\t\t\t\t\tconst minSide = Math.min(width, height);\r\n\t\t\t\t\t\tconst maxSide = Math.max(width, height);\r\n\r\n\t\t\t\t\t\tif (minSide < MIN_SIZE) scale = MIN_SIZE / minSide;\r\n\t\t\t\t\t\telse if (maxSide > MAX_SIZE) scale = MAX_SIZE / maxSide;\r\n\r\n\t\t\t\t\t\twidth = Math.round(width * scale);\r\n\t\t\t\t\t\theight = Math.round(height * scale);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tcanvas.width = width;\r\n\t\t\t\t\tcanvas.height = height;\r\n\r\n\t\t\t\t\t// 画质增强\r\n\t\t\t\t\tctx.filter = 'contrast(1.08) brightness(1.03) saturate(1.05)';\r\n\t\t\t\t\tctx.drawImage(img, 0, 0, width, height);\r\n\t\t\t\t\tctx.filter = 'none';\r\n\r\n\t\t\t\t\t// 智能降噪+锐化\r\n\t\t\t\t\tapplySmartEnhancement(ctx, width, height);\r\n\r\n\t\t\t\t\t// 压缩到500KB内\r\n\t\t\t\t\tlet quality = 0.9;\r\n\t\t\t\t\tlet dataUrl = canvas.toDataURL('image/jpeg', quality);\r\n\r\n\t\t\t\t\twhile (dataUrl.length > MAX_FILE_SIZE && quality > 0.2) {\r\n\t\t\t\t\t\tquality -= 0.05;\r\n\t\t\t\t\t\tdataUrl = canvas.toDataURL('image/jpeg', quality);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tresolve({\r\n\t\t\t\t\t\tprocessedUrl: dataUrl,\r\n\t\t\t\t\t\toriginalSize: file.size,\r\n\t\t\t\t\t\tprocessedSize: dataUrl.length\r\n\t\t\t\t\t});\r\n\t\t\t\t};\r\n\t\t\t\timg.onerror = () => reject(new Error(\"图片加载失败\"));\r\n\t\t\t\timg.src = e.target.result;\r\n\t\t\t} catch (e) {\r\n\t\t\t\treject(e);\r\n\t\t\t}\r\n\t\t};\r\n\t\treader.readAsDataURL(file);\r\n\t});\r\n}\r\n\r\n// 智能降噪与锐化（避免边缘白边）\r\nfunction applySmartEnhancement(ctx, width, height) {\r\n\tconst imageData = ctx.getImageData(0, 0, width, height);\r\n\tconst data = imageData.data;\r\n\tconst copy = new Uint8ClampedArray(data);\r\n\tconst temp = new Uint8ClampedArray(data);\r\n\tconst radius = 1;\r\n\r\n\t// 中值降噪\r\n\tfor (let y = radius; y < height - radius; y++) {\r\n\t\tfor (let x = radius; x < width - radius; x++) {\r\n\t\t\tfor (let c = 0; c < 3; c++) {\r\n\t\t\t\tconst values = [];\r\n\t\t\t\tfor (let ky = -radius; ky <= radius; ky++) {\r\n\t\t\t\t\tfor (let kx = -radius; kx <= radius; kx++) {\r\n\t\t\t\t\t\tconst idx = ((y + ky) * width + (x + kx)) * 4 + c;\r\n\t\t\t\t\t\tvalues.push(copy[idx]);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tvalues.sort((a, b) => a - b);\r\n\t\t\t\ttemp[(y * width + x) * 4 + c] = values[Math.floor(values.length / 2)];\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// 轻微锐化（非边缘区域）\r\n\tconst strength = 0.25;\r\n\tconst threshold = 15;\r\n\tfor (let y = 1; y < height - 1; y++) {\r\n\t\tfor (let x = 1; x < width - 1; x++) {\r\n\t\t\tfor (let c = 0; c < 3; c++) {\r\n\t\t\t\tconst idx = (y * width + x) * 4 + c;\r\n\t\t\t\tconst center = temp[idx];\r\n\t\t\t\tconst neighbors = [\r\n\t\t\t\t\ttemp[((y - 1) * width + x) * 4 + c],\r\n\t\t\t\t\ttemp[((y + 1) * width + x) * 4 + c],\r\n\t\t\t\t\ttemp[(y * width + (x - 1)) * 4 + c],\r\n\t\t\t\t\ttemp[(y * width + (x + 1)) * 4 + c]\r\n\t\t\t\t];\r\n\t\t\t\tconst contrast = Math.max(...neighbors) - Math.min(...neighbors);\r\n\t\t\t\tif (contrast < threshold) {\r\n\t\t\t\t\tconst blurred = (neighbors[0] + neighbors[1] + neighbors[2] + neighbors[3]) / 4;\r\n\t\t\t\t\tdata[idx] = Math.min(255, Math.max(0, center + (center - blurred) * strength));\r\n\t\t\t\t} else {\r\n\t\t\t\t\tdata[idx] = center;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tctx.putImageData(imageData, 0, 0);\r\n}\r\n\r\n// ====================== 原有工具函数 ======================\r\nfunction cancle() {\r\n\tresetImageUpload();\r\n\tresetFeatureUpload();\r\n\tvar index = parent.layer.getFrameIndex(window.name);\r\n\tparent.layer.close(index);\r\n}\r\n\r\nfunction add_special_time() {\r\n\tif (num >= 3) {\r\n\t\t$(\"#more-add\").attr(\"disabled\", true).addClass(\"layui-disabled\");\r\n\t} else {\r\n\t\tvar html = `<div class=\"layui-form-item work_table work_add_view\">\r\n            <label class=\"layui-form-label\"></label>\r\n            <div class=\"layui-inline\">\r\n                <input type=\"text\" value=\"${num}\" class=\"layui-input\" style=\"width:40px\" readonly>\r\n                <input type=\"text\" class=\"layui-input pass_time\" id=\"pass_time${num}\">\r\n                <button onclick=\"remove_rest_time(this)\" class=\"more-rest less-rest\">-</button>\r\n            </div>\r\n        </div>`;\r\n\t\t$(\"#rest-con-box\").append(html);\r\n\t\tlay('.pass_time').each(function () {\r\n\t\t\tlaydate.render({ elem: this, type: 'time', range: true });\r\n\t\t});\r\n\t\tnum++;\r\n\t}\r\n\tlang_load();\r\n}\r\n\r\nfunction remove_rest_time(e) {\r\n\tnum--;\r\n\t$(e).parent().parent().remove();\r\n\t$(\"#more-add\").removeAttr(\"disabled\").removeClass(\"layui-disabled\");\r\n}\r\n\r\nfunction getEmplyeeInfo11() {\r\n\tform.render('select');\r\n\tform.render(null, 'form_info');\r\n\tlang_load();\r\n}\r\n\r\n// 特征文件上传\r\nfunction readFeatureFile(obj, fileNameId) {\r\n\tvar fileface = obj.files[0];\r\n\tif (!fileface) return;\r\n\tvar suffix = fileface.name.split('.').pop().toLowerCase();\r\n\tif (suffix !== \"dat\") {\r\n\t\tlayer.msg(window.lang.datFileError, { icon: 7 });\r\n\t\t$(obj).val(\"\");\r\n\t\treturn;\r\n\t}\r\n\t$(\"#\" + fileNameId).show().text(window.lang.d_yixuanz + fileface.name);\r\n\t$(obj).prev().hide();\r\n\r\n\tif (fileNameId === \"featureFileName\") disableImageUpload();\r\n\r\n\tvar reader = new FileReader();\r\n\treader.readAsDataURL(fileface);\r\n\treader.onload = e => {\r\n\t\tlet base64 = e.target.result.split(',')[1];\r\n\t\tswitch (fileNameId) {\r\n\t\t\tcase \"featureFileName\": alg[\"featureFile\"] = base64; break;\r\n\t\t\tcase \"fingerFileName\": alg[\"fingerFile\"] = base64; break;\r\n\t\t\tcase \"palm1FileName\": alg[\"palm1File\"] = base64; break;\r\n\t\t\tcase \"palm2FileName\": alg[\"palm2File\"] = base64; break;\r\n\t\t}\r\n\t};\r\n}\r\n\r\n// 互斥控制\r\nfunction disableFeatureUpload() {\r\n\t$(\"#featureFileUpload\").addClass(\"upload-disabled\");\r\n\t$(\"#featureFile\").attr(\"disabled\", true);\r\n}\r\nfunction resetFeatureUpload() {\r\n\t$(\"#featureFileUpload\").removeClass(\"upload-disabled\");\r\n\t$(\"#featureFile\").removeAttr(\"disabled\");\r\n}\r\nfunction disableImageUpload() {\r\n\t$(\"#test10\").addClass(\"upload-disabled\");\r\n\t$(\"#pic_large\").attr(\"disabled\", true);\r\n\t$(\"#displayImg\").hide();\r\n}\r\nfunction resetImageUpload() {\r\n\t$(\"#test10\").removeClass(\"upload-disabled\");\r\n\t$(\"#pic_large\").removeAttr(\"disabled\");\r\n}\r\n\r\n// 清空特征文件\r\nfunction clearFeatureFile(algKey, fileNameId, uploadBtnId) {\r\n\talg[algKey] = \"\";\r\n\t$(\"#\" + algKey).val(\"\");\r\n\t$(\"#\" + fileNameId).hide().text(\"\");\r\n\t$(\"#\" + uploadBtnId).show();\r\n\tif (algKey === \"featureFile\") resetImageUpload();\r\n}"
