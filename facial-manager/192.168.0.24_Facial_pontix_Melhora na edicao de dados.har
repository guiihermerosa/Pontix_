          "content": {
            "size": 23341,
            "mimeType": "application/x-javascript",
            "compression": 0,
            "text": "/**\r\n * Created by Administrator on 2016/8/4.\r\n */\r\n var layindex;\r\n function Personload() {\r\n    check_permission();\r\n    $('#table').bootstrapTable({\r\n        method: \"get\",\r\n        striped: true,\r\n        singleSelect: false,\r\n        dataType: \"json\",\r\n        pagination: false, //分页\r\n        pageSize: 10,\r\n        pageNumber: 1,\r\n        search: false, //显示搜索框\r\n        contentType: \"application/x-www-form-urlencoded\",\r\n        queryParams: null,\r\n        columns: [\r\n\r\n            {\r\n                title: '编号',\r\n                field: 'userid',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n            {\r\n                title: '姓名',\r\n                field: 'name',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n            {\r\n                title: '通行时间',\r\n                field: 'checkin_time',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n\r\n            // {\r\n            //     title: '开门方式',\r\n            //     field: 'passway',\r\n            //     align: 'center',\r\n            //     valign: 'middle'\r\n            // },\r\n\r\n            {\r\n                title: '通行类型',\r\n                field: 'passway',\r\n                align: 'center',\r\n                valign: 'middle',\r\n                formatter: function (value, row) {\r\n                    var e;\r\n                    if(row.passway == 0){\r\n                        e = '<span class=\"lang\" key=\"n_0\">刷脸</span>';\r\n                    }else if(row.passway == 1){\r\n                        e = '<span class=\"lang\" key=\"n_1\">刷卡</span>';\r\n                    }else if(row.passway == 2){\r\n                        e = '<span class=\"lang\" key=\"n_2\">二维码</span>';\r\n                    } else if(row.passway == 3){\r\n                        e = '<span class=\"lang\" key=\"n_3\">密码</span>';\r\n                    }else if(row.passway == 4){\r\n                        e = '<span class=\"lang\" key=\"n_4\">人证核验</span>';\r\n                    } else if(row.passway == 5){\r\n                        e = '<span class=\"lang\" key=\"n_5\">健康码</span>';\r\n                    }else if(row.passway == 6){\r\n                        e = '<span class=\"lang\" key=\"n_6\">按钮/远程开门</span>';\r\n                    }else if(row.passway == 7){\r\n                        e = '<span class=\"lang\" key=\"n_7\">指纹</span>';\r\n                    }else if(row.passway == 8){\r\n                        e = '<span class=\"lang\" key=\"n_8\">掌静脉</span>';\r\n                    }\r\n                    else if(row.passway == 10){\r\n                        e = '<span class=\"lang\" key=\"n_10\">人脸+刷卡</span>';\r\n                    }\r\n\r\n                    else if(row.passway == 11){\r\n                        e = '<span class=\"lang\" key=\"n_11\">人脸+密码</span>';\r\n                    }else if(row.passway == 12){\r\n                        e = '<span class=\"lang\" key=\"n_12\">人脸+卡/密码</span>';\r\n                    }else if(row.passway == 13){\r\n                        e = '<span class=\"lang\" key=\"n_13\">人脸+指纹</span>';\r\n                    }else if(row.passway == 14){\r\n                        e = '<span class=\"lang\" key=\"n_14\">人脸+手掌</span>';\r\n                    }else if(row.passway == 15){\r\n                        e = '<span class=\"lang\" key=\"n_15\">卡+手掌</span>';\r\n                    }else if(row.passway == 16){\r\n                        e = '<span class=\"lang\" key=\"n_16\">卡+密码</span>';\r\n                    }else if(row.passway == 17){\r\n                        e = '<span class=\"lang\" key=\"n_17\">卡+指纹</span>';\r\n                    }else if(row.passway == 18){\r\n                        e = '<span class=\"lang\" key=\"n_18\">手掌+密码</span>';\r\n                    }else if(row.passway == 19){\r\n                        e = '<span class=\"lang\" key=\"n_19\">手掌+指纹</span>';\r\n                    }else if(row.passway == 20){\r\n                        e = '<span class=\"lang\" key=\"n_20\">指纹+密码</span>';\r\n                    }\r\n\r\n\r\n\r\n\r\n\r\n                    else{\r\n                        e = '<span class=\"lang\" key=\"unknown\">未知</span>';\r\n                    }\r\n                    return e;\r\n                }\r\n            },\r\n\r\n            {\r\n                title: '卡号',\r\n                field: 'cardnum',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n\r\n\r\n\r\n\r\n            {\r\n                title: '相似度',\r\n                field: 'score',\r\n                align: 'center',\r\n                valign: 'middle'\r\n            },\r\n\r\n\r\n            {\r\n                title: '是否通过',\r\n                field: 'ispass',\r\n                align: 'center',\r\n                valign: 'middle',\r\n                formatter: function (value, row) {\r\n                    if(row.ispass == 1){\r\n                        return '<span style=\"color: #42b8f1\" class=\"lang\" key=\"yes\" >是</span>';\r\n                    }\r\n                    else{\r\n                        return '<span style=\"color: red\" class=\"lang\" key=\"no\" >是</span>';\r\n                    }\r\n                }\r\n\r\n            },\r\n\r\n\r\n\r\n            // {\r\n            //     title: '温度',\r\n            //     field: 'temp',\r\n            //     align: 'center',\r\n            //     valign: 'middle'//,\r\n            //     // formatter: function (value, row) {\r\n            //     //     return new Number(row.temp).toFixed(1);\r\n            //     // }\r\n            //\r\n            // },\r\n            // {\r\n            //     title: '照片',\r\n            //     field: 'pic_large',\r\n            //     align: 'center',\r\n            //     valign: 'middle',\r\n            //     formatter: function (value, row) {\r\n            //        var e = \"\";\r\n            //         if(row.pic_large != null && row.pic_large !=\"\" && row.pic_large != \"undefined\" ){\r\n            //            e = '<img src=\"data:image/jpg;base64,'+ row.pic_large+'\" onclick=\"openImg(\\'' + row.pic_large + '\\')\" alt=\"\" style=\"width:50px;height:70px\">';\r\n            //         }else{\r\n            //            e = '<img src=\"../images/photo.jpg\" alt=\"\" style=\"width:50px;height:70px\">';\r\n            //         }\r\n            //         return e;\r\n            //\r\n            //     }\r\n            // },\r\n\r\n        //    {\r\n        //        title: '操作',\r\n        //        field: 'operation',\r\n        //        align: 'center',\r\n        //        valign: 'middle',\r\n        //        formatter: function (value, row) {\r\n        //            var e = '<a class=\"layui-btn layui-btn-sm layui-btn-normal lang\" key=\"edit\" onclick=\"editEmployee(\\'' + row.userid + '\\')\" href=\"javascript:;\">编辑 </a>';\r\n        //            var d = '<a class=\"layui-btn layui-btn-sm layui-btn-danger lang\" key=\"delete\" onclick=\"delEmployee(\\'' + row.userid + '\\')\" href=\"javascript:;\">删除</a>';\r\n        //            return e + d;\r\n\r\n        //        }\r\n        //     }\r\n        ]\r\n    });\r\n    lang_load();\r\n    getData();\r\n}\r\nfunction getData(index) {\r\n    layer.close(index);\r\n   let send = new Object()\r\n   send[\"password\"] = $.cookie(\"pwd\")\r\n   send[\"type\"] = 2\r\n   $.ajax({\r\n       url:  '/getWorkNoteList',\r\n       type: 'POST',\r\n       async: false,\r\n       contentType:\"application/json\",\r\n       dataType: \"json\",\r\n       data: JSON.stringify(send),\r\n       success: function(result){\r\n           // console.log(\"result: \"+result);\r\n           // console.log(\"index: \"+result.index);\r\n           // console.log(\"count: \"+result.count);\r\n           // console.log(\"page_sum: \"+result.page_sum);\r\n           if(result.code == 200){\r\n               // $(\"#page_num\").text(result.index); //当前页\r\n               // $(\"#page_size\").text(result.count); //没有多少条\r\n               // $(\"#page_sum\").text(result.page_sum); //总页数\r\n               // $(\".page a\").removeClass(\"current\"); //total=》总数\r\n               // $(\".first\").addClass(\"current\");\r\n               $('#table').bootstrapTable(\"load\", result.data);\r\n               layui.use('laypage', function(){\r\n                   var laypage = layui.laypage;\r\n                   laypage.render({\r\n                       elem: 'page' //注意，这里的 page 是 ID，不用加 # 号\r\n                       ,//数据总数，从服务端得到\r\n                       count: result.total,\r\n                       limits:[10,20,30,40,50],\r\n                       first: false,\r\n                       last: false,\r\n                       prev:\"<<\",\r\n                       next:\">>\",\r\n                       theme:\"#0099ff\", //['count', 'prev', 'page', 'next', 'limit', 'skip'],\r\n                       layout: [ 'prev', 'page', 'next'],\r\n                       limit: result.count,\r\n                       curr: result.index,\r\n                       jump:function(data, first){\r\n                           var page=data.curr;\r\n                           console.log(\"page: \",page);\r\n                           $(\"#currPage\").val(page);\r\n                           var limt=data.limit;\r\n                           console.log(\"limt: \",limt);\r\n                           $(\"#limit\").val(limt);\r\n                           if(!first){ //点击右下角分页时调用\r\n                            searchNote(page,limt);\r\n                               console.log(\"分页\");\r\n                           }\r\n                       }\r\n                   });\r\n               })\r\n               lang_load();\r\n           }else{\r\n               layer.msg(result.message,{icon: 5,time:1000});\r\n           }\r\n       },\r\n       error: function(error){\r\n           layer.msg(error,{icon: 5,time:1000});\r\n       },\r\n\r\n   })\r\n\r\n\r\n}\r\n\r\n\r\n//条件查询\r\nfunction searchNote(page,limt){\r\n    console.log('asdfsdf')\r\n\r\n    let alg = new Object();\r\n    alg[\"password\"] = $.cookie(\"pwd\");\r\n    alg[\"type\"] = 2\r\n    if($(\"#startTime\").val() == \"\" && $(\"#endTime\").val() == \"\"){\r\n        alg[\"start_time\"] = null;\r\n        alg[\"end_time\"] = null;\r\n    }else{\r\n        if($(\"#startTime\").val() != \"\" && $(\"#endTime\").val() != \"\"){\r\n            alg[\"start_time\"] = $(\"#startTime\").val();\r\n            alg[\"end_time\"] = $(\"#endTime\").val();\r\n        }else{\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n    alg[\"userid\"] = $(\"#userid\").val();\r\n\r\n    alg[\"index\"] = page;\r\n    alg[\"count\"] = limt;\r\n\r\n    $.ajax({\r\n        url:  '/getWorkNoteList',\r\n        type: 'POST',\r\n        async: false,\r\n        contentType:\"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(alg),\r\n        success: function(result){\r\n            if(result.code == 200){\r\n                $('#table').bootstrapTable(\"load\", result.data);\r\n\r\n                // 重新渲染分页组件，传入正确的总记录数和当前页码\r\n                layui.use('laypage', function(){\r\n                    var laypage = layui.laypage;\r\n                    laypage.render({\r\n                        elem: 'page',\r\n                        count: result.total,\r\n                        limits: [10,20,30,40,50],\r\n                        first: false,\r\n                        last: false,\r\n                        prev: \"<<\",\r\n                        next: \">>\",\r\n                        theme: \"#0099ff\",\r\n                        layout: ['prev', 'page', 'next'],\r\n                        limit: limt,\r\n                        curr: page,\r\n                        jump: function(data, first){\r\n                            var page = data.curr;\r\n                            console.log(\"page: \", page);\r\n                            $(\"#currPage\").val(page);\r\n                            var limt = data.limit;\r\n                            console.log(\"limt: \", limt);\r\n                            $(\"#limit\").val(limt);\r\n                            if(!first){ //点击右下角分页时调用\r\n                                searchNote(page, limt);\r\n                                console.log(\"分页\");\r\n                            }\r\n                        }\r\n                    });\r\n                });\r\n\r\n                lang_load();\r\n            }else{\r\n                layer.msg(result.message,{icon: 5,time:1000});\r\n            }\r\n        },\r\n        error: function(error){\r\n            layer.msg(error,{icon: 5,time:1000});\r\n        }\r\n    });\r\n}\r\n\r\n\r\n\r\n//时间戳转日期\r\nfunction timestampToTime(timestamp) {\r\n   var date = new Date(timestamp * 1000);//时间戳为10位需*1000，时间戳为13位的话不需乘1000\r\n//    var Y = date.getFullYear() + '-';\r\n//    var M = (date.getMonth()+1 < 10 ? '0'+(date.getMonth()+1) : date.getMonth()+1) + '-';\r\n//    var D = date.getDate() + ' ';\r\n   var h = date.getHours() + ':';\r\n   var m = date.getMinutes() + ':';\r\n   var s = date.getSeconds();\r\n   return h+m+s;//Y+M+D+;\r\n}\r\n\r\nfunction openImg(path) {\r\n   var index = layer.open({\r\n       type: 1,\r\n       title: window.lang.see_pic,\r\n       area: [\"60vh\",\"80vh\"],\r\n       fix: false, //不固定\r\n       maxmin: true,\r\n       shadeClose: false,\r\n       shade:0.4,\r\n       closeBtn: 1,\r\n       content:\r\n           '<div style=\"width:100%;height:100%\">\\n' +\r\n               '<img src=\"data:image/jpg;base64,'+path+'\" style=\"width:100%;height:100%\">\\n' +\r\n           '</div>'\r\n   });\r\n}\r\n\r\n//点击导出\r\nfunction tableToExcel(){\r\n    // $(\"#table\").table2excel({            //exceltable为存放数据的table\r\n    //     　　　　// 不被导出的表格行的CSS class类\r\n    //     　　　　exclude: \".noExl\",\r\n    //     exclude_img: false,\r\n    //     　　　　// 导出的Excel文档的名称\r\n    //     　　　　name: \"表格-\" + new Date().getTime(),\r\n    //     　　　　// Excel文件的名称\r\n    //      　　　　filename: \"表格-\" + new Date().getTime() + \".xls\",\r\n    //      　　　　bootstrap: false\r\n    //  　　    });\r\n   layindex = layer.open({\r\n        type: 1,\r\n        title: window.lang.expt_note,\r\n        area: [\"400px\",\"300px\"],\r\n        fix: false, //不固定\r\n        maxmin: true,\r\n        shadeClose: false,\r\n        shade:0.4,\r\n        closeBtn: 1,\r\n        content: $(\"#export_box\")\r\n\r\n    });\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nfunction exportNote() {\r\n            // 创建一个style标签用于添加自定义样式，设置contentText字体样式\r\n            const style = document.createElement('style');\r\n            style.type = 'text/css';\r\n            const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n            style.appendChild(document.createTextNode(cssText));\r\n            // 将style标签添加到文档头部（也可以添加到其他合适位置，比如body开头等）\r\n            document.head.appendChild(style);\r\n\r\n            if ($(\"#EpStartTime\").val() == \"\" || $(\"#EpStartTime\").val() == null) {\r\n                layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n                return false;\r\n            }\r\n            if ($(\"#EpEndTime\").val() == \"\" || $(\"#EpEndTime\").val() == null) {\r\n                layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n                return false;\r\n            }\r\n\r\n            let send = new Object();\r\n            send[\"password\"] = $.cookie(\"pwd\");\r\n            send[\"type\"] = 2;\r\n\r\n\r\n\t\t\t//send[\"startTime\"] = $(\"#EpStartTime\").val();\r\n            //send[\"endTime\"] = $(\"#EpEndTime\").val();\r\n \t\t\tif($(\"#EpStartTime\").val() == \"\" && $(\"#EpEndTime\").val() == \"\"){\r\n\t\t\t\tsend[\"start_time\"] = null;\r\n\t\t\t\tsend[\"end_time\"] = null;\r\n\t\t\t\tsend[\"startTime\"] = null;\r\n\t\t\t\tsend[\"endTime\"] = null;\r\n\t\t\t}else{\r\n\t\t\t\tif($(\"#EpStartTime\").val() != \"\" && $(\"#EpEndTime\").val() != \"\"){\r\n\t\t\t\t\tsend[\"start_time\"] = $(\"#EpStartTime\").val();\r\n\t\t\t\t\tsend[\"end_time\"] = $(\"#EpEndTime\").val();\r\n\t\t\t\t\tsend[\"startTime\"] = $(\"#EpStartTime\").val();\r\n\t\t\t\t\tsend[\"endTime\"] = $(\"#EpEndTime\").val();\r\n\t\t\t\t}else{\r\n\t\t\t\t\tlayer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\r\n            // 定义表头\r\n            // var tHeader = ['姓名', '通行时间', '温度', '是否通过', '照片'];\r\n            // var tHeader = ['编号','姓名', '通行时间', '通行方式', '卡号',  '相似度',  '是否通过'];\r\n            var tHeader = [window.lang.w_bianhao, window.lang.t_xingming, window.lang.w_dakashijian,\r\n                window.lang.w_tongxinleixing, window.lang.w_kjahao,  window.lang.w_xiangsidu,  window.lang.w_shifoutongxing];\r\n\r\n            // 先请求总数据条数\r\n            $.ajax({\r\n                url: '/getWorkNoteList',\r\n                type: 'POST',\r\n                contentType: \"application/json\",\r\n                dataType: \"json\",\r\n                data: JSON.stringify(send), // 以JSON格式传递参数\r\n                success: function (result) {\r\n                    if (result.code === 200) {\r\n                        const totalCount = result.total; // 数据总条数\r\n                        console.log('总条数:', totalCount);\r\n\t\t\t\t\t\tif (totalCount === 0) {\r\n\t\t\t\t\t\t\tlayer.msg(window.lang.y_meiyoushujudaochu, { icon: 1, time: 1000 });\r\n                            \r\n\t\t\t\t\t\t\treturn; // 直接返回，不执行后续操作\r\n\t\t\t\t\t\t}\r\n                        const pageSize = 100; // 每次请求最多100条\r\n                        const totalPages = Math.ceil(totalCount / pageSize); // 总请求次数\r\n                        console.log('总请求次数:', totalPages);\r\n\r\n                        let completedRequests = 0; // 记录请求完成次数\r\n                        let loadingIndex; // 用于记录加载层的索引\r\n\r\n                        // 递归函数来发送请求并延迟1秒\r\n                        function sendRequest(page) {\r\n                            // 显示加载提示框，提示正在导出文件操作等信息，数据竖着展示\r\n                            let contentText = window.lang.y_suoyouwenjianyijingdao + \"     \\n    \" + window.lang.y_zhengzaidaowendangshu + (completedRequests + 1);\r\n\r\n                            loadingIndex = layer.load(1, {\r\n                                shade: [0.5, '#767676'], // 遮罩层透明度及颜色\r\n                                content: contentText\r\n                            });\r\n                            console.log('开始递归');\r\n                            if (page > totalPages) {\r\n                                layer.close(loadingIndex); // 关闭加载层\r\n                                layer.msg(window.lang.y_suoyouwenjianyijingdao, { icon: 1, time: 1000 });\r\n                                \r\n                                layer.close(layindex);\r\n                                return;\r\n                            }\r\n\r\n                            let start = (page - 1) * pageSize + 1; // 每次请求的起始条数\r\n                            let end = page * pageSize; // 每次请求的结束条数\r\n                            if (end > totalCount) {\r\n                                end = totalCount; // 防止超过总条数\r\n                            }\r\n\r\n                            // 动态计算 currentCall 和 totalCall 参数\r\n                            let requestData = {\r\n                             ...send,\r\n                                startIndex: start,\r\n                                endIndex: end,\r\n                                currentCall: page,\r\n                                totalCall: totalPages\r\n                            };\r\n\r\n                            // 发送请求\r\n                            $.ajax({\r\n                                url: '/exportCheckinRecord',\r\n                                type: 'POST',\r\n                                async: true, // 异步请求\r\n                                contentType: \"application/json\",\r\n                                dataType: \"json\",\r\n                                data: JSON.stringify(requestData), // 传递的参数也以JSON格式\r\n                                success: function (result) {\r\n                                    let list = [];\r\n                                    for (let index = 0; index < result.data.length; index++) {\r\n                                        const element = result.data[index];\r\n                                        let obj = new Object();\r\n\r\n                                        obj[\"userid\"] = element.userid;\r\n                                        obj[\"name\"] = element.name;\r\n                                        obj[\"checkin_time\"] = element.checkin_time;\r\n                                        obj[\"passway\"] = element.passway;\r\n                                        // obj[\"temp\"] = element.temp;\r\n\r\n                                        obj[\"cardnum\"] = element.cardnum;\r\n\r\n\r\n                                        obj[\"score\"] = element.score;\r\n\r\n                                        // obj[\"pass\"] = element.ispass === 0? '否' : '是';\r\n                                        obj[\"ispass\"] = element.ispass;\r\n\r\n\r\n                                        // obj[\"pic\"] = \"data:image/jpg;base64,\" + element.pic_large;\r\n                                        list.push(obj);\r\n                                    }\r\n\r\n                                    console.log('正在导出excel文档', );\r\n                                    // 导出当前请求的数据\r\n                                    export2Excel3(tHeader, list, window.lang.employee_note + \"_part_\" + page + \"_of_\" + totalPages);\r\n\r\n                                    completedRequests++;\r\n                                    if (completedRequests === totalPages) {\r\n                                        layer.close(loadingIndex); // 关闭加载层\r\n                                        layer.msg(window.lang.y_suoyouwenjianyijingdao, { icon: 1, time: 1000 });\r\n                                        layer.close(layindex);\r\n                                    }\r\n\r\n                                    // 延迟1秒后递归调用，继续发送下一页请求\r\n                                    setTimeout(function () {\r\n                                        sendRequest(page + 1);\r\n                                    }, 1000); // 1秒延迟后发送请求\r\n                                },\r\n                                error: function () {\r\n                                    layer.close(loadingIndex); // 关闭加载层\r\n                                    layer.msg(window.lang.y_daochushibai, { icon: 1, time: 1000 });\r\n                                }\r\n                            });\r\n                        }\r\n\r\n                        // 开始从第1页请求数据\r\n                        sendRequest(1);\r\n                    } else {\r\n                        layer.msg(window.lang.y_huoqutiaoshujushibai, { icon: 1, time: 1000 });\r\n                        \r\n                    }\r\n                },\r\n                error: function () {\r\n                    layer.msg(window.lang.y_huoqushujushibai, { icon: 1, time: 1000 });\r\n                    \r\n                }\r\n            });\r\n        }\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n  //关闭导出\r\n  function cancleExpt(){\r\n      layer.close(layindex);\r\n  }"
          },
