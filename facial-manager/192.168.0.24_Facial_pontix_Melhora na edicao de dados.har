          "content": {
            "size": 19808,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html>\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title class=\"lang\" ></title>\r\n    <meta name=\"renderer\" content=\"webkit\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\r\n    <meta name=\"viewport\" content=\"width=device-width,user-scalable=yes, minimum-scale=0.4, initial-scale=0.8,target-densitydpi=low-dpi\" />\r\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\r\n    <link rel=\"stylesheet\" href=\"../css/font.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/xadmin.css\">\r\n    <script src=\"../js/jquery.min.js\"></script>\r\n    <script src=\"../js/jquery.cookie.js\"></script>\r\n    <script src=\"../js/bootstrap-table.js\"></script>\r\n    <script src=\"../js/bootstrap.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../lib/layui/layui.js\" charset=\"utf-8\"></script>\r\n    <script type=\"text/javascript\" src=\"../js/xadmin.js\"></script>\r\n    <script src=\"../lang/lang.js\"></script>\r\n    <script src=\"../js/notify.js\"></script>\r\n    <script src=\"../js/law.js\"></script>\r\n    <script src=\"../js/html5.min.js\"></script>\r\n    <script src=\"../js/respond.min.js\"></script>\r\n    <style>\r\n        .layui-form-radio {\r\n            line-height: 28px;\r\n            margin: 6px 0px 0 0;\r\n            /* padding-right: 10px; */\r\n            cursor: pointer;\r\n            font-size: 0;\r\n        }\r\n        .op_cl label {\r\n            vertical-align: middle;\r\n            padding-top: 3px;\r\n        }\r\n\r\n        .language_but{\r\n\r\n            float: left;\r\n        }\r\n        .layui-bg-gray {\r\n            margin-top: 30px;\r\n            margin-bottom: 30px;\r\n        }\r\n        .type_but{\r\n            float: left;\r\n            margin-right: 15px;\r\n            background: #d2d2d2;\r\n        }\r\n        .chooseType{\r\n            background: #1E9FFF!important;\r\n        }\r\n        .param_top{\r\n            width: 100%;\r\n            height: 55px;\r\n            padding-left: 10px;\r\n            border-bottom:1px solid #d2d2d2;\r\n            margin-bottom: 20px;\r\n        }\r\n        .param_box1{\r\n            width:100%;\r\n            height: 100%;\r\n            float:left;\r\n        }\r\n        .param_jkm,.param_face{\r\n            display: none;\r\n        }\r\n        .show_div .show_div_in {vertical-align:middle}\r\n        .layui-form-checkbox{\r\n            height: 20px;\r\n            line-height: 20px;\r\n        }\r\n        .layui-form-checkbox i{\r\n            width: 25px;\r\n        }\r\n        .layui-form-label{\r\n            width: 120px !important;\r\n        }\r\n\r\n\r\n        .holiday-table-container  {\r\n            display: block !important;\r\n            opacity: 1 !important;\r\n\r\n            width: 70%;\r\n            text-align: center;\r\n            line-height: 30px;\r\n            z-index: 100 !important;\r\n\r\n            /* 修改：左对齐容器 */\r\n            margin: 0 !important;\r\n            padding: 0 !important;\r\n        }\r\n        .calendar-toggle {\r\n            padding: 2px 5px;\r\n            font-size: 12px;\r\n            cursor: pointer;\r\n            border-radius: 3px;\r\n        }\r\n        .calendar-gregorian {\r\n            background-color: #1E9FFF;\r\n            color: white;\r\n        }\r\n        .calendar-lunar {\r\n            background-color: #FF5722;\r\n            color: white;\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body onload=\"load()\">\r\n<div class=\"x-body\">\r\n\r\n\r\n    <div class=\"x-nav\">\r\n      <span class=\"layui-breadcrumb\">\r\n      <a class=\"layui-btn layui-btn-primary layui-btn-small\" style=\"line-height:1.6em;margin-top:3px;float:right\" href=\"javascript:location.replace(location.href);\" title=\"刷新\">\r\n        <i class=\"layui-icon\" style=\"line-height:38px\">&#xe669;</i></a>\r\n      </span>\r\n    </div>\r\n\r\n    <form class=\"layui-form\" lay-filter=\"form_info\">\r\n\r\n\r\n        <div style=\"margin-top: 30px\"></div>\r\n\r\n\r\n\r\n        <div class=\"param_box1 param_sys\">\r\n            <div style=\"width: 45%;height: 100%;float: left;\">\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"living_threshold\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"record_warning\" class=\"lang\">考勤记录警告</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <input step=\"1\" min=\"1\" max=\"5000\"  placeholder=\"(1-5000)\"\r\n                               type=\"number\" id=\"record_warning\" name=\"record_warning\"\r\n                               lay-verify=\"record_warning\"\r\n                               autocomplete=\"off\" class=\"layui-input\">\r\n                    </div>\r\n                    <div class=\"layui-form-mid layui-word-aux\">\r\n                        <!--                        <span class=\"x-red\">*</span><span class=\"lang\" >1~7200</span>-->\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"living_threshold\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"allow_tardiness\" class=\"lang\">允许迟到时间</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <input  step=\"1\" min=\"0\" max=\"60\"  placeholder=\"0-60(min)\"\r\n                                type=\"number\"\r\n                                id=\"allow_tardiness\" name=\"allow_tardiness\" required lay-verify=\"allow_tardiness\"\r\n                                autocomplete=\"off\" class=\"layui-input\">\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"living_threshold\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"weekend\" class=\"lang\">周末</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"weekend\" name=\"weekend\" class=\"select_language lang\">\r\n                            <option value=\"0\" class=\"lang\" key=\"l_fou\">否</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"l_shaungxiu\">双休</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"l_zhourixiu\">周日休</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"l_zhoumobantian\">周末半天</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"l_zhouwuxiu\">周五休</option>\r\n\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n            </div>\r\n            <div style=\"width: 45%;height: 100%;float: left;\">\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"living_threshold\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"default_shift\" class=\"lang\">默认班次</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"default_shift\" name=\"default_shift\" class=\"select_language\">\r\n                            <option value=\"0\" class=\"lang\" key=\"l_fou\">否</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"shift1\">shift1</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"shift2\">shift2</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"shift3\">shift3</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"shift4\">shift4</option>\r\n                            <option value=\"5\" class=\"lang\" key=\"shift5\">shift5</option>\r\n                            <option value=\"6\" class=\"lang\" key=\"shift6\">shift6</option>\r\n                            <option value=\"7\" class=\"lang\" key=\"shift7\">shift7</option>\r\n                            <option value=\"8\" class=\"lang\" key=\"shift8\">shift8</option>\r\n\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"recg_space\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"allow_early\" class=\"lang\">允许早退时间</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <input step=\"1\" min=\"0\" max=\"60\"  placeholder=\"0-60(min)\"\r\n                               type=\"number\"\r\n                               id=\"allow_early\" name=\"allow_early\"\r\n                               lay-verify=\"allow_early\"\r\n                               autocomplete=\"off\" class=\"layui-input\">\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"living_threshold\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"no_sign\" class=\"lang\">免签到</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"no_sign\" name=\"no_sign\" class=\"select_language lang\">\r\n                            <option value=\"0\" class=\"lang\" key=\"l_fou\">否</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"l_zhiqianzaowan\">只签早、晚下班</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"l_zhiqianzaoshang\">只签早上班</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"l_zhiqianwanshang\">只签晚上班</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"l_zhiqianshangban\">只签上班</option>\r\n                            <option value=\"5\" class=\"lang\" key=\"l_zhiqianxiaban\">只签下班</option>\r\n\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n            </div>\r\n        </div>\r\n        <!--健康码-->\r\n        <div class=\"param_box1 param_jkm\">\r\n            <div style=\"width: 45%;height: 100%;float: left;\">\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span key=\"temp_out_test\" class=\"lang\">室外测温</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <input type=\"radio\" name=\"temp_out\" id=\"temp_out_k\" value=\"1\" >\r\n                        <label class=\"lang\" key=\"open\" style=\"display: inline-block;margin-right: 20px;\">开</label>\r\n                        <input type=\"radio\" name=\"temp_out\" id=\"temp_out_c\" value=\"0\" >\r\n                        <label class=\"lang\" key=\"close\" style=\"display: inline-block;\">关</label>\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span key=\"identity_test\" class=\"lang\">人证核验</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <input type=\"radio\" name=\"identity\" id=\"identity_k\" value=\"1\" >\r\n                        <label class=\"lang\" key=\"open\" style=\"display: inline-block;margin-right: 20px;\">开</label>\r\n                        <input type=\"radio\" name=\"identity\" id=\"identity_c\" value=\"0\" >\r\n                        <label class=\"lang\" key=\"close\" style=\"display: inline-block;\">关</label>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span key=\"healthCode\" class=\"lang\">健康码</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <input type=\"radio\" name=\"health_code\" id=\"health_code_k\" value=\"1\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"open\" style=\"display: inline-block;margin-right: 20px;\">开</label>\r\n                        <input type=\"radio\" name=\"health_code\" id=\"health_code_c\" value=\"0\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"close\" style=\"display: inline-block;\">关</label>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span key=\"whiteHealthTestCode\" class=\"lang\">白名单核验健康码</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <input type=\"radio\" name=\"wl_test_health_code\" id=\"wl_test_health_code_k\" value=\"1\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"open\" style=\"display: inline-block;margin-right: 20px;\">开</label>\r\n                        <input type=\"radio\" name=\"wl_test_health_code\" id=\"wl_test_health_code_c\" value=\"0\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"close\" style=\"display: inline-block;\">关</label>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span key=\"whiteHealthUpCode\" class=\"lang\">白名单上传健康码</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <input type=\"radio\" name=\"wl_up_health_code\" id=\"wl_up_health_code_k\" value=\"1\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"open\" style=\"display: inline-block;margin-right: 20px;\">开</label>\r\n                        <input type=\"radio\" name=\"wl_up_health_code\" id=\"wl_up_health_code_c\" value=\"0\" lay-filter=\"mask\">\r\n                        <label class=\"lang\" key=\"close\" style=\"display: inline-block;\">关</label>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n            </div>\r\n            <div style=\"width: 45%;height: 100%;float: left;\">\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask_type\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"showJkm\" class=\"lang\">显示效果</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline jkm_show\">\r\n                        <div class=\"show_div\">\r\n                            <input class=\"show_div_in\" type=\"checkbox\" name=\"nuclein_show\"  id=\"showJkmHs\">\r\n                            <label class=\"show_div_in lang\" key=\"nuclein_show\">显示核酸信息</label>\r\n                        </div>\r\n                        <div class=\"show_div\">\r\n                            <input class=\"show_div_in\" type=\"checkbox\" name=\"vaccine_show\"  id=\"showJkmYm\">\r\n                            <label class=\"show_div_in lang\" key=\"vaccine_show\">显示疫苗信息</label>\r\n                        </div>\r\n\r\n                        <!-- <select id=\"mask_type\" name=\"mask_type\">\r\n                            <option value=\"0\" class=\"lang\" key=\"no_mask_no_temp\">显示核酸信息</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"no_mask_no_open\">显示疫苗信息</option>\r\n                        </select> -->\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask_type\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"parameterJkmWay\" class=\"lang\">通行方式</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <select id=\"jkm_way\" name=\"jkm_way\">\r\n                            <option value=\"0\" class=\"lang\" key=\"green_pass\">绿码通行</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"gy_pass\">绿码或黄码</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask_type\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"nuclein_way\" class=\"lang\">核酸状态通行</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <select id=\"nuclein_way\" name=\"nuclein_way\">\r\n                            <option value=\"0\" class=\"lang\" key=\"no_check\">不检验</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"in_24_hs\">24小时内</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"in_48_hs\">48小时内</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"in_72_hs\">72小时内</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"in_week_hs\">一周内</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"mask_type\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span key=\"vaccineWay\" class=\"lang\">疫苗状态通行</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline op_cl\">\r\n                        <select id=\"vaccine_way\" name=\"vaccine_way\">\r\n                            <option value=\"0\" class=\"lang\" key=\"no_check\">不检验</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"zhen1_pass\">一针通行</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"zhen2_pass\">两针通行</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"zhen3_pass\">三针通行</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"layui-form-item\">\r\n            <label for=\"L_repass\" class=\"layui-form-label\">\r\n            </label>\r\n            <button class=\"layui-btn lang\" key=\"save\" lay-filter=\"save\" lay-submit=\"save\" >保存</button>\r\n\r\n        </div>\r\n\r\n\r\n\r\n\r\n        <!--        <hr class=\"layui-bg-gray\">-->\r\n\r\n        <div style=\"margin-bottom: 100px\"></div>\r\n\r\n\r\n\r\n        <div class=\"row\">\r\n            <ul class=\"layui-tab-title\">\r\n                <li lay-id=\"22\" class=\"over_tip lang\" key=\"b_jiejiari\" onclick=\"tipBan(this,'server')\">节假日</li>\r\n            </ul>\r\n\r\n\r\n            <div class=\"col-md-6 server_box\">\r\n                <div class=\"panel\">\r\n                    <div class=\"holiday-table-container\"> <!-- 新增容器类名 -->\r\n\r\n                        <div style=\"text-align: left\">\r\n                            <div class=\"lang\" key=\"w_shuomingsan\"></div>\r\n                        </div>\r\n                        <div style=\"display: flex\">\r\n                            <div onload=\"holidayLoad()\" style=\"width: 70%\">\r\n                                <table class=\"layui-table\" id=\"table3\">\r\n                                </table>\r\n                            </div>\r\n\r\n\r\n                            <div class=\"layui-form-item\">\r\n                                <label for=\"L_repass\" class=\"layui-form-label\">\r\n                                </label>\r\n                                <button class=\"layui-btn lang\" key=\"save\" lay-filter=\"saveholiday\"\r\n                                        lay-submit=\"saveholiday\" >保存</button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n\r\n\r\n\r\n\r\n        </div>\r\n\r\n    </form>\r\n</div>\r\n\r\n\r\n</body>\r\n\r\n\r\n<script type=\"text/javascript\" src=\"../js/xadmin.js\"></script>\r\n<script src=\"../lang/lang.js\"></script>\r\n<script src=\"../js/notify.js\"></script>\r\n<script src=\"../js/employee_add.js\"></script>\r\n<script>\r\n\r\n</script>\r\n\r\n</html>"
