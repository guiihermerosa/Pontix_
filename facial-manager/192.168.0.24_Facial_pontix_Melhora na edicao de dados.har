          "content": {
            "size": 16771,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html>\r\n  \r\n  <head>\r\n    <meta charset=\"UTF-8\">\r\n    <titl ></titl>\r\n    <meta name=\"renderer\" content=\"webkit\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\r\n    <meta name=\"viewport\" content=\"width=device-width,user-scalable=yes, minimum-scale=0.4, initial-scale=0.8,target-densitydpi=low-dpi\" />\r\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\r\n    <link rel=\"stylesheet\" href=\"../css/font.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/xadmin.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/bootstrap.min.css\">\r\n\r\n      <script src=\"../js/html5.min.js\"></script>\r\n      <script src=\"../js/respond.min.js\"></script>\r\n    <style>\r\n      .fixed-table-loading{\r\n        display: none;\r\n      }\r\n      .current{\r\n        background-color: #009688!important;\r\n        color: #fff!important;;\r\n      }\r\n\r\n      .op_cl label{\r\n          vertical-align: middle;\r\n      }\r\n      .type_but{\r\n          float: left;\r\n          margin-right: 15px;\r\n          background: #d2d2d2;\r\n      }\r\n      .chooseType{\r\n          background: #1E9FFF!important;\r\n      }\r\n      .param_top{\r\n          width: 100%;\r\n          height: 55px;\r\n          padding-left: 10px;\r\n          border-bottom:1px solid #d2d2d2;\r\n          margin-bottom: 20px;\r\n      }\r\n      .param_box1{\r\n          width:100%;\r\n          height: 100%;\r\n          float:left;\r\n      }\r\n      .param_jkm,.param_face{\r\n          display: none;\r\n      }\r\n      .show_div .show_div_in {vertical-align:middle}\r\n      .layui-form-checkbox{\r\n          height: 20px;\r\n          line-height: 20px;\r\n      }\r\n      .layui-form-checkbox i{\r\n          width: 25px;\r\n      }\r\n      .layui-form-label{\r\n          width: 120px !important;\r\n      }\r\n\r\n      .x-sss{\r\n          padding: 0 20px;\r\n          position: relative;\r\n          z-index: 99;\r\n          border-bottom: 1px solid #e5e5e5;\r\n          line-height: 39px;\r\n          height: 39px;\r\n          overflow: hidden;\r\n          display: flex;\r\n          margin-top: 20px;\r\n          margin-bottom: 10px;\r\n      }\r\n\r\n      .attendance-table td {\r\n          padding: 0 !important;\r\n      }\r\n\r\n    </style>\r\n  </head>\r\n\r\n\r\n\r\n\r\n    <div class=\"x-sss\">\r\n\r\n        <div class=\"param_top\">\r\n            <button class=\"layui-btn type_but lang chooseType\" type=\"button\" onclick=\"tipParam(this,'sys')\" key=\"sysToMingxi\">考勤明细表</button>\r\n            <button class=\"layui-btn type_but lang\" type=\"button\" onclick=\"tipParam(this,'face')\" key=\"faceHuizong\">考勤汇总表</button>\r\n            <!-- <button class=\"layui-btn type_but lang\" type=\"button\" onclick=\"tipParam(this,'jkm')\" key=\"jkmSet\">健康码设置</button> -->\r\n        </div>\r\n\r\n\r\n      <span class=\"layui-breadcrumb\">\r\n      <a class=\"layui-btn layui-btn-primary layui-btn-small\" style=\"line-height:1.6em;margin-top:3px;float:right\" href=\"javascript:location.replace(location.href);\" title=\"刷新\">\r\n        <i class=\"layui-icon\" style=\"line-height:38px\">&#xe669;</i></a>\r\n      </span>\r\n    </div>\r\n\r\n\r\n    <div  class=\"param_box1 param_sys\">\r\n\r\n        <div class=\"param_box1 param_sys\" >\r\n<!--        <body onload=\"Personload()\">-->\r\n            <div class=\"x-body\">\r\n              <div class=\"layui-row\">\r\n                <form class=\"layui-form layui-col-md12 x-so\">\r\n<!--                  <input type=\"text\" name=\"userid\" style=\"float: left;margin-right: 5px\" id=\"userid\" autocomplete=\"off\" placeholder=\"人员ID\" class=\"layui-input\">-->\r\n                  <input type=\"text\" name=\"time\" id=\"startTime\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n                  <input type=\"text\" name=\"time\" id=\"endTime\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\">\r\n                  <button style=\"margin-top: -3px; \" class=\"layui-btn\" type=\"button\" onclick=\"searchNoteData1()\"><i class=\"layui-icon\">&#xe615;</i></button>\r\n\r\n                  <button class=\"layui-btn layui-btn-warm lang\" key=\"export\" style=\"float: right;\" type=\"button\" onclick=\"tableToExcel()\">导出</button>\r\n                </form>\r\n              </div>\r\n\r\n              <table class=\"layui-table\" id=\"table\">\r\n\r\n\r\n\r\n              </table>\r\n<!--              <div class=\"card-inner\" id=\"page\" style=\"text-align: right\">-->\r\n\r\n              </div>\r\n\r\n            </div>\r\n           <div style=\"display:none;\" id=\"export_box\">\r\n                <form class=\"layui-form\" id=\"employeeInfo\" method=\"post\" enctype=\"multipart/form-data\">\r\n                    <div class=\"param_box\" style=\"margin-top: 20px;\">\r\n                        <div class=\"layui-form-item\">\r\n                            <label for=\"L_email\" class=\"layui-form-label\">\r\n                                <span class=\"x-red\">*</span><span class=\"lang\" key=\"time\">时间</span>\r\n                            </label>\r\n                            <div class=\"layui-input-inline\">\r\n                                <input type=\"text\" name=\"time\" id=\"EpStartTime\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n                                <input type=\"text\" name=\"time\" id=\"EpEndTime\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\" style=\"margin-top: 20px;\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"layui-form-item\">\r\n                            <label for=\"L_repass\" class=\"layui-form-label\">\r\n                            </label>\r\n                            <button class=\"layui-btn lang\" key=\"save\" type=\"button\" onclick=\"exportNoteKaoqinmingxi()\">保存</button>\r\n                            <button  class=\"layui-btn cancle-btn lang\" key=\"cancle\" onclick=\"cancleExpt()\">取消</button>\r\n                        </div>\r\n                    </div>\r\n                </form>\r\n           </div>\r\n\r\n<!--        </body>-->\r\n        </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    <div class=\"param_box1 param_face\">\r\n\r\n\r\n<!--        <body onload=\"getCData()\">-->\r\n        <div class=\"param_box1 param_face\" onload=\"getCData()\">\r\n\r\n            <div class=\"x-body\">\r\n                <div class=\"layui-row\">\r\n                    <form class=\"layui-form layui-col-md12 x-so\">\r\n<!--                        <input type=\"text\" name=\"userid\" style=\"float: left;margin-right: 5px\" id=\"userid\" autocomplete=\"off\" placeholder=\"人员ID\" class=\"layui-input\">-->\r\n                        <input type=\"text\" name=\"time\" id=\"startTime2\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n                        <input type=\"text\" name=\"time\" id=\"endTime2\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\">\r\n                        <button style=\"margin-top: -3px; \"  class=\"layui-btn\" type=\"button\" onclick=\"getCData()\"><i class=\"layui-icon\">&#xe615;</i></button>\r\n\r\n                        <button class=\"layui-btn layui-btn-warm lang\" key=\"export\" style=\"float: right;\"\r\n                                type=\"button\" onclick=\"tableToExcel2()\">导出</button>\r\n                    </form>\r\n                </div>\r\n\r\n                <table class=\"layui-table\" id=\"table2\">\r\n\r\n                </table>\r\n<!--                <div class=\"card-inner\" id=\"page\" style=\"text-align: right\">-->\r\n\r\n                </div>\r\n            </div>\r\n            <div style=\"display:none;\" id=\"export_box2\">\r\n                <form class=\"layui-form\" id=\"employeeInfo2\" method=\"post\" enctype=\"multipart/form-data\">\r\n                    <div class=\"param_box\" style=\"margin-top: 20px;\">\r\n                        <div class=\"layui-form-item\">\r\n                            <label for=\"L_email\" class=\"layui-form-label\">\r\n                                <span class=\"x-red\">*</span><span class=\"lang\" key=\"time\">时间</span>\r\n                            </label>\r\n                            <div class=\"layui-input-inline\">\r\n                                <input type=\"text\" name=\"time\" id=\"EpStartTime2\" autocomplete=\"off\" placeholder=\"开始时间\" class=\"layui-input note_time\">\r\n                                <input type=\"text\" name=\"time\" id=\"EpEndTime2\" autocomplete=\"off\" placeholder=\"结束时间\" class=\"layui-input note_time\" style=\"margin-top: 20px;\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"layui-form-item\">\r\n                            <label for=\"L_repass\" class=\"layui-form-label\">\r\n                            </label>\r\n                            <button class=\"layui-btn lang\" key=\"save\" type=\"button\" onclick=\"exportNoteKaoqinhuizong()\">保存</button>\r\n                            <button  class=\"layui-btn cancle-btn lang\" key=\"cancle\" onclick=\"cancleExpt()\">取消</button>\r\n                        </div>\r\n                    </div>\r\n                </form>\r\n            </div>\r\n\r\n<!--        </body>-->\r\n        </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n  </body>\r\n  <script src=\"../js/jquery.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../lib/layui/layui.js\" charset=\"utf-8\"></script>\r\n    <script src=\"../js/bootstrap.min.js\"></script>\r\n\t  <script src=\"../js/bootstrap-table.js\"></script>\r\n\t  <script src=\"../js/bootstrap-table-zh-CN.min.js\"></script>\r\n    <script src=\"../js/jquery.cookie.js\"></script>\r\n    <script type=\"text/javascript\" src=\"../js/xadmin.js\"></script>\r\n    <script src=\"../lang/lang.js\"></script>\r\n    <script src=\"../js/notify.js\"></script>\r\n\t  <script src=\"../js/work_note.js\"></script>\r\n\t      <script src=\"../js/export.js\"></script>  \r\n\r\n    \r\n    \r\n  <script>\r\n      // window.onload = function() {\r\n      //     Personload(); // 页面加载完成后立即调用\r\n      // };\r\n\r\n     lang_load();\r\n     $(\"#EpStartTime\").attr(\"placeholder\",window.lang.start_time);\r\n     $(\"#EpEndTime\").attr(\"placeholder\",window.lang.end_time);\r\n     $(\"#startTime\").attr(\"placeholder\",window.lang.start_time);\r\n     $(\"#endTime\").attr(\"placeholder\",window.lang.end_time);\r\n     $(\"#userid\").attr(\"placeholder\",window.lang.userid);\r\n\r\n      $(\"#startTime2\").attr(\"placeholder\",window.lang.start_time);\r\n      $(\"#endTime2\").attr(\"placeholder\",window.lang.end_time);\r\n      $(\"#EpStartTime2\").attr(\"placeholder\",window.lang.start_time);\r\n      $(\"#EpEndTime2\").attr(\"placeholder\",window.lang.end_time);\r\n     \r\n     var firstDate = new Date();\r\n      firstDate.setDate(1); //第一天       \r\n      var endDate = new Date(firstDate);      \r\n      endDate.setMonth(firstDate.getMonth()+1);     \r\n      endDate.setDate(0);\r\n\r\n\r\n      var firstDate2 = new Date();\r\n      firstDate2.setDate(1); //第一天\r\n      var endDate2 = new Date(firstDate2);\r\n      endDate2.setMonth(firstDate2.getMonth()+1);\r\n      endDate2.setDate(0);\r\n      var today = new Date(); // 直接创建 Date 对象，无需参数\r\n\r\n\r\n      //搜索的1\r\n      // var firstDates1 = new Date();\r\n      // firstDates1.setDate(1); //第一天\r\n      // var endDates1 = new Date(firstDates1);\r\n      // endDates1.setMonth(firstDates1.getMonth()+1);\r\n      // endDates1.setDate(0);\r\n      //\r\n      // //搜索的2\r\n      // var firstDates2 = new Date();\r\n      // firstDates2.setDate(1); //第一天\r\n      // var endDates2 = new Date(firstDates2);\r\n      // endDates2.setMonth(firstDates2.getMonth()+1);\r\n      // endDates2.setDate(0);\r\n\r\n\r\n      // console.log(\"firstDate: \",firstDate);\r\n      // console.log(\"date: \",new Date(firstDate));\r\n     var layer;\r\n        layui.use(['form','layer','laydate'], function(){\r\n                $ = layui.jquery;\r\n            var form = layui.form\r\n            ,laydate = layui.laydate;\r\n            layer = layui.layer;\r\n\r\n            //日期范围\r\n           var startDate = laydate.render({ \r\n                elem: '#startTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n               value: new Date(firstDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    endDate.config.min=date;\r\n                    }else{\r\n                        endDate.config.min=startDate.config.min;\r\n                    }\r\n                },\r\n            }); \r\n\r\n           var endDate = laydate.render({\r\n                elem: '#endTime'\r\n                ,trigger: 'click'\r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n               value: new Date(today),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    startDate.config.max=date;\r\n                    }else{\r\n                        startDate.config.max=endDate.config.max;\r\n                    }\r\n                }\r\n\r\n            });\r\n\r\n            //导出日期范围\r\n            //导出的1\r\n           var startD = laydate.render({ \r\n                elem: '#EpStartTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(firstDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    endD.config.min=date;\r\n                    }else{\r\n                        endD.config.min=startD.config.min;\r\n                    }\r\n                },\r\n            }); \r\n\r\n           var endD = laydate.render({ \r\n                elem: '#EpEndTime' \r\n                ,trigger: 'click' \r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(endDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                    date.month=date.month-1;\r\n                    startD.config.max=date;\r\n                    }else{\r\n                        startD.config.max=endD.config.max;\r\n                    }\r\n                }\r\n\r\n            });\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n           //搜索的2\r\n            var startDate2 = laydate.render({\r\n                elem: '#startTime2'\r\n                ,trigger: 'click'\r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(firstDate2),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                        date.month=date.month-1;\r\n                        endDate2.config.min=date;\r\n                    }else{\r\n                        endDate2.config.min=startDate2.config.min;\r\n                    }\r\n                },\r\n            });\r\n\r\n            var endDate2 = laydate.render({\r\n                elem: '#endTime2'\r\n                ,trigger: 'click'\r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(endDate),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                        date.month=date.month-1;\r\n                        startDate2.config.max=date;\r\n                    }else{\r\n                        startDate2.config.max=endDate2.config.max;\r\n                    }\r\n                }\r\n\r\n            });\r\n\r\n            //导出日期范围\r\n            //导出的2\r\n            var startD2 = laydate.render({\r\n                elem: '#EpStartTime2'\r\n                ,trigger: 'click'\r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(firstDate2),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                        date.month=date.month-1;\r\n                        endD2.config.min=date;\r\n                    }else{\r\n                        endD2.config.min=startD2.config.min;\r\n                    }\r\n                },\r\n            });\r\n\r\n            var endD2 = laydate.render({\r\n                elem: '#EpEndTime2'\r\n                ,trigger: 'click'\r\n                ,type: 'date'\r\n                ,format: 'yyyy/MM/dd',\r\n                lang: window.lang.lang,\r\n                value: new Date(endDate2),//初始赋值\r\n                done:function(value,date){\r\n                    if(value!=\"\"){\r\n                        date.month=date.month-1;\r\n                        startD2.config.max=date;\r\n                    }else{\r\n                        startD2.config.max=endD2.config.max;\r\n                    }\r\n                }\r\n\r\n            });\r\n\r\n\r\n\r\n\r\n\r\n\r\n        });\r\n\r\n\r\n\r\n\r\n  </script>\r\n\r\n</html>"
          },
