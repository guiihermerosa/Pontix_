          "cookies": [],
          "content": {
            "size": 98538,
            "mimeType": "application/x-javascript",
            "text": "/**\r\n * Created by Administrator on 2016/8/4.\r\n */\r\nvar layindex;\r\n// window.onload = function() {\r\n//     // 等待 layui 等依赖库初始化完成（短暂延迟确保兼容性）\r\n//     setTimeout(function() {\r\n//         searchNoteData1();\r\n//     }, 100); // 100毫秒延迟，确保所有组件就绪\r\n// };\r\n\r\n\r\nlayui.use(['form','layer'], function(){\r\n    $ = layui.jquery;\r\n    form = layui.form;\r\n    var layer = layui.layer;\r\n\r\n});\r\n\r\n\r\n\r\n\r\n\r\n// 新增：请求状态控制器\r\nlet isRequesting = false;\r\nlet requestTimer = null;\r\n\r\nfunction searchNoteData1() {\r\n    console.log(\"3333333333333333\", isRequesting)\r\n    // 新增：检查请求状态\r\n    if (isRequesting) {\r\n        layer.msg(window.lang.y_qingqiuzhong, {icon: 0, time: 1000});\r\n        return;\r\n    }\r\n\r\n    check_permission();\r\n    lang_load(); // 保持语言加载逻辑\r\n\r\n    // 新增：设置请求状态并添加加载提示\r\n    isRequesting = true;\r\n    loadingIndex = layer.load(1, {\r\n        shade: [0.1,'#fff'] //0.1透明度的白色背景\r\n    });\r\n    // 新增：超时控制\r\n    requestTimer = setTimeout(() => {\r\n        if (isRequesting) {\r\n            layer.close(loadingIndex);\r\n            layer.msg(window.lang.y_qingqiuchaoshi, {icon: 5, time: 2000});\r\n            isRequesting = false;\r\n        }\r\n    }, 20000); // 10秒超时\r\n\r\n    // getData(); // 传递加载层索引\r\n    getData(loadingIndex); // 传递加载层索引\r\n}\r\n\r\nfunction getData(index) {\r\n\r\n    let send = new Object();\r\n    send[\"password\"] = $.cookie(\"pwd\");\r\n    send[\"type\"] = 0;\r\n\r\n    if($(\"#startTime\").val() == \"\" && $(\"#endTime\").val() == \"\"){\r\n        send[\"start_time\"] = null;\r\n        send[\"end_time\"] = null;\r\n    }else{\r\n        if($(\"#startTime\").val() != \"\" && $(\"#endTime\").val() != \"\"){\r\n            send[\"start_time\"] = $(\"#startTime\").val();\r\n            send[\"end_time\"] = $(\"#endTime\").val();\r\n        }else{\r\n            // 新增：重置请求状态\r\n            isRequesting = false;\r\n            clearTimeout(requestTimer);\r\n\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n    $.ajax({\r\n        // url: 'http://192.168.1.163:3000/gate/Ce/getZ',\r\n        url: '/getAttendTable',\r\n        type: 'POST',\r\n        async: true,\r\n        contentType: \"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(send),\r\n        success: function(result) {\r\n            // 新增：重置请求状态\r\n            isRequesting = false;\r\n            clearTimeout(requestTimer);\r\n            layer.close(index);\r\n\r\n            if (result.code == 200) {\r\n                $('#table').empty();\r\n\r\n                result.data.forEach(function(person, personIndex) {\r\n                    const personInfoDiv = $('<div class=\"person-container\" style=\"margin-bottom: 100px\"></div>');\r\n\r\n                    // 渲染人员基本信息\r\n                    const infoHtml = `\r\n            <div class=\"person-info\">\r\n              <table class=\"info-table lang\" style=\"width: 100%; background-color: #f2f1f1\">\r\n                <tr>\r\n                  <th colspan=\"13\" style=\"text-align: center; vertical-align: middle;\" \r\n                  class=\"lang\" key=\"k_kaoqinmingxibiao\" >考勤明细表</th>    \r\n                </tr>\r\n                <tr>\r\n                  <th  colspan=\"1\" class=\"lang\" key=\"e_bianhao\" >工号</th>\r\n                  <td >${person.userid}</td>\r\n                  <th  colspan=\"1\" class=\"lang\" key=\"k_xingming\">姓名</th>\r\n                  <td>${person.employeeName}</td>\r\n                </tr>\r\n                <tr>\r\n                  <th  class=\"lang\" key=\"k_bumen\" >部门</th>\r\n                  <td>${person.department}</td>\r\n                  <th class=\"lang\" key=\"k_banci\" >班次</th>\r\n                  <td>${person.shift}</td>\r\n                  <th class=\"lang\" key=\"k_riqi\">日期</th>\r\n                  <td colspan=\"3\">${person.dateRange.start} - ${person.dateRange.end}</td>\r\n                </tr>\r\n              </table>\r\n            </div>\r\n          `;\r\n                    personInfoDiv.append(infoHtml);\r\n\r\n                    // 渲染考勤数据表格\r\n                    const attendanceTable = $('<table id=\"table-' + personIndex + '\" class=\"attendance-table\"></table>');\r\n                    personInfoDiv.append(attendanceTable);\r\n                    $('#table').append(personInfoDiv);\r\n\r\n                    console.log(\"表格是否已插入DOM:\", $(`#table-${personIndex}`).length > 0);\r\n                    const tableId = attendanceTable.attr('id');\r\n\r\n                    // 初始化Bootstrap Table\r\n                    attendanceTable.bootstrapTable({\r\n                        method: \"get\",\r\n                        striped: true,\r\n                        singleSelect: false,\r\n                        dataType: \"json\",\r\n                        pagination: false,\r\n                        data: person.attendan,\r\n                        columns: [\r\n                            // 第一层表头（分组标题）\r\n                            [\r\n                                { title: '日期', field: 'attDate', align: 'center', valign: 'middle', rowspan: 2, colspan: 1 },\r\n                                { title: '周', field: 'attWeek', align: 'center', valign: 'middle', rowspan: 2, colspan: 1 },\r\n                                { title: \"班段1\", field: 'w_banduanyi', colspan: 2, align: 'center' },\r\n                                { title: \"班段2\", field: 'w_banduaner',colspan: 2, align: 'center' },\r\n                                { title: \"班段3\", field: 'w_banduansan',colspan: 2, align: 'center' },\r\n                                { title: \"出勤时段\", field: 'w_chuqinshiduan',colspan: 2, align: 'center' },\r\n                                { title: '加班时数', field: 'attOver', align: 'center', valign: 'middle', rowspan: 2, colspan: 1 },\r\n                                { title: '迟到分钟', field: 'attLate', align: 'center', valign: 'middle', rowspan: 2, colspan: 1 },\r\n                                { title: '早退分钟', field: 'attEarly', align: 'center', valign: 'middle', rowspan: 2, colspan: 1 },\r\n                            ],\r\n                            // 第二层表头（具体字段）\r\n                            [\r\n                                { title: '上班', field: 'shift_t1', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '下班', field: 'shift_t2', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '上班', field: 'shift_t3', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '下班', field: 'shift_t4', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '上班', field: 'shift_t5', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '下班', field: 'shift_t6', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '标准', field: 'attStandard', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                                { title: '实际', field: 'attActual', align: 'center', valign: 'middle', formatter: styleFormatter },\r\n                            ]\r\n                        ],\r\n                        onPostBody: function() {\r\n                            mergeShiftCells(tableId);\r\n                        }\r\n\r\n\r\n                    });\r\n\r\n                });\r\n\r\n                mergeLastRowCells();\r\n\r\n                check_permission();\r\n                lang_load();\r\n\r\n            } else {\r\n                layer.msg(result.message, { icon: 5, time: 1000 });\r\n            }\r\n        },\r\n        error: function(error) {\r\n            // 新增：重置请求状态\r\n            layer.close(index);\r\n            isRequesting = false;\r\n            clearTimeout(requestTimer);\r\n\r\n            layer.msg(error, { icon: 5, time: 1000 });\r\n        }\r\n    });\r\n\r\n    check_permission();\r\n    lang_load();\r\n}\r\n\r\n// 修改后的合并函数：合并相邻且非数字字符相同的单元格\r\nfunction mergeShiftCells(tableId) {\r\n    console.log(\"mergeShiftCells被调用，表格ID:\", tableId);\r\n    const table = $(`#${tableId}`);\r\n    if (!table.length) {\r\n        return;\r\n    }\r\n\r\n    const tbody = table.find('tbody');\r\n    const rows = tbody.find('tr');\r\n\r\n    rows.each(function(rowIndex) {\r\n        const row = $(this);\r\n        let cells = row.find('td');\r\n\r\n        // 保存班段相关的单元格（索引2到7）\r\n        const shiftCellIndices = [2, 3, 4, 5, 6, 7];\r\n        const shiftCells = shiftCellIndices.map(index => cells.eq(index));\r\n\r\n        // 1. 处理每个单元格：过滤数字和特殊符号，获取纯文本内容\r\n        const processedValues = shiftCells.map(cell => {\r\n            const text = cell.text().trim();\r\n            // 过滤掉所有数字、空格和特殊符号，保留多语言文本\r\n            return text.replace(/[\\d\\s\\&\\*\\:\\.]+/g, '');\r\n        });\r\n\r\n        // 2. 识别相邻且内容相同的单元格组\r\n        const mergeGroups = [];\r\n        if (processedValues.length > 0) {\r\n            let currentGroup = {\r\n                startIndex: 0,\r\n                endIndex: 0,\r\n                value: processedValues[0]\r\n            };\r\n\r\n            for (let i = 1; i < processedValues.length; i++) {\r\n                // 如果当前值与组值相同且不为空，则扩展当前组\r\n                if (processedValues[i] === currentGroup.value && currentGroup.value !== '') {\r\n                    currentGroup.endIndex = i;\r\n                } else {\r\n                    // 结束当前组，开始新组\r\n                    mergeGroups.push(currentGroup);\r\n                    currentGroup = {\r\n                        startIndex: i,\r\n                        endIndex: i,\r\n                        value: processedValues[i]\r\n                    };\r\n                }\r\n            }\r\n            // 添加最后一个组\r\n            mergeGroups.push(currentGroup);\r\n        }\r\n\r\n        // 3. 执行合并操作\r\n        // 从后往前合并，避免索引混乱\r\n        for (let i = mergeGroups.length - 1; i >= 0; i--) {\r\n            const group = mergeGroups[i];\r\n            // 只合并包含多个单元格且值不为空的组\r\n            if (group.endIndex > group.startIndex && group.value !== '') {\r\n                const startCell = shiftCells[group.startIndex];\r\n                const colspan = group.endIndex - group.startIndex + 1;\r\n\r\n                // 设置合并属性\r\n                startCell.attr('colspan', colspan);\r\n                startCell.css('text-align', 'center');\r\n\r\n                // 移除被合并的单元格\r\n                for (let j = group.endIndex; j > group.startIndex; j--) {\r\n                    shiftCells[j].remove();\r\n                }\r\n            }\r\n        }\r\n    });\r\n}\r\n\r\n\r\n\r\n\r\n// 合并最后一行的指定单元格并显示\"总计\"，同时保留右侧数据\r\nfunction mergeLastRowCells() {\r\n    // 遍历每个人员的表格\r\n    $(\"[id^='table-']\").each(function() {\r\n        const tableId = $(this).attr('id');\r\n        const table = $(`#${tableId}`);\r\n        const rows = table.find('tbody tr');\r\n        const lastRow = rows.last();\r\n\r\n        if (lastRow.length > 0) {\r\n            // 计算要合并的单元格数量（从\"日期\"到\"shift_t6\"下班，共8列）\r\n            const colspan = 8;\r\n\r\n            // 创建合并后的单元格\r\n            const mergedCell = $('<td colspan=\"' + colspan + '\" style=\"text-align: center; \">' +\r\n                window.lang.b_zongji + '</td>');\r\n\r\n            // 保存右侧需要保留的单元格（从第9个开始到最后）\r\n            const rightCells = lastRow.find('td:gt(' + (colspan - 1) + ')');\r\n\r\n            // 移除原有的前8个单元格\r\n            lastRow.find('td:lt(' + colspan + ')').remove();\r\n\r\n            // 将合并后的单元格插入到第一列位置\r\n            lastRow.prepend(mergedCell);\r\n\r\n            // 将保存的右侧单元格重新添加到合并后的单元格后面\r\n            rightCells.each(function() {\r\n                lastRow.append(this);\r\n            });\r\n        }\r\n    });\r\n}\r\n\r\n\r\n\r\n\r\n// 添加单元格样式处理函数\r\nfunction styleFormatter(value, row, index) {\r\n    if (typeof value !== 'string') return value;\r\n\r\n    let backgroundColor = '';\r\n    let displayValue = value;\r\n\r\n    // 检查特殊符号并设置背景色\r\n    if (value.includes('^')) {\r\n        // backgroundColor = '#ccffcc';\r\n        backgroundColor = '#c9f9f4';\r\n        displayValue = value.replace(/\\^/g, '');\r\n    } else if (value.includes('&')) {\r\n        backgroundColor = '#FF3333';\r\n        displayValue = value.replace(/&/g, '');\r\n    } else if (value.includes('*')) {\r\n        backgroundColor = '#FFFFCC';\r\n        displayValue = value.replace(/\\*/g, '');\r\n    }\r\n\r\n    // 如果有背景色，设置单元格样式\r\n    if (backgroundColor) {\r\n        return `<div style=\"background-color: ${backgroundColor}\">${displayValue}</div>`;\r\n    }\r\n\r\n    return value;\r\n}\r\n\r\n// 移除原有的searchNote、timestampToTime等与多表格无关的函数，或根据实际需求调整\r\n// 保留openImg、tableToExcel等需要的函数\r\n\r\n// 其他函数（如exportNote、tipParam等）保持不变或根据新结构调整\r\n\r\n//条件查询\r\nfunction searchNote(page,limt){\r\n    let alg = new Object();\r\n    alg[\"password\"] = $.cookie(\"pwd\");\r\n    alg[\"type\"] = 0\r\n    if($(\"#startTime\").val() == \"\" && $(\"#endTime\").val() == \"\"){\r\n        alg[\"start_time\"] = null;\r\n        alg[\"end_time\"] = null;\r\n    }else{\r\n        if($(\"#startTime\").val() != \"\" && $(\"#endTime\").val() != \"\"){\r\n            alg[\"start_time\"] = $(\"#startTime\").val();\r\n            alg[\"end_time\"] = $(\"#endTime\").val();\r\n        }else{\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n\r\n    alg[\"index\"] =page;\r\n    alg[\"count\"] =limt;\r\n\r\n    $.ajax({\r\n        url:  '/getWorkNoteList',\r\n        type: 'POST',\r\n        async: false,\r\n        contentType:\"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(alg),\r\n        success: function(result){\r\n            if(result.code == 200){\r\n                $('#table').bootstrapTable(\"load\", result.data);\r\n                lang_load();\r\n            }else{\r\n                layer.msg(result.message,{icon: 5,time:1000});\r\n            }\r\n\r\n        },error(){\r\n\r\n        }\r\n    });\r\n}\r\n\r\n\r\n\r\n//时间戳转日期\r\nfunction timestampToTime(timestamp) {\r\n    var date = new Date(timestamp * 1000);//时间戳为10位需*1000，时间戳为13位的话不需乘1000\r\n//    var Y = date.getFullYear() + '-';\r\n//    var M = (date.getMonth()+1 < 10 ? '0'+(date.getMonth()+1) : date.getMonth()+1) + '-';\r\n//    var D = date.getDate() + ' ';\r\n    var h = date.getHours() + ':';\r\n    var m = date.getMinutes() + ':';\r\n    var s = date.getSeconds();\r\n    return h+m+s;//Y+M+D+;\r\n}\r\n\r\nfunction openImg(path) {\r\n    var index = layer.open({\r\n        type: 1,\r\n        title: window.lang.see_pic,\r\n        area: [\"60vh\",\"80vh\"],\r\n        fix: false, //不固定\r\n        maxmin: true,\r\n        shadeClose: false,\r\n        shade:0.4,\r\n        closeBtn: 1,\r\n        content:\r\n            '<div style=\"width:100%;height:100%\">\\n' +\r\n            '<img src=\"data:image/jpg;base64,'+path+'\" style=\"width:100%;height:100%\">\\n' +\r\n            '</div>'\r\n    });\r\n}\r\n\r\n//点击导出\r\nfunction tableToExcel(){\r\n    layindex = layer.open({\r\n        type: 1,\r\n        title: window.lang.w_exportmignxi,\r\n        area: [\"400px\",\"300px\"],\r\n        fix: false, //不固定\r\n        maxmin: true,\r\n        shadeClose: false,\r\n        shade:0.4,\r\n        closeBtn: 1,\r\n        content: $(\"#export_box\")\r\n\r\n    });\r\n}\r\n\r\nfunction exportNote1() {\r\n    let send = new Object();\r\n    send[\"password\"] = $.cookie(\"pwd\");\r\n    //send[\"type\"] = 2;\r\n    send[\"type\"] = 0;\r\n\r\n    if($(\"#EpStartTime\").val() == \"\" && $(\"#EpEndTime\").val() == \"\"){\r\n        send[\"start_time\"] = null;\r\n        send[\"end_time\"] = null;\r\n        send[\"startTime\"] = null;\r\n        send[\"endTime\"] = null;\r\n    }else{\r\n        if($(\"#EpStartTime\").val() != \"\" && $(\"#EpEndTime\").val() != \"\"){\r\n            send[\"start_time\"] = $(\"#EpStartTime\").val();\r\n            send[\"end_time\"] = $(\"#EpEndTime\").val();\r\n            send[\"startTime\"] = $(\"#EpStartTime\").val();\r\n            send[\"endTime\"] = $(\"#EpEndTime\").val();\r\n        }else{\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // let requestData = {\r\n    //     data: send,\r\n    //     password: $.cookie(\"pwd\")\r\n    // };\r\n\r\n    // $(location).attr('href',\"/exportAttendTable\");\r\n    // 将 send 对象转换为 URL 参数\r\n    const queryString = new URLSearchParams(send).toString();\r\n\r\n    // 构建完整的请求 URL\r\n    const exportUrl = `/exportAttendTable?${queryString}`;\r\n\r\n    // 触发浏览器下载\r\n    window.location.href = exportUrl;\r\n\r\n}\r\n\r\n\r\nfunction tableToExcel2(){\r\n    layindex = layer.open({\r\n        type: 1,\r\n        title: window.lang.w_exporthuizong,\r\n        area: [\"400px\",\"300px\"],\r\n        fix: false, //不固定\r\n        maxmin: true,\r\n        shadeClose: false,\r\n        shade:0.4,\r\n        closeBtn: 1,\r\n        content: $(\"#export_box2\")\r\n\r\n    });\r\n}\r\n\r\nfunction exportNote2() {\r\n    let send = new Object();\r\n    send[\"password\"] = $.cookie(\"pwd\");\r\n    //send[\"type\"] = 2;\r\n    send[\"type\"] = 0;\r\n\r\n    if($(\"#EpStartTime2\").val() == \"\" && $(\"#EpEndTime2\").val() == \"\"){\r\n        send[\"start_time\"] = null;\r\n        send[\"end_time\"] = null;\r\n        send[\"startTime\"] = null;\r\n        send[\"endTime\"] = null;\r\n    }else{\r\n        if($(\"#EpStartTime2\").val() != \"\" && $(\"#EpEndTime2\").val() != \"\"){\r\n            send[\"start_time\"] = $(\"#EpStartTime2\").val();\r\n            send[\"end_time\"] = $(\"#EpEndTime2\").val();\r\n            send[\"startTime\"] = $(\"#EpStartTime2\").val();\r\n            send[\"endTime\"] = $(\"#EpEndTime2\").val();\r\n        }else{\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // let requestData = {\r\n    //     data: send,\r\n    //     password: $.cookie(\"pwd\")\r\n    // };\r\n\r\n    // $(location).attr('href',\"/exportAttendTable\");\r\n    // 将 send 对象转换为 URL 参数\r\n    const queryString = new URLSearchParams(send).toString();\r\n\r\n    // 构建完整的请求 URL\r\n    const exportUrl = `/exportSummaryTable?${queryString}`;\r\n\r\n    // 触发浏览器下载\r\n    window.location.href = exportUrl;\r\n\r\n}\r\n\r\n\r\nfunction exportNote() {\r\n    // 创建一个style标签用于添加自定义样式，设置contentText字体样式\r\n    const style = document.createElement('style');\r\n    style.type = 'text/css';\r\n    const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n    style.appendChild(document.createTextNode(cssText));\r\n    // 将style标签添加到文档头部（也可以添加到其他合适位置，比如body开头等）\r\n    document.head.appendChild(style);\r\n\r\n    if ($(\"#EpStartTime\").val() == \"\" || $(\"#EpStartTime\").val() == null) {\r\n        layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n    if ($(\"#EpEndTime\").val() == \"\" || $(\"#EpEndTime\").val() == null) {\r\n        layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n        return false;\r\n    }\r\n\r\n    let send = new Object();\r\n    send[\"password\"] = $.cookie(\"pwd\");\r\n    //send[\"type\"] = 2;\r\n    send[\"type\"] = 0;\r\n\r\n\r\n    //send[\"startTime\"] = $(\"#EpStartTime\").val();\r\n    //send[\"endTime\"] = $(\"#EpEndTime\").val();\r\n    if($(\"#EpStartTime\").val() == \"\" && $(\"#EpEndTime\").val() == \"\"){\r\n        send[\"start_time\"] = null;\r\n        send[\"end_time\"] = null;\r\n        send[\"startTime\"] = null;\r\n        send[\"endTime\"] = null;\r\n    }else{\r\n        if($(\"#EpStartTime\").val() != \"\" && $(\"#EpEndTime\").val() != \"\"){\r\n            send[\"start_time\"] = $(\"#EpStartTime\").val();\r\n            send[\"end_time\"] = $(\"#EpEndTime\").val();\r\n            send[\"startTime\"] = $(\"#EpStartTime\").val();\r\n            send[\"endTime\"] = $(\"#EpEndTime\").val();\r\n        }else{\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n    // 定义表头\r\n    //var tHeader = ['姓名', '通行时间', '温度', '是否通过', '照片'];\r\n    var tHeader = ['通行时间', 'ID', '姓名',\r\n        '部门', '温度', '出勤',\r\n        '午休开始', '午休结束', '退勤',\r\n        '开始加班', '结束加班'];\r\n\r\n    //let str = `通行时间,ID,姓名,部门,温度,出勤,午休开始,午休结束,退勤,开始加班,结束加班\\n`;\r\n    // 先请求总数据条数\r\n    $.ajax({\r\n        url: '/getWorkNoteList',\r\n        type: 'POST',\r\n        contentType: \"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(send), // 以JSON格式传递参数\r\n        success: function (result) {\r\n            if (result.code === 200) {\r\n                const totalCount = result.total; // 数据总条数\r\n                console.log('总条数:', totalCount);\r\n                if (totalCount === 0) {\r\n                    layer.msg(window.lang.y_meiyoushujudaochu, { icon: 1, time: 1000 });\r\n                    return; // 直接返回，不执行后续操作\r\n                }\r\n                const pageSize = 100; // 每次请求最多100条\r\n                const totalPages = Math.ceil(totalCount / pageSize); // 总请求次数\r\n                console.log('总请求次数:', totalPages);\r\n\r\n                let completedRequests = 0; // 记录请求完成次数\r\n                let loadingIndex; // 用于记录加载层的索引\r\n\r\n                // 递归函数来发送请求并延迟1秒\r\n                function sendRequest(page) {\r\n                    // 显示加载提示框，提示正在导出文件操作等信息，数据竖着展示\r\n                    let contentText = window.lang.y_suoyouwenjianyijingdao + \"     \\n    \" + window.lang.y_zhengzaidaowendangshu + (completedRequests + 1);\r\n\r\n                    loadingIndex = layer.load(1, {\r\n                        shade: [0.5, '#767676'], // 遮罩层透明度及颜色\r\n                        content: contentText\r\n                    });\r\n                    console.log('开始递归');\r\n                    if (page > totalPages) {\r\n                        layer.close(loadingIndex); // 关闭加载层\r\n                        layer.msg(window.lang.y_suoyouwenjianyijingdao, { icon: 1, time: 1000 });\r\n                        layer.close(layindex);\r\n                        return;\r\n                    }\r\n\r\n                    let start = (page - 1) * pageSize + 1; // 每次请求的起始条数\r\n                    let end = page * pageSize; // 每次请求的结束条数\r\n                    if (end > totalCount) {\r\n                        end = totalCount; // 防止超过总条数\r\n                    }\r\n\r\n                    // 动态计算 currentCall 和 totalCall 参数\r\n                    let requestData = {\r\n                        ...send,\r\n                        startIndex: start,\r\n                        endIndex: end,\r\n                        currentCall: page,\r\n                        totalCall: totalPages\r\n                    };\r\n\r\n                    // 发送请求\r\n                    $.ajax({\r\n                        url: '/exportCheckinRecord',\r\n                        type: 'POST',\r\n                        async: true, // 异步请求\r\n                        contentType: \"application/json\",\r\n                        dataType: \"json\",\r\n                        data: JSON.stringify(requestData), // 传递的参数也以JSON格式\r\n                        success: function (result) {\r\n                            let list = [];\r\n                            for (let index = 0; index < result.data.length; index++) {\r\n                                const element = result.data[index];\r\n                                let obj = new Object();\r\n\r\n                                //obj[\"name\"] = element.name;\r\n                                //obj[\"checkin_time\"] = element.checkin_time;\r\n                                //obj[\"temp\"] = element.temp;\r\n                                //obj[\"pass\"] = element.ispass === 0? '否' : '是';\r\n                                //obj[\"pic\"] = \"data:image/jpg;base64,\" + element.pic_large;\r\n                                //list.push(obj);\r\n\r\n\r\n                                obj[\"checkin_time\"] = element.checkin_time;\r\n                                obj[\"userid\"] = element.userid;\r\n                                obj[\"name\"] = element.name;\r\n                                obj[\"department\"] = element.department;\r\n                                obj[\"temp\"] = element.temp;\r\n                                obj[\"am_start\"] = element.am_start;\r\n                                obj[\"am_end\"] = element.am_end;\r\n                                obj[\"pm_start\"] = element.pm_start;\r\n                                obj[\"pm_end\"] = element.pm_end;\r\n                                obj[\"over_start\"] = element.over_start;\r\n                                obj[\"over_end\"] = element.over_end;\r\n                                list.push(obj);\r\n\r\n                            }\r\n\r\n                            console.log('正在导出excel文档', );\r\n                            // 导出当前请求的数据\r\n                            export2Excel(tHeader, list, '考勤记录' + \"_part_\" + page + \"_of_\" + totalPages);\r\n\r\n                            completedRequests++;\r\n                            if (completedRequests === totalPages) {\r\n                                layer.close(loadingIndex); // 关闭加载层\r\n                                layer.msg(window.lang.y_suoyouwenjianyijingdao, { icon: 1, time: 1000 });\r\n                                layer.close(layindex);\r\n                            }\r\n\r\n                            // 延迟1秒后递归调用，继续发送下一页请求\r\n                            setTimeout(function () {\r\n                                sendRequest(page + 1);\r\n                            }, 1000); // 1秒延迟后发送请求\r\n                        },\r\n                        error: function () {\r\n                            layer.close(loadingIndex); // 关闭加载层\r\n                            layer.msg(window.lang.y_daochushibai, { icon: 1, time: 1000 });\r\n                        }\r\n                    });\r\n                }\r\n\r\n                // 开始从第1页请求数据\r\n                sendRequest(1);\r\n            } else {\r\n                layer.msg(window.lang.y_huoqutiaoshujushibai, { icon: 1, time: 1000 });\r\n            }\r\n        },\r\n        error: function () {\r\n            layer.msg(window.lang.y_huoqushujushibai, { icon: 1, time: 1000 });\r\n        }\r\n    });\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n//导航切换\r\nfunction tipParam(e,tip) {\r\n    // searchNoteData1()\r\n    // getCData()\r\n    // if (tip === 'sys') {\r\n    //     searchNoteData1(); // 调用考勤明细表的数据加载方法\r\n    // } else if (tip === 'face') {\r\n    //     getCData(); // 调用考勤汇总表的数据加载方法\r\n    // }\r\n\r\n    $(\".type_but\").removeClass(\"chooseType\");\r\n    $(e).addClass(\"chooseType\");\r\n    $(\".param_box1\").hide();\r\n    $(\".param_\"+tip).show();\r\n\r\n    // 新增：根据不同的 `tip` 调用对应数据加载方法\r\n    // if (tip === 'sys') {\r\n    //     searchNoteData1(); // 调用考勤明细表的数据加载方法\r\n    // } else if (tip === 'face') {\r\n    //     getCData(); // 调用考勤汇总表的数据加载方法\r\n    // }\r\n\r\n}\r\n\r\n\r\n\r\n\r\n\r\n//关闭导出\r\nfunction cancleExpt(){\r\n    layer.close(layindex);\r\n}\r\n\r\n\r\nfunction getCData() {\r\n\r\n    lang_load(); // 保持语言加载逻辑\r\n    getCDataList(); // 直接调用数据获取\r\n}\r\n\r\n\r\nfunction getCDataList() {\r\n    check_permission();\r\n\r\n    // 清空原有表格\r\n    // $('#table2').empty();\r\n\r\n    // 初始化Bootstrap Table，添加表头\r\n    $('#table2').bootstrapTable({\r\n        method: \"get\",\r\n        striped: true,\r\n        singleSelect: false,\r\n        dataType: \"json\",\r\n        pagination: false, //分页\r\n        pageSize: 10,\r\n        pageNumber: 1,\r\n        search: false, //显示搜索框\r\n        contentType: \"application/x-www-form-urlencoded\",\r\n        queryParams: null,\r\n        columns: [\r\n            // 表格标题行\r\n            [\r\n                {\r\n                    title: \"考勤汇总表\",\r\n                    colspan: 13,\r\n                    field: 'k_kaoqinhuizongbiao',\r\n                    align: 'center',\r\n                }\r\n            ],\r\n            // 日期范围行\r\n            [\r\n                {\r\n                    title: \"日期\",\r\n                    colspan: 1,\r\n                    field: \"k_riqi\",\r\n                    // align: 'center',\r\n                    // formatter: function(value, row, index) {\r\n                    //     return `<div class=\"date-range\">日期范围：<span id=\"date-range-display\">加载中...</span></div>`;\r\n                    // }\r\n                },\r\n                {\r\n                    title: \"<span id='date-range-display' ></span>\",\r\n                    colspan: 12,\r\n                    // field: \"k_riqi\",\r\n                    // align: 'center',\r\n                    // formatter: function(value, row, index) {\r\n                    //     return `<div class=\"date-range\">日期范围：<span id=\"date-range-display\">加载中...</span></div>`;\r\n                    // }\r\n                }\r\n            ],\r\n            // 第一层表头（分组标题）\r\n            [\r\n                // {\r\n                //     title: \"\",\r\n                //     colspan: 1,\r\n                //     align: 'center'\r\n                // },\r\n                {\r\n                    title: \"工号\",  // 合并后的标题\r\n                    field: 'userid',\r\n                    rowspan: 2,    // 跨两行（上下表头行）\r\n                    colspan: 1,\r\n                    align: 'center',\r\n                    valign: 'middle'  // 垂直居中\r\n                },\r\n                {\r\n                    title: '姓名',\r\n                    field: 'employeeName',\r\n                    rowspan: 2,    // 跨两行（上下表头行）\r\n                    colspan: 1,\r\n                    align: 'center',\r\n                    valign: 'middle'  // 垂直居中\r\n                },\r\n                {\r\n                    title: '部门',\r\n                    field: 'department',\r\n                    rowspan: 2,    // 跨两行（上下表头行）\r\n                    colspan: 1,\r\n                    align: 'center',\r\n                    valign: 'middle'  // 垂直居中\r\n                },\r\n                // {\r\n                //     title: \"\",\r\n                //     colspan: 1,\r\n                //     align: 'center'\r\n                // },\r\n                // {\r\n                //     title: \"\",\r\n                //     colspan: 1,\r\n                //     align: 'center'\r\n                // },\r\n                {\r\n                    title: \"出勤时数\",\r\n                    colspan: 2,\r\n                    field: 'k_chuqinshishu',\r\n                    align: 'center'\r\n                },\r\n                {\r\n                    title: \"迟到分钟\",\r\n                    colspan: 2,\r\n                    field: 'k_chidaofenzhong',\r\n                    align: 'center'\r\n                },\r\n                {\r\n                    title: \"早退分钟\",\r\n                    field: 'k_czaotuifenzhong',\r\n                    colspan: 2,\r\n                    align: 'center'\r\n                },\r\n                {\r\n                    title: \"加班时数\",\r\n                    field: 'k_jiabanshishu',\r\n                    colspan: 2,\r\n                    align: 'center'\r\n                },\r\n                // {\r\n                //     title: \"\",\r\n                //     colspan: 1,\r\n                //     align: 'center'\r\n                // },\r\n                // {\r\n                //     title: \"\",\r\n                //     colspan: 1,\r\n                //     align: 'center'\r\n                // },\r\n                {\r\n                    title: '工作日数',\r\n                    field: 'workDays',\r\n                    rowspan: 2,    // 跨两行（上下表头行）\r\n                    colspan: 1,\r\n                    align: 'center',\r\n                    valign: 'middle'  // 垂直居中\r\n                },\r\n                {\r\n                    title: '旷工',\r\n                    field: 'absentDays',\r\n                    rowspan: 2,    // 跨两行（上下表头行）\r\n                    colspan: 1,\r\n                    align: 'center',\r\n                    valign: 'middle'  // 垂直居中\r\n                }\r\n\r\n            ],\r\n            // 第二层表头（具体字段）\r\n            [\r\n                // {\r\n                //     title: '工号',\r\n                //     field: 'userid',\r\n                //     align: 'center',\r\n                //     valign: 'middle'\r\n                // },\r\n                // {\r\n                //     title: '姓名',\r\n                //     field: 'employeeName',\r\n                //     align: 'center',\r\n                //     valign: 'middle'\r\n                // },\r\n                // {\r\n                //     title: '部门',\r\n                //     field: 'department',\r\n                //     align: 'center',\r\n                //     valign: 'middle'\r\n                // },\r\n                {\r\n                    title: '标准',\r\n                    field: 'attStandard',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '实际',\r\n                    field: 'attActual',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '次',\r\n                    field: 'lateNum',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '分',\r\n                    field: 'lateMin',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '次',\r\n                    field: 'earlyNum',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '分',\r\n                    field: 'earlyMin',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '标准',\r\n                    field: 'overStandard',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                {\r\n                    title: '实际',\r\n                    field: 'overActual',\r\n                    align: 'center',\r\n                    valign: 'middle'\r\n                },\r\n                // {\r\n                //     title: '工作日数',\r\n                //     field: 'workDays',\r\n                //     align: 'center',\r\n                //     valign: 'middle'\r\n                // },\r\n                // {\r\n                //     title: '旷工',\r\n                //     field: 'absentDays',\r\n                //     align: 'center',\r\n                //     valign: 'middle'\r\n                // }\r\n            ]\r\n        ]\r\n    });\r\n\r\n    // 添加自定义样式\r\n    const style = `\r\n        <style>\r\n            .table-title {\r\n                font-size: 18px;\r\n                font-weight: bold;\r\n            }\r\n            .date-range {\r\n                font-size: 14px;\r\n                color: #666;\r\n            }\r\n        </style>\r\n    `;\r\n    $('head').append(style);\r\n\r\n    lang_load();\r\n    getCDataS();\r\n}\r\n\r\n\r\n\r\n// 新增：请求状态控制器\r\nlet isRequesting2 = false;\r\nlet requestTimer2 = null;\r\n\r\nfunction getCDataS() {\r\n    console.log(\"3333333333333333\", isRequesting2)\r\n    // 新增：检查请求状态\r\n    if (isRequesting2) {\r\n        layer.msg(window.lang.y_qingqiuzhong, {icon: 0, time: 1000});\r\n        return;\r\n    }\r\n\r\n    check_permission();\r\n    lang_load(); // 保持语言加载逻辑\r\n\r\n    // 新增：设置请求状态并添加加载提示\r\n    isRequesting2 = true;\r\n    loadingIndex = layer.load(1, {\r\n        shade: [0.1,'#fff'] //0.1透明度的白色背景\r\n    });\r\n    // 新增：超时控制\r\n    requestTimer2 = setTimeout(() => {\r\n        if (isRequesting2) {\r\n            layer.close(loadingIndex);\r\n            layer.msg(window.lang.y_qingqiuchaoshi, {icon: 5, time: 2000});\r\n            isRequesting2 = false;\r\n        }\r\n    }, 20000); // 10秒超时\r\n\r\n    getCDataS2(loadingIndex); // 传递加载层索引\r\n}\r\n\r\nfunction getCDataS2(index) {\r\n    // layer.close(index);\r\n    let send = new Object()\r\n    send[\"password\"] = $.cookie(\"pwd\")\r\n    // send[\"type\"] = 2\r\n    send[\"type\"] = 0\r\n\r\n    if($(\"#startTime2\").val() == \"\" && $(\"#endTime2\").val() == \"\"){\r\n        send[\"start_time\"] = null;\r\n        send[\"end_time\"] = null;\r\n    }else{\r\n        if($(\"#startTime2\").val() != \"\" && $(\"#endTime2\").val() != \"\"){\r\n            send[\"start_time\"] = $(\"#startTime2\").val();\r\n            send[\"end_time\"] = $(\"#endTime2\").val();\r\n        }else{\r\n            // 新增：重置请求状态\r\n            isRequesting2 = false;\r\n            clearTimeout(requestTimer2);\r\n\r\n            layer.msg(window.lang.y_wanzhegnshijianduan,{icon: 5,time:1000});\r\n            return false;\r\n        }\r\n    }\r\n\r\n\r\n    $.ajax({\r\n        url:  '/getSummaryTable',\r\n        // url: 'http://192.168.1.163:3000/gate/Ce/getX',\r\n        type: 'POST',\r\n        async: true,\r\n        contentType:\"application/json\",\r\n        dataType: \"json\",\r\n        data: JSON.stringify(send),\r\n        success: function(result){\r\n\r\n            // 新增：重置请求状态\r\n            isRequesting2 = false;\r\n            clearTimeout(requestTimer2);\r\n            layer.close(index);\r\n\r\n            if(result.code == 200){\r\n                // 显示日期范围\r\n                $(\"#date-range-display\").text(`${result.data.dateRange.start} - ${result.data.dateRange.end}`);\r\n\r\n\r\n                $('#table2').bootstrapTable(\"load\", result.data.collect);\r\n                layui.use('laypage', function(){\r\n                    var laypage = layui.laypage;\r\n                    laypage.render({\r\n                        elem: 'page' //注意，这里的 page 是 ID，不用加 # 号\r\n                        ,//数据总数，从服务端得到\r\n                        count: result.total,\r\n                        limits:[10,20,30,40,50],\r\n                        first: false,\r\n                        last: false,\r\n                        prev:\"<<\",\r\n                        next:\">>\",\r\n                        theme:\"#0099ff\", //['count', 'prev', 'page', 'next', 'limit', 'skip'],\r\n                        layout: [ 'prev', 'page', 'next'],\r\n                        limit: result.count,\r\n                        // curr: result.index,\r\n                        jump:function(data, first){\r\n                            var page=data.curr;\r\n                            console.log(\"page: \",page);\r\n                            $(\"#currPage\").val(page);\r\n                            var limt=data.limit;\r\n                            console.log(\"limt: \",limt);\r\n                            $(\"#limit\").val(limt);\r\n                            if(!first){ //点击右下角分页时调用\r\n                                searchNote(page,limt);\r\n                                console.log(\"分页\");\r\n                            }\r\n                        }\r\n                    });\r\n                })\r\n                lang_load();\r\n            } else {\r\n                layer.msg(result.message, { icon: 5, time: 1000 });\r\n            }\r\n        },\r\n        // error: function(error) {\r\n        //     layer.msg(error, { icon: 5, time: 1000 });\r\n        // }\r\n        error: function(error) {\r\n            // 新增：重置请求状态\r\n            isRequesting2 = false;\r\n            clearTimeout(requestTimer2);\r\n            layer.close(index);\r\n\r\n            layer.msg(error, { icon: 5, time: 1000 });\r\n        }\r\n    });\r\n\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n// function exportNoteKaoqinhuizong() {\r\n//     console.log(\"汇总。。。。。。。。。。\")\r\n//\r\n//     // 创建一个style标签用于添加自定义样式，设置contentText字体样式\r\n//     const style = document.createElement('style');\r\n//     style.type = 'text/css';\r\n//     const cssText = '.layui-layer-content.layui-layer-loading1 { width: 350px!important; font-size: 16px!important; padding-left: 55px!important;  color: white!important; }';\r\n//     style.appendChild(document.createTextNode(cssText));\r\n//     // 将style标签添加到文档头部（也可以添加到其他合适位置，比如body开头等）\r\n//     document.head.appendChild(style);\r\n//\r\n//     if ($(\"#EpStartTime2\").val() == \"\" || $(\"#EpStartTime2\").val() == null) {\r\n//         layer.msg(window.lang.please_ch_start_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//     if ($(\"#EpEndTime2\").val() == \"\" || $(\"#EpEndTime2\").val() == null) {\r\n//         layer.msg(window.lang.please_ch_end_time, { icon: 5, time: 1000 });\r\n//         return false;\r\n//     }\r\n//\r\n//     let send = new Object();\r\n//     send[\"password\"] = $.cookie(\"pwd\");\r\n//     send[\"type\"] = 0;\r\n//\r\n//     // 设置时间范围\r\n//     if($(\"#EpStartTime2\").val() == \"\" && $(\"#EpEndTime2\").val() == \"\"){\r\n//         send[\"start_time\"] = null;\r\n//         send[\"end_time\"] = null;\r\n//         send[\"startTime\"] = null;\r\n//         send[\"endTime\"] = null;\r\n//     }else{\r\n//         if($(\"#EpStartTime2\").val() != \"\" && $(\"#EpEndTime2\"