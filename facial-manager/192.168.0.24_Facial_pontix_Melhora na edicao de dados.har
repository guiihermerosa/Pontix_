            "mimeType": "text/html",
            "text": "<!doctype html>\r\n<html>\r\n<head> \r\n    <meta charset=\"utf-8\">\r\n    <titl ></titl>\r\n    <meta name=\"renderer\" content=\"webkit\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\r\n    <meta name=\"viewport\" content=\"width=device-width,user-scalable=yes, minimum-scale=0.4, initial-scale=0.8,target-densitydpi=low-dpi\" />\r\n    <link rel=\"shortcut icon\" href=\"/favicon.ico\" type=\"image/x-icon\" />\r\n    <link rel=\"stylesheet\" href=\"../css/font.css\">\r\n    <link rel=\"stylesheet\" href=\"../css/xadmin.css\">\r\n    <style type=\"text/css\">\r\n\t\t.layui-form-radio{margin: 0px;padding: 0px;margin-top: 5px;}\r\n        .param_box{\r\n            width: 49%;\r\n            float: left;\r\n        }\r\n        .layui-form-label{\r\n            width: 100px;\r\n        }\r\n        .work_table .layui-form-label,.work_table .layui-form-radio{\r\n            float: left;\r\n        }\r\n        .none-time{\r\n            padding-left: 5px;\r\n            text-align: left;\r\n        }\r\n        .work_time ,.zhi{\r\n            float: left;\r\n        }\r\n        .work_time{\r\n            width: 47%;\r\n        }\r\n        .more-rest {\r\n            width: 50px;\r\n            height: 35px;\r\n            float: left;\r\n            text-align: center;\r\n            color: rgb(255, 255, 255);\r\n            font-size: 25px;\r\n            margin-left: 15px;\r\n            cursor: pointer;\r\n            border-radius: 4px;\r\n            background: rgb(94, 189, 94);\r\n            border-width: initial;\r\n            border-style: none;\r\n            border-color: initial;\r\n            border-image: initial;\r\n        }\r\n        .less-rest{\r\n            background: #e77878;\r\n        }\r\n        .pass_time{\r\n            width: 150px;\r\n            float: left;\r\n        }\r\n\r\n        .no-spin {\r\n            -webkit-appearance: textfield;\r\n            -moz-appearance: textfield;\r\n            appearance: textfield;\r\n        }\r\n\r\n        .no-spin::-webkit-inner-spin-button,\r\n        .no-spin::-webkit-outer-spin-button {\r\n            -webkit-appearance: none;\r\n            margin: 0;\r\n        }\r\n\r\n        /* 上传区域禁用样式 */\r\n        .upload-disabled {\r\n            opacity: 0.4;\r\n            pointer-events: none;\r\n            cursor: not-allowed;\r\n        }\r\n\r\n\r\n    </style>\r\n<!--    &lt;!&ndash; 让IE8/9支持媒体查询，从而兼容栅格 &ndash;&gt;-->\r\n<!--    &lt;!&ndash;[if lt IE 9]>-->\r\n<!--      <script src=\"https://cdn.staticfile.org/html5shiv/r29/html5.min.js\"></script>-->\r\n<!--      <script src=\"https://cdn.staticfile.org/respond.js/1.4.2/respond.min.js\"></script>-->\r\n<!--    <![endif]&ndash;&gt;-->\r\n    <script src=\"../js/html5.min.js\"></script>\r\n    <script src=\"../js/respond.min.js\"></script>\r\n\r\n\r\n  </head>\r\n  \r\n  <body onload=\"load()\">\r\n    <div class=\"x-body layui-anim layui-anim-up\">\r\n        <form class=\"layui-form\" id=\"employeeInfo\" method=\"post\" enctype=\"multipart/form-data\">\r\n        \t<div class=\"param_box param_left\">\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\">*</span><span class=\"lang\" key=\"e_bianhao\">编号</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n<!--                        <input type=\"hidden\" name=\"password\" id=\"userid\">-->\r\n                        <div class=\"layui-input-inline\">\r\n                            <input\r\n                                    type=\"text\"\r\n                            id=\"userid\"\r\n                            name=\"userid\"\r\n                            lay-verify=\"userid\"\r\n                            autocomplete=\"off\"\r\n                            class=\"layui-input no-spin\"\r\n                            maxlength=\"8\"\r\n                            pattern=\"[0-9]*\"\r\n                            inputmode=\"numeric\"\r\n                            oninput=\"this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);\"\r\n                            >\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n        \t\t<div class=\"layui-form-item\">\r\n\t\t            <label for=\"L_email\" class=\"layui-form-label\">\r\n\t\t                <span class=\"x-red\"></span><span class=\"lang\" key=\"name\">姓名</span>\r\n\t\t            </label>\r\n\t\t            <div class=\"layui-input-inline\">\r\n<!--                        <input type=\"hidden\" name=\"username\" id=\"username\">-->\r\n\t\t                <input type=\"text\" id=\"name\" name=\"name\" lay-verify=\"name\" autocomplete=\"off\"\r\n                               class=\"layui-input\" maxlength=\"20\">\r\n\t\t            </div>\r\n\t\t        </div>\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_username\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"e_bumen\">部门</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"department\" name=\"department\">\r\n\r\n                            <option value=\"0\" class=\"lang\" key=\"e_bumenyi\">部门一</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"e_bumener\">部门二</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"e_bumensan\">部门三</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"e_bumensi\">部门四</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"e_bumenwu\">部门五</option>\r\n                            <option value=\"5\" class=\"lang\" key=\"e_bumenliu\">部门六</option>\r\n                            <option value=\"6\" class=\"lang\" key=\"e_bumenqi\">部门七</option>\r\n                            <option value=\"7\" class=\"lang\" key=\"e_bumenba\">部门八</option>\r\n                            <option value=\"8\" class=\"lang\" key=\"e_bumenjiu\">部门九</option>\r\n                            <option value=\"9\" class=\"lang\" key=\"e_bumenshi\">部门十</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_username\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"e_banci\">班次</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"schedule\" name=\"schedule\">\r\n                            <option value=\"0\" class=\"lang\" key=\"e_wubanci\">无班次</option>\r\n                            <option value=\"1\" class=\"lang\" key=\"e_banciyi\">班次一</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"e_bancier\">班次二</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"e_bancisan\">班次三</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"e_bancisi\">班次四</option>\r\n                            <option value=\"5\" class=\"lang\" key=\"e_banciwu\">班次五</option>\r\n                            <option value=\"6\" class=\"lang\" key=\"e_banciliu\">班次六</option>\r\n                            <option value=\"7\" class=\"lang\" key=\"e_banciqi\">班次七</option>\r\n                            <option value=\"8\" class=\"lang\" key=\"e_banciba\">班次八</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n\t\t              <label for=\"L_username\" class=\"layui-form-label\">\r\n\t\t                  <span class=\"x-red\"></span><span class=\"lang\" key=\"e_juese\">角色</span>\r\n\t\t              </label>\r\n\t\t              <div class=\"layui-input-inline\">\r\n\t\t              \t\t<select id=\"role\" name=\"role\">\r\n                                <option value=\"0\" class=\"lang\" key=\"e_putongrenyuan\">普通用户</option>\r\n                                <option value=\"1\" class=\"lang\" key=\"e_gaunlirenyuan\">管理员</option>\r\n                                <option value=\"3\" class=\"lang\" key=\"y_chaojiyonghu\">超级用户</option>\r\n                                <option value=\"2\" class=\"lang\" key=\"e_heimingdan\">黑名单</option>\r\n                            </select>\r\n\t\t              </div>\r\n\t\t        </div>\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"e_mima\">密码</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n<!--                        <input type=\"hidden\" name=\"password\" id=\"password\">-->\r\n                        <input      id=\"password\" name=\"password\" type=\"number\"\r\n                               lay-verify=\"password\" autocomplete=\"off\" class=\"layui-input no-spin\">\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"e_ka\">卡</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <!--                        <input type=\"hidden\" name=\"password\" id=\"password\">-->\r\n                        <input   step=\"1\" min=\"0\"  type=\"text\" id=\"access_card_number\" name=\"access_card_number\"\r\n                                 lay-verify=\"access_card_number\" autocomplete=\"off\" class=\"layui-input no-spin\" >\r\n                    </div>\r\n\r\n                    <!--                    <button  class=\"layui-btn  lang\" key=\"b_shebeixinzeng\" onclick=\"canclexx()\">取消</button>-->\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item work_table\">\r\n                    <label for=\"L_email\" class=\"layui-form-label lang\" key=\"pass_date\">通行权限</label>\r\n                    <div class=\"layui-inline\">\r\n                        <input type=\"radio\" name=\"pass_date\" value=\"0\" lay-filter=\"pass_date\" checked=\"checked\">\r\n                        <label for=\"L_email\" class=\"layui-form-label lang none-time\" key=\"everyday\" >每天</label>\r\n                    </div>\r\n                </div>\r\n                <div class=\"layui-form-item work_table\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\" key=\"\" ></label>\r\n                    <div class=\"layui-inline\">\r\n                        <input type=\"radio\" name=\"pass_date\" value=\"1\" lay-filter=\"pass_date\" >\r\n                        <label for=\"L_email\" class=\"layui-form-label lang none-time\"\r\n                               key=\"time_solt\" style=\"width: auto;\">时间段</label>\r\n                        <input type=\"text\" class=\"layui-input  layui-disabled work_time\"\r\n                               style=\"width: 280px; \" disabled placeholder=\" 开始 - 结束 \"\r\n                               id=\"pass_date\" name=\"pass_start_date\">\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_username\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"e_person_period\">通行时段</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <select id=\"person_period\" name=\"person_period\">\r\n                            <option value=\"0\" class=\"lang\" key=\"e_fou\">否</option>\r\n<!--                            <option value=\"1\" class=\"lang\" key=\"e_shiduanyi\">时段一</option>-->\r\n<!--                            <option value=\"2\" class=\"lang\" key=\"e_shiduaner\">时段二</option>-->\r\n<!--                            <option value=\"3\" class=\"lang\" key=\"e_shiduansan\">时段三</option>-->\r\n<!--                            <option value=\"4\" class=\"lang\" key=\"e_shiduansi\">时段四</option>-->\r\n<!--                            <option value=\"5\" class=\"lang\" key=\"e_shiduanwu\">时段五</option>-->\r\n<!--                            <option value=\"6\" class=\"lang\" key=\"e_shiduanliu\">时段六</option>-->\r\n<!--                            <option value=\"7\" class=\"lang\" key=\"e_shiduanqi\">时段七</option>-->\r\n<!--                            <option value=\"8\" class=\"lang\" key=\"e_shiduanba\">时段八</option>-->\r\n\r\n                            <option value=\"1\" class=\"lang\" key=\"t_zhoushiduan1\">班次一</option>\r\n                            <option value=\"2\" class=\"lang\" key=\"t_zhoushiduan2\">班次二</option>\r\n                            <option value=\"3\" class=\"lang\" key=\"t_zhoushiduan3\">班次三</option>\r\n                            <option value=\"4\" class=\"lang\" key=\"t_zhoushiduan4\">班次四</option>\r\n                            <option value=\"5\" class=\"lang\" key=\"t_zhoushiduan5\">班次五</option>\r\n                            <option value=\"6\" class=\"lang\" key=\"t_zhoushiduan6\">班次六</option>\r\n                            <option value=\"7\" class=\"lang\" key=\"t_zhoushiduan7\">班次七</option>\r\n                            <option value=\"8\" class=\"lang\" key=\"t_zhoushiduan8\">班次八</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n                <div class=\"layui-form-item work_table\">\r\n                    <label for=\"L_email\" class=\"layui-form-label lang\" key=\"pass_times\">通行次数</label>\r\n\r\n\r\n                    <div class=\"layui-inline\">\r\n                        <input type=\"radio\" name=\"pass_times\" value=\"0\" lay-filter=\"pass_times\" >\r\n                        <label for=\"L_email\" class=\"layui-form-label lang none-time\"\r\n                               key=\"e_zhidingcishu\" style=\"width: auto;\">指定次数</label>\r\n\r\n                        <input   step=\"1\" min=\"0\" max=\"65535\" placeholder=\"(0-65535)\"\r\n                                 type=\"number\" id=\"pass_times\" name=\"pass_times\"\r\n                                 lay-verify=\"pass_times\" autocomplete=\"off\" class=\"layui-input\" >\r\n                    </div>\r\n\r\n                    <div class=\"layui-inline\">\r\n                        <input type=\"radio\" name=\"pass_times\" value=\"1\" lay-filter=\"pass_times\" checked=\"checked\" >\r\n                        <label style=\"margin-bottom: 37px\" for=\"L_email\" class=\"layui-form-label lang none-time\" key=\"e_buxian\" >不限</label>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n        \t</div>\r\n\r\n\r\n        \t<div class=\"param_box param_left\" id=\"rest-con-box\">\r\n\r\n\r\n\r\n\r\n<!--                <div class=\"layui-form-item\">-->\r\n<!--                    <label for=\"L_email\" class=\"layui-form-label\">-->\r\n<!--                        <span class=\"x-red\"></span><span class=\"lang\" key=\"pic_large\">人脸照片</span>-->\r\n<!--                    </label>-->\r\n<!--                    <div class=\"layui-input-inline\">-->\r\n<!--                        <div class=\"layui-upload-drag\" id=\"test10\">-->\r\n<!--                            <i class=\"layui-icon\">&#xe6b9;</i>-->\r\n<!--                            <p class=\"lang\" key=\"clickSubmit\">点击上传</p>-->\r\n<!--                        </div>-->\r\n<!--                        <input type=\"file\" id=\"pic_large\" name=\"pic_large\" lay-verify=\"pic_large\" autocomplete=\"off\" class=\"layui-input\" onchange=\"reads(this)\" style=\"display: none\">-->\r\n<!--                        <img src=\"\" id=\"displayImg\" style=\"width:100px;height: 100px;display: none\" onclick=\"file_click()\">-->\r\n<!--                    </div>-->\r\n<!--                </div>-->\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"x-red\"></span><span class=\"lang\" key=\"pic_large\">人脸照片</span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div class=\"layui-upload-drag\" id=\"test10\">\r\n                            <i class=\"layui-icon\">&#xe6b9;</i>\r\n                            <p class=\"lang\" key=\"clickSubmit\">点击上传</p>\r\n                        </div>\r\n                        <input type=\"file\" id=\"pic_large\" name=\"pic_large\" lay-verify=\"pic_large\" autocomplete=\"off\" class=\"layui-input\" onchange=\"reads(this)\" style=\"display: none\">\r\n                        <img src=\"\" id=\"displayImg\" style=\"width:100px;height: 100px;display: none\" onclick=\"file_click()\">\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item\">\r\n                    <label class=\"layui-form-label\">\r\n\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div class=\"feature-tip lang\" key=\"d_only\">仅支持.dat格式的二进制文件1</div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"layui-form-item feature-box\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"lang\" key=\"d_renlian\"></span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div style=\"width: 58px; height: 0px\" class=\"layui-upload-drag\" id=\"featureFileUpload\">\r\n                            <p class=\"lang\" style=\"margin-top: -8px\"  key=\"d_dddddd\">点击上传DAT特征值文件</p>\r\n                        </div>\r\n                        <input type=\"file\" id=\"featureFile\" name=\"featureFile\"\r\n                               autocomplete=\"off\" class=\"layui-input\"\r\n                               onchange=\"readFeatureFile(this, 'featureFileName')\" style=\"display: none\">\r\n                        <div id=\"featureFileName\" style=\"margin-top: 10px\"  class=\"feature-filename\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n                <div class=\"layui-form-item feature-box\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"lang\" key=\"d_zhiwen\"></span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div  style=\"width: 58px; height: 0px\"class=\"layui-upload-drag\" id=\"fingerFileUpload\">\r\n                            <p class=\"lang\" style=\"margin-top: -8px\"   key=\"d_dddddd\">点击上传DAT特征值文件1</p>\r\n                        </div>\r\n                        <input type=\"file\" id=\"fingerFile\" name=\"fingerFile\" autocomplete=\"off\"\r\n                               class=\"layui-input\" onchange=\"readFeatureFile(this, 'fingerFileName')\" style=\"display: none\">\r\n                        <div id=\"fingerFileName\" style=\"margin-top: 10px\"  class=\"feature-filename\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- 新增：左掌静脉特征值 -->\r\n                <div class=\"layui-form-item feature-box\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"lang\" key=\"d_zuozhangjingm\"></span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div  style=\"width: 58px; height: 0px\" class=\"layui-upload-drag\" id=\"palm1FileUpload\">\r\n                            <p class=\"lang\" style=\"margin-top: -8px\"   key=\"d_dddddd\">点击上传DAT特征值文件1</p>\r\n                        </div>\r\n                        <input type=\"file\" id=\"palm1File\" name=\"palm1File\"\r\n                               autocomplete=\"off\" class=\"layui-input\" onchange=\"readFeatureFile(this, 'palm1FileName')\" style=\"display: none\">\r\n                        <div id=\"palm1FileName\" style=\"margin-top: 10px\"  class=\"feature-filename\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- 新增：右掌静脉特征值 -->\r\n                <div class=\"layui-form-item feature-box\">\r\n                    <label for=\"L_email\" class=\"layui-form-label\">\r\n                        <span class=\"lang\" key=\"d_youzhangjingm\"></span>\r\n                    </label>\r\n                    <div class=\"layui-input-inline\">\r\n                        <div  style=\"width: 58px; height: 0px\" class=\"layui-upload-drag\" id=\"palm2FileUpload\">\r\n                            <p class=\"lang\"  style=\"margin-top: -8px\"  key=\"d_dddddd\">点击上传DAT特征值文件1</p>\r\n                        </div>\r\n                        <input type=\"file\" id=\"palm2File\" name=\"palm2File\"\r\n                               autocomplete=\"off\" class=\"layui-input\"\r\n                               onchange=\"readFeatureFile(this, 'palm2FileName')\" style=\"display: none\">\r\n                        <div id=\"palm2FileName\" style=\"margin-top: 10px\" class=\"feature-filename\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n\r\n\r\n\r\n               \r\n            </div>\r\n          \t<div class=\"layui-form-item\">\r\n\t              <label for=\"L_repass\" class=\"layui-form-label\">\r\n\t              </label>\r\n\t              <button class=\"layui-btn lang\" key=\"save\" type=\"button\" lay-filter=\"add\" lay-submit=\"\">保存</button>\r\n\t              <button  class=\"layui-btn cancle-btn lang\" key=\"cancle\" onclick=\"cancle()\">取消</button>  \r\n          \t</div>\r\n      </form>\r\n    </div>\r\n</body>\r\n<script src=\"../js/jquery.min.js\"></script>\r\n<script type=\"text/javascript\" src=\"../lib/layui/layui.js\" charset=\"utf-8\"></script>\r\n<script src=\"../js/jquery.cookie.js\"></script>\r\n<script type=\"text/javascript\" src=\"../js/xadmin.js\"></script>\r\n<script src=\"../lang/lang.js\"></script>\r\n<script src=\"../js/notify.js\"></script>\r\n<script src=\"../js/employee_add.js\"></script>\r\n<script>\r\n    function load(){\r\n        lang_load();\r\n        $(\".work_time\").attr(\"placeholder\",window.lang.start_end);\r\n        $(\".pass_time\").attr(\"placeholder\",window.lang.start_end);\r\n    }\r\n\r\n\r\n\r\n\r\n</script>\r\n</html>\r\n"
