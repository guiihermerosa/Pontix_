go\",\n    \"am_start\":\"Início manhã\",\n    \"am_end\":\"Fim manhã\",\n    \"pm_start\":\"Início tarde\",\n    \"pm_end\":\"Fim tarde\",\n    \"over_start\":\"Início hora extra\",\n    \"over_end\":\"Fim hora extra\",\n    \"enable_now\":\"Ativar agora\",\n    \"allow_late\":\"Permitir atraso\",\n    \"sure_enable_work\":\"Ativar o turno atual?\",\n    \"only_5\":\"Máximo 5 turnos\",\n    \"edit_success\":\"Modificado com sucesso\",\n    \"edit_fail\":\"Falha ao modificar\",\n    \"add_success\":\"Adicionado com sucesso\",\n    \"add_fail\":\"Falha ao adicionar\",\n    \"sure_del_now_work\":\"Excluir o turno atual?\",\n    \"time\":\"Hora\",\n    \"export\":\"Exportar\",\n    \"lang\":\"pt\",\n    \"work_note\":\"Registro de presença\",\n    \"work_rule\":\"turnos\",\n    \"add_per_info\":\"Adicionar informações do funcionário\",\n    \"role\":\"Função\",\n    \"ordinary_users\":\"Usuário comum\",\n    \"admin\":\"Administrador\",\n    \"super_admin\":\"Superadministrador\",\n    \"clickSubmit\":\"Clique para carregar\",\n    \"pass_date\":\"Validade de acesso\",\n    \"everyday\":\"Todos os dias\",\n    \"time_solt\":\"Faixa horária\",\n    \"pass_time\":\"Tempo de acesso\",\n    \"allDay\":\"Dia inteiro\",\n    \"ic_pic_no_all_null\":\"A foto é obrigatória\",\n    \"pic_simil\":\"Similaridade da foto muito alta\",\n    \"reg_fails\":\"Falha no registro:\",\n    \"pic_no_1m\":\"A foto não pode exceder 1MB\",\n    \"yyd\":\"Ano/Mês/Dia\",\n    \"hms\":\"Hora:Min:Seg\",\n    \"start_time\":\"Hora de início\",\n    \"end_time\":\"Hora de fim\",\n    \"work_mant\":\"presença\",\n    \"operation\":\"Operação\",\n    \"edit\":\"Editar\",\n    \"delete\":\"Excluir\",\n    \"checkin_time\":\"Hora do ponto\",\n    \"ispass\":\"Passou?\",\n    \"temp\":\"Temperatura\",\n    \"expt_note\":\"Exportar registros\",\n    \"please_ch_start_time\":\"Selecione a hora de início\",\n    \"please_ch_end_time\":\"Selecione a hora de fim\",\n    \"work_note_table\":\"Formulário de reg